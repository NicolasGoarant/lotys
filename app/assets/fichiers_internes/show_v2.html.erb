      <% end %>
    </div>
  <% else %>
    <div style="padding:16px 20px;">
      <p style="font-size:0.82rem;color:#9ca3af;">Aucun document téléchargé.</p>
    </div>
  <% end %>
</div>

<%# Offres reçues %>
<% if @property.published? && @property.offers.any? %>
<div class="ls-card">
  <div class="ls-card-hd" style="display:flex;align-items:center;justify-content:space-between;">
    <p class="ls-section-title" style="margin:0;">🤝 Offres reçues</p>
    <span style="background:#dcfce7;color:#166534;font-size:0.7rem;font-weight:700;padding:3px 10px;border-radius:20px;"><%= @property.offers.count %></span>
  </div>
  <div style="padding:10px 16px 14px;">
    <% @property.offers.order(created_at: :desc).each do |offer| %>
      <div style="border:1px solid #e5e7eb;border-radius:14px;padding:14px;margin-bottom:8px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <span style="font-size:0.72rem;font-weight:700;padding:3px 10px;border-radius:20px;
            <%= offer.offer_type=='renovation' ? 'background:#dbeafe;color:#1e40af;' : offer.offer_type=='financement' ? 'background:#ede9fe;color:#5b21b6;' : 'background:#ffedd5;color:#c2410c;' %>">
            <%= offer.offer_type=='renovation' ? '🔨 Rénovation' : offer.offer_type=='financement' ? '🏦 Financement' : '🏗️ Promoteur' %>
          </span>
          <% if offer.amount %>
            <p style="font-size:1rem;font-weight:900;color:#059669;"><%= number_to_currency(offer.amount, unit: "€", format: "%n %u", precision: 0) %></p>
          <% end %>
        </div>
        <p style="font-size:0.82rem;color:#374151;line-height:1.5;margin-bottom:10px;"><%= offer.description %></p>
        <% if offer.pending? %>
          <div style="display:flex;gap:8px;justify-content:flex-end;">
            <%= button_to "✓ Accepter", offer_path(offer, status: "accepted"), method: :patch,
                style: "font-size:0.78rem;font-weight:700;background:#059669;color:#fff;padding:8px 14px;border-radius:10px;border:none;cursor:pointer;" %>
            <%= button_to "✗ Décliner", offer_path(offer, status: "rejected"), method: :patch,
                style: "font-size:0.78rem;font-weight:600;background:#f3f4f6;color:#6b7280;padding:8px 14px;border-radius:10px;border:none;cursor:pointer;" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<% end %>
<% end %>

</div>

<%# ── JS global ─────────────────────────────────────────── %>
<script>
function calcPret() {
  var M=parseInt(document.getElementById('sim-montant').value);
  var D=parseInt(document.getElementById('sim-duree').value);
  var T=parseFloat(document.getElementById('sim-taux').value);
  document.getElementById('sim-montant-label').textContent=M.toLocaleString('fr-FR')+' €';
  document.getElementById('sim-duree-label').textContent=D+' ans';
  document.getElementById('sim-taux-label').textContent=T.toFixed(1)+' %';
  var n=D*12, fmt=function(x){return Math.round(x).toLocaleString('fr-FR')+' €';};
  if(T===0){
    var m=M/n;
    document.getElementById('sim-mensualite').textContent=fmt(m)+'/mois';
    document.getElementById('sim-cout-total').textContent=fmt(M);
    document.getElementById('sim-interets').textContent='0 €';
  } else {
    var r=(T/100)/12, m=M*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1), tot=m*n;
    document.getElementById('sim-mensualite').textContent=fmt(m)+'/mois';
    document.getElementById('sim-cout-total').textContent=fmt(tot);
    document.getElementById('sim-interets').textContent=fmt(tot-M);
  }
}

var currentProfil=-1;
var mprTaux=[0.70,0.50,0.35,0.15];
var mprLabels=['Bleu – 70% max','Jaune – 50% max','Violet – 35% max','Rose – 15% max'];

function setProfil(p) {
  currentProfil=p;
  document.querySelectorAll('.profil-btn').forEach(function(b,i){
    b.classList.toggle('active', i===p);
  });
  calcAides();
}

function calcAides() {
  var cbs=document.querySelectorAll('.travaux-cb');
  var maxB=0;
  cbs.forEach(function(cb){ if(cb.checked) maxB+=parseInt(cb.dataset.max)||0; });
  var cee=maxB>0?Math.min(Math.round(maxB*0.08),4000):0;
  document.getElementById('aide-cee').textContent=cee>0?cee.toLocaleString('fr-FR')+' €':'—';
  var mpr=0;
  if(currentProfil>=0 && maxB>0){
    mpr=Math.min(Math.round(maxB*mprTaux[currentProfil]),20000);
    document.getElementById('aide-mpr').textContent=mpr.toLocaleString('fr-FR')+' €';
    document.getElementById('aide-mpr-label').textContent=mprLabels[currentProfil];
  } else {
    document.getElementById('aide-mpr').textContent='—';
    document.getElementById('aide-mpr-label').textContent='Sélectionnez votre profil';
  }
  var totalAides=(currentProfil>=0?mpr:0)+cee;
  var reste=Math.max(0,maxB-totalAides);
  document.getElementById('reste-financer').textContent=reste>0?reste.toLocaleString('fr-FR')+' €':maxB>0?'0 €':'—';
  var sl=document.getElementById('sim-montant');
  if(sl && reste>0){sl.value=reste;calcPret();}
}

document.addEventListener('DOMContentLoaded', function(){ calcPret(); calcAides(); });
</script>
