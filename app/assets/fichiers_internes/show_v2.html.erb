<%# ── Documents (propriétaire) ─────────────────────────── %>
<% if is_owner %>
<div class="ls-card">
  <div class="ls-card-hd" style="display:flex;align-items:center;justify-content:space-between;">
    <p class="ls-section-title" style="margin:0;">📎 Documents (<%= @property.documents.count %>)</p>
    <%= link_to "+ Ajouter", new_property_document_path(@property), style: "font-size:0.8rem;font-weight:600;color:#059669;text-decoration:none;" %>
  </div>
  <% if @property.documents.any? %>
    <div style="padding:10px 16px 14px;">
      <% @property.documents.each do |doc| %>
        <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #f3f4f6;">
          <span style="font-size:1rem;">📄</span>
          <div style="flex:1;min-width:0;">
            <p style="font-size:0.82rem;font-weight:600;color:#111827;truncate;"><%= doc.name.presence || doc.document_type.humanize %></p>
            <% if doc.ai_summary.present? %>
              <p style="font-size:0.7rem;color:#6b7280;line-height:1.4;margin-top:2px;"><%= doc.ai_summary.truncate(120) %></p>
            <% end %>
          </div>
          <% if doc.processed? %>
            <span style="font-size:0.65rem;font-weight:700;background:#dcfce7;color:#166534;padding:2px 8px;border-radius:20px;">✓</span>
          <% end %>
          <%= button_to "🗑", property_document_path(@property, doc), method: :delete,
              style: "background:transparent;border:none;cursor:pointer;color:#d1d5db;font-size:0.9rem;padding:4px;",
              data: { confirm: "Supprimer ?", turbo: false } %>
