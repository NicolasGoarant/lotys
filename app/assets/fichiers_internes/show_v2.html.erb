  </div>
</div>
<% end %>

<%# ── Recommandation ──────────────────────────────────────── %>
<% if r %>
<div class="ls-card" style="border-color:#059669;border-width:2px;">
  <div style="background:#047857;padding:16px 20px;">
    <p style="font-size:0.7rem;font-weight:700;color:#6ee7b7;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px;">✅ Notre recommandation</p>
    <p style="font-size:1rem;font-weight:800;color:#fff;line-height:1.5;"><%= r["action_prioritaire"] %></p>
  </div>
  <div class="ls-card-bd">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
      <div style="background:#f0fdf4;border-radius:12px;padding:12px;">
        <p style="font-size:0.65rem;font-weight:700;color:#059669;text-transform:uppercase;margin-bottom:6px;">⏱ Court terme (3 mois)</p>
        <p style="font-size:0.82rem;color:#374151;line-height:1.5;white-space:pre-line;"><%= r["horizon_court"] %></p>
      </div>
      <div style="background:#eff6ff;border-radius:12px;padding:12px;">
        <p style="font-size:0.65rem;font-weight:700;color:#1d4ed8;text-transform:uppercase;margin-bottom:6px;">📅 Moyen terme (1-2 ans)</p>
        <p style="font-size:0.82rem;color:#374151;line-height:1.5;white-space:pre-line;"><%= r["horizon_moyen"] %></p>
