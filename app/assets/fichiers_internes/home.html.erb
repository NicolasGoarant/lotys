<div class="relative min-h-screen overflow-hidden">
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1460317442991-0ec209397118?q=80&w=1800&auto=format&fit=crop"
        alt="Façades d'immeubles en ville"
        class="h-full w-full object-cover"
      >
      <div class="absolute inset-0 bg-black/60"></div>
    </div>

    <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-center px-6 pt-14 md:pt-2 pb-16 md:pb-16 text-center">
      <h1 class="max-w-5xl font-serif text-5xl font-bold leading-tight text-white md:text-7xl">
        <span class="block">Votre plan de rénovation</span>
        <span class="text-emerald-400">thermique, en quelques clics</span>
      </h1>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <%= link_to "Analyser mon bien gratuitement", new_property_path, class: "rounded-2xl bg-emerald-500 px-8 py-4 text-base font-bold text-white shadow-lg shadow-emerald-900/30 transition hover:bg-emerald-400" %>
        <%= link_to "Comment ça marche ?", about_path, class: "rounded-2xl border border-white/20 bg-white/10 px-8 py-4 text-base font-semibold text-white backdrop-blur-sm transition hover:bg-white/15" %>
      </div>

      <%# Les 3 cards ont la même hauteur fixe et le texte y est délibérément
           calibré à une longueur très similaire pour que visuellement les
           trois blocs aient le même poids. Pas de sur-remplissage ni de
           blancs disgracieux entre les cards. %>
      <div class="mt-16 flex w-full flex-col items-center justify-center gap-5 md:flex-row md:items-start md:gap-4">

        <div class="rounded-3xl border border-white/15 bg-black/25 p-8 text-left shadow-2xl backdrop-blur-md transition hover:bg-black/30" style="width:320px; height:320px; flex-shrink:0; overflow:hidden;">
          <div class="mb-4 flex justify-center text-5xl">🤯</div>
          <h3 class="text-center text-2xl font-bold leading-tight text-white">Des aides éparpillées</h3>
          <p class="mt-3 text-lg leading-8 text-white/80">MaPrimeRénov', CEE, éco-PTZ, aides locales… Chaque dispositif a ses règles, ses plafonds, ses pièges.</p>
        </div>

        <div class="flex justify-center py-2 md:hidden">
          <div class="flex flex-col items-center">
            <div class="h-10 w-[2px] bg-emerald-300/70"></div>
            <div class="h-4 w-4 rounded-full bg-emerald-300"></div>
            <div class="h-10 w-[2px] bg-emerald-300/70"></div>
          </div>
        </div>

        <div class="hidden md:flex items-center justify-center" style="margin-top:140px; flex-shrink:0;">
          <div class="h-[2px] bg-emerald-300/70" style="width:40px;"></div>
          <div class="h-4 w-4 rounded-full bg-emerald-300" style="box-shadow:0 0 14px rgba(110,231,183,0.9); flex-shrink:0;"></div>
          <div class="h-[2px] bg-emerald-300/70" style="width:40px;"></div>
        </div>

        <div class="rounded-3xl border border-emerald-400/35 bg-emerald-500/20 p-8 text-left shadow-2xl backdrop-blur-md transition hover:bg-emerald-500/25" style="width:320px; height:320px; flex-shrink:0; overflow:hidden;">
          <div class="mb-4 flex justify-center text-5xl">🔍</div>
          <h3 class="text-center text-2xl font-bold leading-tight text-white">Lotys calcule tout</h3>
          <p class="mt-3 text-lg leading-8 text-white/85">Déposez votre DPE. Lotys identifie vos travaux, chiffre votre budget et calcule vos aides à l'euro près.</p>
        </div>

        <div class="flex justify-center py-2 md:hidden">
          <div class="flex flex-col items-center">
            <div class="h-10 w-[2px] bg-emerald-300/70"></div>
            <div class="h-4 w-4 rounded-full bg-emerald-300"></div>
            <div class="h-10 w-[2px] bg-emerald-300/70"></div>
          </div>
        </div>

        <div class="hidden md:flex items-center justify-center" style="margin-top:140px; flex-shrink:0;">
          <div class="h-[2px] bg-emerald-300/70" style="width:40px;"></div>
          <div class="h-4 w-4 rounded-full bg-emerald-300" style="box-shadow:0 0 14px rgba(110,231,183,0.9); flex-shrink:0;"></div>
          <div class="h-[2px] bg-emerald-300/70" style="width:40px;"></div>
        </div>

        <div class="rounded-3xl border border-white/15 bg-black/25 p-8 text-left shadow-2xl backdrop-blur-md transition hover:bg-black/30" style="width:320px; height:320px; flex-shrink:0; overflow:hidden;">
          <div class="mb-4 flex justify-center text-5xl">🤝</div>
          <h3 class="text-center text-2xl font-bold leading-tight text-white">Les pros viennent à vous</h3>
          <p class="mt-3 text-lg leading-8 text-white/80">Publiez anonymement votre dossier. Artisans RGE et banques partenaires vous font des propositions.</p>
        </div>

      </div>
    </div>
  </section>

  <%# ── Section carte — visible en défilant légèrement sous le hero %>
  <section style="background:#0f172a;padding:60px 24px;">
    <div style="max-width:1000px;margin:0 auto;">

      <%# Accroche %>
      <div style="text-align:center;margin-bottom:36px;">
        <p style="font-size:.75rem;font-weight:800;color:#34d399;text-transform:uppercase;letter-spacing:.12em;margin:0 0 10px;">Ancré dans votre territoire</p>
        <h2 style="font-size:clamp(1.6rem,4vw,2.4rem);font-weight:900;color:#fff;margin:0 0 12px;line-height:1.2;">Aides locales incluses.</h2>
        <p style="font-size:1rem;color:#94a3b8;max-width:560px;margin:0 auto;">Chaque territoire a ses propres dispositifs d'aide. Lotys les intègre — commune par commune, métropole par métropole.</p>
      </div>

      <%# Carte Leaflet avec biens publiés %>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
      <div id="home-map" style="height:480px;border-radius:20px;overflow:hidden;border:2px solid rgba(255,255,255,.15);box-shadow:0 8px 40px rgba(0,0,0,.5);background:#e5e7eb;"></div>

      <%# Légende %>
      <div style="display:flex;gap:24px;justify-content:center;margin-top:20px;flex-wrap:wrap;">
        <% [["A-C","#16a34a","Bien performant"],["D","#ca8a04","Peu performant"],["E-G","#dc2626","Passoire thermique"]].each do |label,color,desc| %>
          <div style="display:flex;align-items:center;gap:8px;">
            <div style="width:14px;height:14px;border-radius:50%;background:<%= color %>;flex-shrink:0;"></div>
            <span style="font-size:.8rem;color:#94a3b8;"><strong style="color:#e2e8f0;"><%= label %></strong> — <%= desc %></span>
          </div>
        <% end %>
      </div>

    </div>
  </section>


  <style>
  @media (max-width: 768px) {
    #home-map {
      height: 300px !important;
      border-radius: 12px !important;
    }
  }
</style>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
  // Init immédiate avec retry si L pas encore dispo
  (function tryMap(attempts){
    var el=document.getElementById('home-map');
    if(!el)return;
    if(typeof L==='undefined'||el._leaflet_id){
      if(attempts>0)setTimeout(function(){tryMap(attempts-1);},200);
      return;
    }
    var map=L.map(el,{zoomControl:true,scrollWheelZoom:false}).setView([48.6921,6.1844],13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
      attribution:'&copy; OpenStreetMap contributors',maxZoom:19
    }).addTo(map);
    <%# Données réelles depuis la base %>
    var biens=<%= (@published_properties || []).map { |p| {
      lat:     p.lat,
      lng:     p.lng,
      dpe:     p.dpe_class&.upcase || "?",
      address: p.address,
      type:    p.property_type&.capitalize || "Bien",
      surface: p.surface,
      img:     p.property_type == "maison" ?
                 "https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=300&q=70" :
                 "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=300&q=70",
      url:     "/properties/#{p.id}"
    }}.to_json.html_safe %>;
    var C={A:'#16a34a',B:'#22c55e',C:'#84cc16',D:'#ca8a04',E:'#f97316',F:'#dc2626',G:'#991b1b'};
    biens.forEach(function(b){
      var col=C[b.dpe]||'#6b7280';
      var icon=L.divIcon({
        html:'<div style="width:32px;height:32px;border-radius:50%;background:'+col+';display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:900;color:#fff;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.4);">'+b.dpe+'</div>',
        className:'',iconSize:[32,32],iconAnchor:[16,16]
      });
      L.marker([b.lat,b.lng],{icon:icon}).addTo(map)
       .bindPopup(
        '<div style="width:200px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;padding:0;">'
        +'<img src="'+b.img+'" style="width:100%;height:90px;object-fit:cover;border-radius:6px 6px 0 0;display:block;">'
        +'<div style="padding:10px 12px;">'
        +'<p style="font-size:.8rem;font-weight:700;color:#6b7280;margin:0 0 4px;">'+b.type+' · '+b.surface+' m²</p>'
        +'<p style="font-size:.88rem;font-weight:800;color:#111;margin:0 0 10px;line-height:1.3;">'+b.address+'</p>'
        +'<a href="'+b.url+'" style="display:block;text-align:center;background:#059669;color:#fff;font-size:.75rem;font-weight:700;padding:6px;border-radius:6px;text-decoration:none;">Voir le dossier →</a>'
        +'</div></div>'
       ,{maxWidth:220,padding:[0,0]});
    });
  })(20);
  </script>


  <%= render "shared/footer", variant: :overlay %>
</div>
