<%# app/views/properties/_simple_financing.html.erb
     Bloc Financement : narration claire de la décomposition du reste à financer.
     Locals attendus :
       - property : la Property
       - aid_result : retour de AidCalculatorService (pour montant Éco-PTZ)
       - reste : reste à financer total (budget - aides)
       - ptz_utilise : portion couvrable par Éco-PTZ (= min(reste, plafond Éco-PTZ))
       - reste_banque : portion à financer par un prêt bancaire classique (= reste - ptz_utilise)

     Approche :
       - Pas de montant "jusqu'à X €" en gros : uniquement le montant réellement
         applicable au bien selon les travaux cochés.
       - Liste des travaux éligibles Éco-PTZ affichée en tags pour que le User
         comprenne concrètement à quoi s'applique ce prêt à 0 %.
       - Simulateur mensualité sur le prêt bancaire uniquement.
-%>

<%# Liste simplifiée des travaux éligibles Éco-PTZ, déduite des checkboxes cochées
     par l'utilisateur (travaux_selection sur Property), pas du JSON Claude entier.
     Ça assure la cohérence avec la card Rénovation énergétique au-dessus. -%>
<% travaux_coches = property.travaux_actifs %>

<% postes_eligibles = travaux_coches.map do |code|
     case code
     when "isolation_toiture"      then "Isolation de la toiture"
     when "isolation_murs"         then "Isolation des murs"
     when "isolation_plancher_bas" then "Isolation des planchers bas"
     when "chauffage"              then "Remplacement du chauffage"
     when "chauffe_eau"            then "Eau chaude sanitaire performante"
     when "vmc"                    then "Ventilation (VMC)"
     when "menuiseries"            then "Isolation des fenêtres"
     end
   end.compact %>

<div class="cd">
  <div class="cd-hd" style="background:#1d4ed8;display:flex;align-items:center;justify-content:space-between;gap:10px;">
    <span>🏦 Financement</span>
    <span id="financement-stale-badge" style="display:none;background:#fbbf24;color:#78350f;font-size:.62rem;font-weight:800;padding:3px 8px;border-radius:10px;text-transform:none;letter-spacing:0;">
      À recalculer
    </span>
  </div>

  <div style="padding:20px;">
    <% if travaux_coches.empty? %>
      <%# Aucun travail coché — rien à financer, rien à célébrer non plus %>
      <div style="padding:16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:12px;text-align:center;">
        <p class="bod" style="color:#6b7280;font-style:italic;">
          Aucun travail sélectionné.
        </p>
        <p class="lbl" style="margin-top:6px;color:#9ca3af;text-transform:none;letter-spacing:0;font-weight:500;">
          Cochez au moins un travail dans la card ci-dessus pour voir votre plan de financement.
        </p>
      </div>

    <% elsif reste <= 0 %>
      <%# Cas heureux : les aides couvrent tout le budget (ou plus) %>
      <div style="padding:16px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;text-align:center;">
        <p style="font-size:1rem;font-weight:700;color:#065f46;">
          🎉 Vos aides couvrent l'intégralité du budget
        </p>
        <p class="lbl" style="margin-top:6px;color:#065f46;text-transform:none;letter-spacing:0;font-weight:500;">
          Aucun financement complémentaire nécessaire.
        </p>
      </div>

    <% else %>
      <%# Reste à financer : montant total à emprunter (on n'affiche plus la décomposition
           Éco-PTZ vs prêt bancaire car l'Éco-PTZ est une OPTION soumise à acceptation
           bancaire, pas une garantie de couverture. Le simulateur porte donc sur le
           reste entier, à un taux bancaire réaliste. L'Éco-PTZ est mentionné en
           accompagnement plus bas comme une piste à explorer avec la banque. -%>
      <div style="padding:14px 16px;background:#eff6ff;border:1px solid #dbeafe;border-radius:12px;margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;">
          <p class="bod" style="font-weight:700;color:#1e3a8a;">💰 Reste à financer</p>
          <%# id pour maj temps réel par recalcTravaux() côté JS %>
          <p style="font-size:1.25rem;font-weight:900;color:#1e3a8a;" id="financement-reste-val">
            <%= number_to_currency(reste, unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
          </p>
        </div>
      </div>

      <%# Simulateur prêt bancaire : porte sur le reste à financer complet. %>
      <p class="lbl" style="margin-bottom:8px;">Simulation d'un prêt bancaire sur
        <span id="financement-reste-sim"><%= number_to_currency(reste, unit: "€", format: "%n %u", precision: 0, delimiter: " ") %></span>
      </p>
      <div style="background:#f9fafb;border-radius:10px;padding:14px 16px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
          <div>
            <p class="lbl" style="margin-bottom:5px;">Durée</p>
            <input type="range" id="sim-d" min="5" max="25" step="1" value="15" style="width:100%;accent-color:#1d4ed8;" oninput="calcPret()">
            <p style="font-size:.78rem;font-weight:700;color:#1d4ed8;text-align:right;margin-top:3px;" id="sim-d-lbl">—</p>
          </div>
          <div>
            <p class="lbl" style="margin-bottom:5px;">Taux</p>
            <input type="range" id="sim-t" min="0" max="6" step="0.1" value="3.5" style="width:100%;accent-color:#1d4ed8;" oninput="calcPret()">
            <p style="font-size:.78rem;font-weight:700;color:#1d4ed8;text-align:right;margin-top:3px;" id="sim-t-lbl">—</p>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
          <div style="background:#eff6ff;border-radius:10px;padding:12px;text-align:center;">
            <p class="lbl" style="margin-bottom:3px;">Mensualité</p>
            <p style="font-size:1rem;font-weight:900;color:#1e3a8a;" id="sim-mens">—</p>
          </div>
          <div style="background:#e0f2fe;border-radius:10px;padding:12px;text-align:center;">
            <p class="lbl" style="margin-bottom:3px;">Total remboursé</p>
            <p style="font-size:1rem;font-weight:900;color:#0369a1;" id="sim-total">—</p>
          </div>
          <div style="background:#dbeafe;border-radius:10px;padding:12px;text-align:center;">
            <p class="lbl" style="margin-bottom:3px;">dont intérêts</p>
            <p style="font-size:1rem;font-weight:900;color:#1d4ed8;" id="sim-cout">—</p>
          </div>
        </div>
      </div>

      <%# Éco-PTZ en annexe : piste à discuter avec la banque, pas une garantie.
           On n'affiche aucun montant — juste la liste des travaux éligibles,
           parce que le vrai plafond dépend d'une double décision (accord banque
           + éligibilité technique artisan RGE) qu'on ne peut pas valider ici. %>
      <% if postes_eligibles.any? %>
        <div style="padding:14px 16px;background:#fef3c7;border:1px solid #fde68a;border-radius:12px;margin-top:16px;">
          <div style="display:flex;align-items:flex-start;gap:10px;">
            <span style="font-size:1.1rem;flex-shrink:0;margin-top:1px;">💡</span>
            <div>
              <p class="bod" style="font-weight:700;color:#92400e;margin-bottom:4px;">
                À demander à votre banque : l'Éco-PTZ
              </p>
              <p class="lbl" style="color:#78350f;text-transform:none;letter-spacing:0;font-weight:500;font-size:.78rem;line-height:1.5;">
                Prêt à taux 0 %, sans condition de ressources, réservé aux travaux de rénovation énergétique.
                Vos travaux cochés peuvent en bénéficier :
              </p>
              <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;">
                <% postes_eligibles.each do |poste| %>
                  <span style="display:inline-flex;align-items:center;gap:3px;background:#fff;color:#92400e;font-size:.72rem;font-weight:600;padding:4px 8px;border-radius:14px;border:1px solid #fde68a;">
                    ✓ <%= poste %>
                  </span>
                <% end %>
              </div>
              <p class="lbl" style="margin-top:8px;color:#78350f;text-transform:none;letter-spacing:0;font-weight:500;font-size:.72rem;line-height:1.5;font-style:italic;">
                L'Éco-PTZ peut remplacer tout ou partie du prêt ci-dessus, sous réserve d'acceptation bancaire et d'artisans RGE.
              </p>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
