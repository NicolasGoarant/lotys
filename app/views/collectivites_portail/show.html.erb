<%# Portail collectivité (feature B2G niveau 1) — /collectivites/:slug. %>
<%# Layout global (navbar + footer), branding EPCI = primary_color en accent. %>
<%# Principe : page Lauze aux couleurs d'un EPCI, pas une marque blanche. %>
<%# SEO / partage social — surcharge le title et og:image du layout via content_for. %>
<% content_for :title do %><%= @collectivite.name %> — Portail rénovation | Lauze<% end %>
<% content_for :og_description do %><%= @collectivite.welcome_text.presence || "Estimez votre projet de rénovation énergétique — MaPrimeRénov', CEE et aides de la collectivité calculées automatiquement." %><% end %>
<% if @collectivite.logo.attached? %>
  <% content_for :og_image do %><%= url_for(@collectivite.logo) %><% end %>
<% end %>

<%# Fraunces : même serif que la home et /collectivites marketing, cohérence visuelle. %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap">

<%
  # Raccourcis locaux — le nom et la couleur sont réutilisés partout ; on les
  # capture pour lisibilité et éviter de refaire tourner le method_missing
  # d'ActiveRecord à chaque interpolation ERB.
  primary = @collectivite.primary_color
  nom     = @collectivite.name

  # Le logo ALEC est un partenaire pressenti, PAS acquis. Il n'apparaît sur
  # la page que dans deux cas cumulatifs :
  #   1) la collectivité est en démonstration (le bandeau démo l'annonce
  #      explicitement — c'est ce qui rend le co-affichage honnête),
  #   2) la collectivité est bien grand-nancy — sinon la mention n'a aucun
  #      sens (la démo banner texte cite d'ailleurs spécifiquement le GN).
  show_alec = @collectivite.demo? && @collectivite.slug == "grand-nancy"
%>

<%# ── Bandeau de démonstration (opt-in via Collectivite#demo). ── %>
<%# Affiché AU-DESSUS du hero : premier signal donné à l'habitant. %>
<%# Ambre pâle : ton neutre, ni alerte ni marketing — juste une clarification. %>
<%# Le petit logo ALEC est parti dans le hero à côté de MGN, où il est plus %>
<%# lisible ; le bandeau garde SEULEMENT le texte (mention ALEC en toutes lettres). %>
<%# Le jour où demo passe à false en console, tout ce bloc disparaît sans redéploiement. %>
<% if @collectivite.demo? %>
  <div id="portail-demo-banner"
       style="background:#fef3c7; border-bottom:1px solid #fcd34d;
              color:#78350f; font-size:0.9rem; line-height:1.55;
              padding:14px 24px;">
    <div style="max-width:960px; margin:0 auto;
                display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
      <span aria-hidden="true"
            style="display:inline-flex; align-items:center; justify-content:center;
                   width:26px; height:26px; border-radius:50%;
                   background:#f59e0b; color:#fff; font-size:0.8rem; font-weight:800;
                   flex-shrink:0;">i</span>
      <p style="margin:0; flex:1; min-width:220px;"><strong>Page de démonstration</strong> — ce portail est un prototype présenté à la Métropole du Grand Nancy et à l'ALEC Nancy Grands Territoires. Il ne constitue pas un service officiel de la collectivité.</p>
    </div>
  </div>
<% end %>

<%# ── HERO — inspiration grandnancy.eu : fond très clair, titre noir avec ── %>
<%# soulignement court en primary_color, décor géométrique filaire dans le %>
<%# coin (SVG inline, dessiné ICI — aucun asset repris du site EPCI). %>
<%# Fond = teinte primary à 3% : perceptible, lié à la charte, marche pour %>
<%# n'importe quelle primary_color d'une autre collectivité. %>
<section id="collectivite-portail"
         data-slug="<%= @collectivite.slug %>"
         style="position:relative;
                background: <%= primary %>08;
                border-bottom: 1px solid <%= primary %>14;
                padding: 64px 24px 108px;
                color: #0f172a;
                overflow: hidden;">

  <%# Décor filaire discret (angle sup. droit) — abstrait, sans référence à %>
  <%# aucun graphique de la Métropole. Réseau de triangles ; couleur primary. %>
  <svg width="380" height="220" viewBox="0 0 380 220" fill="none"
       stroke="currentColor" stroke-width="0.9" stroke-linecap="round"
       aria-hidden="true"
       style="position:absolute; top:-10px; right:-20px;
              color:<%= primary %>; opacity:0.22; pointer-events:none;">
    <path d="M40 0 L200 120 L380 40"/>
    <path d="M40 0 L120 220"/>
    <path d="M200 120 L120 220 L280 220"/>
    <path d="M200 120 L280 220 L380 100"/>
    <path d="M380 40 L280 220"/>
    <path d="M40 0 L200 120"/>
    <circle cx="40"  cy="0"   r="2.6" fill="currentColor" stroke="none"/>
    <circle cx="200" cy="120" r="2.6" fill="currentColor" stroke="none"/>
    <circle cx="380" cy="40"  r="2.6" fill="currentColor" stroke="none"/>
    <circle cx="120" cy="220" r="2.6" fill="currentColor" stroke="none"/>
    <circle cx="280" cy="220" r="2.6" fill="currentColor" stroke="none"/>
  </svg>

  <div style="max-width: 960px; margin: 0 auto; position: relative;">

    <%# Rangée LOGOS + TITRE. Sur mobile, flex-wrap:wrap fait descendre le %>
    <%# bloc titre sous les logos. Les deux logos restent côte à côte tant que %>
    <%# la largeur le permet (même hauteur, cadres identiques). %>
    <div style="display: flex; align-items: center; gap: 24px;
                margin-bottom: 32px; flex-wrap: wrap;">

      <%# Rangée LOGOS interne (deux cadres identiques quand ALEC est visible). %>
      <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">

        <%# Trois branches d'affichage du logo principal, par priorité : %>
        <%# (1) Active Storage attaché — source de vérité future ; %>
        <%# (2) Fallback asset statique de démo pour grand-nancy ; %>
        <%# (3) Fallback initiales générique pour toute autre collectivité. %>
        <% logo_frame = "height: 88px; width: auto; background: #fff; padding: 10px 18px; border-radius: 6px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15,23,42,0.08);" %>
        <% if @collectivite.logo.attached? %>
          <%= image_tag @collectivite.logo,
                id: "collectivite-logo",
                alt: nom,
                style: logo_frame %>
        <% elsif @collectivite.slug == "grand-nancy" %>
          <%= image_tag "logo_mgn.png",
                id: "collectivite-logo-static",
                alt: nom,
                style: logo_frame %>
        <% else %>
          <div id="collectivite-initiales"
               style="height: 88px; min-width: 88px; padding: 0 22px;
                      background: #fff; color: <%= primary %>;
                      border-radius: 6px; border: 1px solid #e2e8f0;
                      box-shadow: 0 4px 12px rgba(15,23,42,0.08);
                      display: flex; align-items: center; justify-content: center;
                      font-family:'Fraunces',Georgia,serif;
                      font-weight: 900; font-size: 1.9rem; letter-spacing: 0.04em;">
            <%= @collectivite.initiales %>
          </div>
        <% end %>

        <%# Logo ALEC — même cadre, MÊME hauteur que MGN. Reste conditionné %>
        <%# à demo? && grand-nancy : disparaît si la démo se termine, ne %>
        <%# s'affiche pas pour une autre collectivité. %>
        <% if show_alec %>
          <%= image_tag "Alec.png",
                id: "alec-logo",
                alt: "ALEC Nancy Grands Territoires",
                style: logo_frame %>
        <% end %>
      </div>

      <div style="flex: 1; min-width: 240px;">
        <p style="margin: 0 0 8px; font-size: 0.78rem; font-weight: 800;
                  letter-spacing: 0.18em; text-transform: uppercase;
                  color: <%= primary %>;">
          Portail rénovation énergétique
        </p>
        <h1 style="margin: 0; font-family:'Fraunces',Georgia,serif;
                   font-size: clamp(2.1rem, 3.8vw, 2.9rem);
                   font-weight: 900; letter-spacing: -0.02em; line-height: 1.1;
                   color: #0f172a;">
          <%= nom %>
        </h1>
        <%# Soulignement court primary_color — motif de titre inspiré de %>
        <%# grandnancy.eu (barre discrète sous les titres). Angulaire (0 radius). %>
        <div id="portail-title-underline"
             style="margin: 16px 0 0; width: 72px; height: 5px;
                    background: <%= primary %>; border-radius: 0;"></div>
      </div>
    </div>

    <% if @collectivite.welcome_text.present? %>
      <p id="welcome-text"
         style="margin: 22px 0 0; font-size: 1.15rem; line-height: 1.7;
                max-width: 62ch; color: #334155;">
        <%= simple_format(@collectivite.welcome_text, {}, wrapper_tag: "span") %>
      </p>
    <% end %>
  </div>
</section>

<%# ── Compteur + CTA — cartes flottantes, angles peu arrondis. ── %>
<%# margin-top négatif conservé : léger chevauchement, cohérent avec le fond %>
<%# clair du hero. Angles arrondis réduits (18 → 8) pour un ton plus anguleux. %>
<section style="max-width: 960px; margin: -64px auto 0; padding: 0 24px;
                position: relative; z-index: 2;">
  <div style="display: grid; gap: 22px;
              grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
              align-items: stretch;">

    <%# Bloc compteur — donnée réelle, jamais inventée. %>
    <div style="background: white; border: 1px solid #e5e7eb; border-radius: 8px;
                padding: 30px 26px; text-align: center;
                box-shadow: 0 18px 40px -12px rgba(15,23,42,0.16), 0 4px 12px rgba(15,23,42,0.05);">
      <p style="margin: 0 0 12px; font-size: 0.78rem; font-weight: 800;
                letter-spacing: 0.18em; text-transform: uppercase; color: #6b7280;">
        Près de chez vous
      </p>
      <p id="count-biens"
         data-count="<%= @count_biens %>"
         style="margin: 0; font-family:'Fraunces',Georgia,serif;
                font-size: 3rem; font-weight: 700; line-height: 1;
                letter-spacing: -0.02em; color: <%= primary %>;">
        <%= @count_biens %>
      </p>
      <p style="margin: 14px 0 0; font-size: 1rem; color: #4b5563; line-height: 1.6;">
        <%= @count_biens == 1 ? "bien déjà analysé" : "biens déjà analysés" %>
        par des habitants
      </p>
    </div>

    <%# Bloc CTA — link vers /properties/new pré-paramétré (rattachement C6). %>
    <div style="background: white; border: 1px solid #e5e7eb; border-radius: 8px;
                padding: 30px 26px; display: flex; flex-direction: column;
                justify-content: space-between; gap: 20px;
                box-shadow: 0 18px 40px -12px rgba(15,23,42,0.16), 0 4px 12px rgba(15,23,42,0.05);">
      <div>
        <p style="margin: 0 0 12px; font-family:'Fraunces',Georgia,serif;
                  font-size: 1.5rem; font-weight: 700; color: #0f172a; line-height: 1.2;
                  letter-spacing:-0.01em;">
          Analysez votre bien
        </p>
        <p style="margin: 0; font-size: 1rem; color: #475569; line-height: 1.65;">
          Estimation des travaux, aides nationales et locales, reste à charge.
          Le résultat prend 1 à 3 minutes.
        </p>
      </div>
      <%= link_to "Commencer →",
            new_property_path(collectivite: @collectivite.slug),
            id: "cta-new-property",
            style: "display: inline-block; background: #{primary};
                    color: white; padding: 15px 24px; border-radius: 6px;
                    font-weight: 800; font-size: 1.05rem; text-decoration: none; text-align: center;
                    box-shadow: 0 8px 18px -6px #{primary}80, 0 2px 6px rgba(0,0,0,0.08);" %>
    </div>
  </div>
</section>

<%# ── Proposition de valeur — orientée HABITANT (audience du portail). ── %>
<%# Trois cartes avec picto SVG monoline (pas d'emoji). Angles réduits (8). %>
<%# Ne PAS remplacer par le contenu décideur de /collectivites marketing — %>
<%# audiences distinctes (élu vs habitant). Nom EPCI interpolé dans 01. %>
<%# Le point 03 reprend les engagements existants (/properties/new + /confidentialite). %>
<section style="max-width: 960px; margin: 0 auto; padding: 88px 24px 48px;">
  <p style="margin: 0 0 28px; font-size: 0.8rem; font-weight: 800;
            letter-spacing: 0.18em; text-transform: uppercase; color: <%= primary %>;">
    Ce que Lauze vous apporte
  </p>

  <div style="display: grid; gap: 22px;
              grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">

    <%# Carte 01 — pictogramme euro dans cercle (aides/calcul). %>
    <article style="background: <%= primary %>0d;
                    border: 1px solid <%= primary %>26;
                    border-radius: 8px; padding: 30px 26px;">
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px;">
        <span aria-hidden="true"
              style="display: inline-flex; align-items: center; justify-content: center;
                     width: 48px; height: 48px; border-radius: 8px;
                     background: <%= primary %>1a; color: <%= primary %>;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M15.5 8.5c-1-1-2.2-1.4-3.5-1.4-2.4 0-4.2 1.8-4.2 4.9s1.8 4.9 4.2 4.9c1.3 0 2.5-.4 3.5-1.4"/>
            <path d="M7.2 11h6M7.2 13h6"/>
          </svg>
        </span>
        <p style="margin: 0; font-family:'Fraunces',Georgia,serif;
                  font-size: 1.05rem; font-weight: 700; color: <%= primary %>;
                  letter-spacing: 0.04em;">01</p>
      </div>
      <h3 style="margin: 0 0 18px; font-family:'Fraunces',Georgia,serif;
                 font-size: 1.5rem; font-weight: 700; color: #0f172a;
                 line-height: 1.2; letter-spacing: -0.01em;">
        Vos aides, calculées
      </h3>
      <p style="margin: 0; font-size: 1.05rem; color: #334155; line-height: 1.75;">Les aides de <%= nom %> s'ajoutent automatiquement à MaPrimeRénov', aux CEE et à l'éco-PTZ. Vous voyez le total et votre reste à charge, à l'euro près.</p>
    </article>

    <%# Carte 02 — pictogramme chemin/étapes (parcours). %>
    <article style="background: <%= primary %>0d;
                    border: 1px solid <%= primary %>26;
                    border-radius: 8px; padding: 30px 26px;">
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px;">
        <span aria-hidden="true"
              style="display: inline-flex; align-items: center; justify-content: center;
                     width: 48px; height: 48px; border-radius: 8px;
                     background: <%= primary %>1a; color: <%= primary %>;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="4.5" cy="12" r="1.6"/>
            <path d="M6.5 12h3"/>
            <circle cx="12" cy="12" r="1.6"/>
            <path d="M14 12h3"/>
            <circle cx="19.5" cy="12" r="1.6" fill="currentColor"/>
            <path d="M17 5l3 3-3 3M17 19l3-3-3-3" stroke-opacity="0"/>
          </svg>
        </span>
        <p style="margin: 0; font-family:'Fraunces',Georgia,serif;
                  font-size: 1.05rem; font-weight: 700; color: <%= primary %>;
                  letter-spacing: 0.04em;">02</p>
      </div>
      <h3 style="margin: 0 0 18px; font-family:'Fraunces',Georgia,serif;
                 font-size: 1.5rem; font-weight: 700; color: #0f172a;
                 line-height: 1.2; letter-spacing: -0.01em;">
        Un parcours simple
      </h3>
      <p style="margin: 0; font-size: 1.05rem; color: #334155; line-height: 1.75;">Déposez votre DPE : travaux prioritaires, aides et reste à charge en quelques minutes. Sans démarchage, sans création de compte obligatoire.</p>
    </article>

    <%# Carte 03 — pictogramme bouclier (protection). %>
    <article style="background: <%= primary %>0d;
                    border: 1px solid <%= primary %>26;
                    border-radius: 8px; padding: 30px 26px;">
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px;">
        <span aria-hidden="true"
              style="display: inline-flex; align-items: center; justify-content: center;
                     width: 48px; height: 48px; border-radius: 8px;
                     background: <%= primary %>1a; color: <%= primary %>;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l8 3v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3z"/>
            <path d="M8.8 12.2l2.2 2.2 4.2-4.2"/>
          </svg>
        </span>
        <p style="margin: 0; font-family:'Fraunces',Georgia,serif;
                  font-size: 1.05rem; font-weight: 700; color: <%= primary %>;
                  letter-spacing: 0.04em;">03</p>
      </div>
      <h3 style="margin: 0 0 18px; font-family:'Fraunces',Georgia,serif;
                 font-size: 1.5rem; font-weight: 700; color: #0f172a;
                 line-height: 1.2; letter-spacing: -0.01em;">
        Vos documents protégés
      </h3>
      <p style="margin: 0; font-size: 1.05rem; color: #334155; line-height: 1.75;">Vos pièces (DPE, titre, factures) sont supprimées après l'analyse. Vos données ne sont jamais transmises sans votre accord.</p>
    </article>
  </div>
</section>

<%# ── Bande de réassurance — engagements déjà tenus ailleurs. ── %>
<%# Reprend le vocabulaire de /properties/new + /confidentialite + le pill %>
<%# "sans appel commercial" de la home. Aucune promesse nouvelle. %>
<section id="portail-reassurance"
         style="margin-top: 48px; background: #f8fafc; border-top: 1px solid #e2e8f0;">
  <div style="max-width: 960px; margin: 0 auto; padding: 30px 24px;
              display: flex; gap: 16px 36px; flex-wrap: wrap;
              align-items: center; justify-content: center;
              font-size: 1rem; color: #334155; line-height: 1.6;">
    <span style="display: inline-flex; align-items: center; gap: 10px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: #059669;">
        <path d="M20 6L9 17l-5-5"/>
      </svg>
      Sans appel commercial
    </span>
    <span style="display: inline-flex; align-items: center; gap: 10px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: #059669;">
        <path d="M20 6L9 17l-5-5"/>
      </svg>
      Documents supprimés après analyse
    </span>
    <span style="display: inline-flex; align-items: center; gap: 10px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: #059669;">
        <path d="M20 6L9 17l-5-5"/>
      </svg>
      Données jamais transmises sans accord
    </span>
  </div>
</section>
