<%# ═══════════════════════════════════════════════════════════════════════
     /collectivites v3
     - Photo : bâtiment institutionnel (mairie/hôtel d'agglo style français)
     - Hero et CTA en cartes arrondies centrées
     - Typo Fraunces + Inter, polices grossies
     ═══════════════════════════════════════════════════════════════════════ %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap">

<style>
  .lotys-page { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
  .lotys-page h1, .lotys-page h2, .lotys-page h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-optical-sizing: auto;
  }
</style>

<div class="lotys-page">

  <%# ── Hero — bâtiment institutionnel ──────────────────────── %>
  <section style="position:relative; padding:0; overflow:hidden;">

    <%# Photo : bâtiment institutionnel, façade pierre claire,
        évoque sans ambiguïté l'institution publique. %>
    <div style="position:absolute; inset:0; z-index:0;">
      <img src="<%= asset_path("personae/collectivites-hero.jpg") %>"
           alt="" style="width:100%; height:100%; object-fit:cover;">
      <div style="position:absolute; inset:0;
                  background:linear-gradient(135deg,rgba(15,23,42,.85) 0%,rgba(30,58,95,.78) 100%);"></div>
    </div>

    <div style="position:relative; z-index:1; padding:104px 32px 88px;">
      <div style="max-width:880px; margin:0 auto; text-align:center; color:#fff;">
        <p style="font-family:'Inter',sans-serif;
                  font-size:.85rem; font-weight:700; color:#6ee7b7;
                  text-transform:uppercase; letter-spacing:.14em;
                  margin:0 0 20px;">
          Pour les intercommunalités
        </p>
        <h1 style="font-size:clamp(2.4rem,5vw,4rem); font-weight:900;
                   line-height:1.1; letter-spacing:-0.02em; margin:0 0 28px;">
          Accélérer la rénovation thermique sur votre territoire
        </h1>
        <p style="font-size:1.2rem; color:#cbd5e1; max-width:680px;
                  margin:0 auto 40px; line-height:1.65; font-weight:400;">
          Lotys équipe votre EPCI d'un outil unique pour vos habitants,
          vos artisans, et pour rendre visibles les dispositifs que
          vous engagez.
        </p>
        <%= link_to "Prendre rendez-vous", contact_path,
            style: "display:inline-block; background:#10b981; color:#fff;
                    font-weight:700; font-size:1.1rem; padding:18px 42px;
                    border-radius:16px; text-decoration:none;
                    box-shadow:0 8px 32px rgba(0,0,0,.3);" %>
      </div>
    </div>
  </section>

  <%# ── Les 3 apports ──────────────────────────────────────────── %>
  <section style="background:#ffffff; padding:96px 24px;">
    <div style="max-width:1100px; margin:0 auto;">

      <div style="display:grid;
                  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
                  gap:48px;">

        <div style="text-align:center;">
          <div style="font-size:3.5rem; margin-bottom:24px;">🏠</div>
          <h2 style="font-size:1.75rem; font-weight:900; color:#0f172a;
                     margin:0 0 18px; letter-spacing:-0.01em; line-height:1.2;">
            Les habitants y voient plus clair
          </h2>
          <p style="font-size:1.1rem; color:#475569; line-height:1.7; margin:0;">
            Un simulateur qui combine les aides nationales et
            <strong>vos dispositifs locaux</strong>, commune par commune.
            Le plan de rénovation, son coût réel, ses étapes — en quelques
            minutes.
          </p>
        </div>

        <div style="text-align:center;">
          <div style="font-size:3.5rem; margin-bottom:24px;">🔧</div>
          <h2 style="font-size:1.75rem; font-weight:900; color:#0f172a;
                     margin:0 0 18px; letter-spacing:-0.01em; line-height:1.2;">
            Les artisans accèdent aux projets
          </h2>
          <p style="font-size:1.1rem; color:#475569; line-height:1.7; margin:0;">
            Les artisans RGE de votre territoire consultent les dossiers
            publiés par les habitants. <strong>Prospection qualifiée et
            locale</strong>, sans démarchage à froid.
          </p>
        </div>

        <div style="text-align:center;">
          <div style="font-size:3.5rem; margin-bottom:24px;">📣</div>
          <h2 style="font-size:1.75rem; font-weight:900; color:#0f172a;
                     margin:0 0 18px; letter-spacing:-0.01em; line-height:1.2;">
            Vos dispositifs sont davantage visibles
          </h2>
          <p style="font-size:1.1rem; color:#475569; line-height:1.7; margin:0;">
            Les aides que votre EPCI engage sont intégrées au simulateur,
            chiffrées dans chaque plan, <strong>connues et activées</strong>
            par les habitants qui y ont droit.
          </p>
        </div>

      </div>
    </div>
  </section>

  <%# ── CTA final en carte arrondie ──────────────────────────── %>
  <section style="position:relative; padding:0; overflow:hidden;">

    <%# Photo : autre bâtiment institutionnel ou place publique %>
    <div style="position:absolute; inset:0; z-index:0;">
      <img src="<%= asset_path("personae/collectivites-cta.jpg") %>"
           alt="" style="width:100%; height:100%; object-fit:cover;">
      <div style="position:absolute; inset:0;
                  background:linear-gradient(135deg,rgba(15,23,42,.92) 0%,rgba(30,58,95,.88) 100%);"></div>
    </div>

    <div style="position:relative; z-index:1; padding:88px 32px;">
      <div style="max-width:760px; margin:0 auto; text-align:center; color:#fff;">

        <h2 style="font-size:clamp(1.7rem,4vw,2.4rem); font-weight:900;
                   margin:0 0 20px; letter-spacing:-0.02em; line-height:1.2;">
          Discutons de votre territoire
        </h2>
        <p style="font-size:1.15rem; color:#cbd5e1; max-width:600px;
                  margin:0 auto 36px; line-height:1.65;">
          Chaque intercommunalité est un cas particulier. La meilleure
          façon de savoir ce que Lotys peut apporter au vôtre, c'est
          d'en parler.
        </p>

        <%= link_to "Prendre rendez-vous", contact_path,
            style: "display:inline-block; background:#10b981; color:#fff;
                    font-weight:700; font-size:1.1rem; padding:18px 42px;
                    border-radius:16px; text-decoration:none;
                    box-shadow:0 8px 32px rgba(0,0,0,.3);
                    margin-right:16px;" %>

        <a href="mailto:contact@lotys.fr"
           style="display:inline-block; color:#6ee7b7; font-weight:600;
                  font-size:1.05rem; padding:18px 0; text-decoration:underline;">
          contact@lotys.fr
        </a>

      </div>
    </div>
  </section>

</div>
