<%# ═══════════════════════════════════════════════════════════════════════
     /artisans v4

     Changements vs v3 :
       - Ajout d'un bloc carte entre la section "3 apports" et le CTA
         final. Utilise le partial factorisé _published_properties_map
         (theme: :light pour s'adapter au fond blanc de la page).
       - Le bloc carte démontre concrètement les promesses faites dans
         les 3 apports ("sur votre territoire", "près de chez vous",
         "filtrez par zone").

     Note : le PagesController#artisans doit charger
     @published_properties pour que la carte affiche des markers.
     C'est déjà le cas depuis le fix initial.
     ═══════════════════════════════════════════════════════════════════════ %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap">

<style>
  .lauze-page { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
  .lauze-page h1, .lauze-page h2, .lauze-page h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-optical-sizing: auto;
  }
</style>

<div class="lauze-page">

  <%# ── Hero — chantier de rénovation avec échafaudage ─────────── %>
  <section style="position:relative; padding:0; overflow:hidden;">

    <%# Photo : façade d'immeuble en cours de rénovation, échafaudage,
        clairement reconnaissable comme un chantier de rénovation. %>
    <div style="position:absolute; inset:0; z-index:0;">
      <img src="<%= asset_path("personae/artisans-hero.jpg") %>"
           alt="" style="width:100%; height:100%; object-fit:cover;">
      <div style="position:absolute; inset:0;
                  background:linear-gradient(135deg,rgba(15,23,42,.85) 0%,rgba(30,58,95,.78) 100%);"></div>
    </div>

    <div style="position:relative; z-index:1; padding:104px 32px 88px;">
      <div style="max-width:880px; margin:0 auto; text-align:center; color:#fff;">
        <p style="font-family:'Inter',sans-serif;
                  font-size:.85rem; font-weight:700; color:#6ee7b7;
                  text-transform:uppercase; letter-spacing:.14em;
                  margin:0 0 20px;">
          Pour les artisans RGE et les banques
        </p>
        <h1 style="font-size:clamp(2.4rem,5vw,4rem); font-weight:900;
                   line-height:1.1; letter-spacing:-0.02em; margin:0 0 28px;">
          Des dossiers qualifiés sur votre territoire
        </h1>
        <p style="font-size:1.2rem; color:#cbd5e1; max-width:680px;
                  margin:0 auto 40px; line-height:1.65; font-weight:400;">
          Chaque dossier publié sur Lauze a été analysé : DPE extrait,
          surface vérifiée, projet de travaux défini, aides calculées.
          Plus de prospection à froid.
        </p>
        <%= link_to "Voir les dossiers disponibles", offers_path,
            data: { turbo: false },
            style: "display:inline-block; background:#10b981; color:#fff;
                    font-weight:700; font-size:1.1rem; padding:18px 42px;
                    border-radius:16px; text-decoration:none;
                    box-shadow:0 8px 32px rgba(0,0,0,.3);" %>
      </div>
    </div>
  </section>

  <%# ── Les 3 apports ──────────────────────────────────────────── %>
  <section style="background:#ffffff; padding:96px 24px;">
    <div style="max-width:1100px; margin:0 auto;">

      <div style="display:grid;
                  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
                  gap:48px;">

        <div style="text-align:center;">
          <div style="font-size:3.5rem; margin-bottom:24px;">📄</div>
          <h2 style="font-size:1.75rem; font-weight:900; color:#0f172a;
                     margin:0 0 18px; letter-spacing:-0.01em; line-height:1.2;">
            Des dossiers déjà instruits
          </h2>
          <p style="font-size:1.1rem; color:#475569; line-height:1.7; margin:0;">
            DPE officiel, surface, travaux envisagés, aides mobilisables,
            reste à charge calculé. <strong>Vous savez à qui vous parlez</strong>
            avant de prendre contact.
          </p>
        </div>

        <div style="text-align:center;">
          <div style="font-size:3.5rem; margin-bottom:24px;">📍</div>
          <h2 style="font-size:1.75rem; font-weight:900; color:#0f172a;
                     margin:0 0 18px; letter-spacing:-0.01em; line-height:1.2;">
            Sur votre territoire
          </h2>
          <p style="font-size:1.1rem; color:#475569; line-height:1.7; margin:0;">
            Filtrez par zone, commune, distance. Pas de chantier à
            l'autre bout du département. <strong>Les bons dossiers, près
            de chez vous.</strong>
          </p>
        </div>

        <div style="text-align:center;">
          <div style="font-size:3.5rem; margin-bottom:24px;">🤝</div>
          <h2 style="font-size:1.75rem; font-weight:900; color:#0f172a;
                     margin:0 0 18px; letter-spacing:-0.01em; line-height:1.2;">
            Sans commission Lauze
          </h2>
          <p style="font-size:1.1rem; color:#475569; line-height:1.7; margin:0;">
            Vous traitez directement avec le propriétaire, sur devis.
            <strong>Lauze ne prend rien</strong> sur les travaux réalisés.
            Notre modèle est celui de la plateforme, pas du commissionnement.
          </p>
        </div>

      </div>
    </div>
  </section>

  <%# ── Carte des dossiers publiés — preuve concrète des 3 apports.
        Fond gris très clair pour rompre avec le blanc précédent
        et créer un appel visuel vers la carte. ──────────────── %>
  <section style="background:#f8fafc; padding:88px 24px;">
    <%= render "pages/published_properties_map",
               properties: @published_properties,
               theme:      :light,
               map_id:     "artisans-map",
               eyebrow:    "Sur votre territoire",
               title:      "Les dossiers actuellement disponibles",
               subtitle:   "Cliquez sur un marqueur pour découvrir le projet et son DPE." %>
  </section>

  <%# ── CTA final en carte arrondie ──────────────────────────── %>
  <section style="position:relative; padding:0; overflow:hidden;">

    <%# Photo : autre chantier, plan plus rapproché %>
    <div style="position:absolute; inset:0; z-index:0;">
      <img src="<%= asset_path("personae/artisans-cta.jpg") %>"
           alt="" style="width:100%; height:100%; object-fit:cover;">
      <div style="position:absolute; inset:0;
                  background:linear-gradient(135deg,rgba(15,23,42,.92) 0%,rgba(30,58,95,.88) 100%);"></div>
    </div>

    <div style="position:relative; z-index:1; padding:88px 32px;">
      <div style="max-width:760px; margin:0 auto; text-align:center; color:#fff;">

        <h2 style="font-size:clamp(1.7rem,4vw,2.4rem); font-weight:900;
                   margin:0 0 20px; letter-spacing:-0.02em; line-height:1.2;">
          Consultez les dossiers maintenant
        </h2>
        <p style="font-size:1.15rem; color:#cbd5e1; max-width:600px;
                  margin:0 auto 36px; line-height:1.65;">
          Accès libre, sans inscription préalable. Vous créez un compte
          uniquement si vous souhaitez envoyer une proposition à un
          propriétaire.
        </p>

        <%= link_to "Parcourir les biens à rénover", offers_path,
            data: { turbo: false },
            style: "display:inline-block; background:#10b981; color:#fff;
                    font-weight:700; font-size:1.1rem; padding:18px 42px;
                    border-radius:16px; text-decoration:none;
                    box-shadow:0 8px 32px rgba(0,0,0,.3);" %>
      </div>
    </div>
  </section>

</div>
