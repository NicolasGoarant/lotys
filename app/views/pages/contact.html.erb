<div class="max-w-3xl mx-auto px-6 py-16">

  <h1 class="text-4xl font-black text-gray-900 mb-4">Contact</h1>
  <p class="text-lg text-gray-600 mb-12">
    Une question, un partenariat, un retour sur l'application ?
    Je vous réponds personnellement.
  </p>

  <%# Carte profil + coordonnées %>
  <div class="bg-white border border-gray-200 rounded-3xl shadow-sm overflow-hidden">

    <div class="grid md:grid-cols-3 gap-0">

      <%# Colonne photo + nom %>
      <div class="bg-emerald-50 p-8 flex flex-col items-center justify-center text-center md:border-r md:border-emerald-100">
        <%= image_tag "NG.png",
            alt: "Nicolas Goarant",
            class: "w-32 h-32 rounded-full object-cover border-4 border-white shadow-md mb-4" %>
        <p class="font-black text-gray-900 text-lg">Nicolas Goarant</p>
        <p class="text-sm text-emerald-700 font-medium">Fondateur de Lauze</p>
      </div>

      <%# Colonne coordonnées %>
      <div class="md:col-span-2 p-8 space-y-6">

        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0">📧</span>
          <div>
            <p class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Email</p>
            <a href="mailto:contact@lauze.eu" class="text-emerald-600 hover:underline font-semibold">
              contact@lauze.eu
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0">📞</span>
          <div>
            <p class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Téléphone</p>
            <a href="tel:+33667063179" class="text-emerald-600 hover:underline font-semibold">
              06 67 06 31 79
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0">📍</span>
          <div>
            <p class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Basé à</p>
            <p class="text-gray-700 font-semibold">Nancy, Grand Est</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0">⚡</span>
          <div>
            <p class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Temps de réponse</p>
            <p class="text-gray-700 font-semibold">Sous 48h en jours ouvrés</p>
          </div>
        </div>

      </div>
    </div>

  </div>

</div>
