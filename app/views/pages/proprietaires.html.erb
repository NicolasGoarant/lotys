<%# ═══════════════════════════════════════════════════════════════════════
     /proprietaires v3
     - Hero et CTA final en grandes cartes arrondies centrées
       (max-width 1280px), pas en bandeaux pleine largeur.
     - Photo : intérieur chaleureux (salon).
     - Typo Fraunces (titres) + Inter (corps), polices grossies.
     ═══════════════════════════════════════════════════════════════════════ %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap">

<div class="lauze-page">

  <%# ── Hero en carte arrondie ────────────────────────────────── %>
  <section style="position:relative; padding:0; overflow:hidden;">

    <%# Photo intérieur chaleureux — salon lumineux %>
    <div style="position:absolute; inset:0; z-index:0;">
      <img src="<%= asset_path("personae/proprietaires-hero.jpg") %>"
           alt="" style="width:100%; height:100%; object-fit:cover; filter:saturate(.7);">
      <%# Voile allégé en gradient horizontal — la photo respire à droite. %>
      <div style="position:absolute; inset:0;
                  background:linear-gradient(90deg,rgba(15,23,42,.92) 0%,rgba(15,23,42,.78) 55%,rgba(15,23,42,.55) 100%);"></div>
    </div>

    <div style="position:relative; z-index:1; padding:104px 32px 88px;">
      <div style="max-width:880px; margin:0 auto; text-align:left; color:#fff;">
        <p style="font-size:.85rem; font-weight:700; color:#6ee7b7;
                  text-transform:uppercase; letter-spacing:.14em;
                  margin:0 0 20px;">
          Pour les propriétaires
        </p>
        <h1 style="font-family:'Fraunces',Georgia,serif;
                   font-size:clamp(2.4rem,5vw,4rem); font-weight:700;
                   line-height:1.1; letter-spacing:-0.02em; margin:0 0 28px;
                   max-width:20ch;">
          Votre rénovation, comprise et chiffrée en quelques minutes
        </h1>
        <p style="font-size:1.2rem; color:#cbd5e1; max-width:60ch;
                  margin:0 0 40px; line-height:1.65; font-weight:400;">
          Téléversez votre DPE. Lauze vous dit quoi faire, combien ça
          coûte vraiment, et qui peut le faire près de chez vous.
        </p>
        <%= link_to "Analyser mon bien gratuitement", new_property_path,
            style: "display:inline-block; background:#fff; color:#065f46;
                    font-weight:700; font-size:1.1rem; padding:18px 42px;
                    border-radius:16px; text-decoration:none;
                    box-shadow:0 8px 32px rgba(0,0,0,.2);" %>
      </div>
    </div>
  </section>

  <%# ── Les 3 apports — colonnes à filet (refonte vitrine) ──────── %>
  <section style="background:#ffffff; padding:96px 24px;">
    <div style="max-width:1100px; margin:0 auto;">
      <div style="margin-bottom:48px; display:flex; align-items:center;
                  justify-content:space-between; gap:24px; flex-wrap:wrap;">
        <div>
          <p style="font-size:.8125rem; font-weight:800; color:#059669;
                    text-transform:uppercase; letter-spacing:.14em; margin:0 0 14px;">
            Ce que Lauze fait pour vous
          </p>
          <h2 style="font-family:'Fraunces',Georgia,serif;
                     font-size:clamp(1.8rem,3.4vw,2.3rem); font-weight:700;
                     color:#0f172a; margin:0; letter-spacing:-0.02em; line-height:1.15;
                     max-width:24ch;">
            Trois étapes claires, du DPE à l'artisan
          </h2>
        </div>
        <%= render "shared/dpe_scale" %>
      </div>

      <%= render "shared/feature_columns",
            items: [
              { numero: "01",
                titre:  "Comprendre ce qu'il faut faire",
                corps:  "Lauze lit votre DPE et vous propose un plan de travaux clair : quels postes, quel ordre, quel saut de classe énergétique atteignable." },
              { numero: "02",
                titre:  "Savoir combien ça coûte vraiment",
                corps:  "MaPrimeRénov', CEE, éco-PTZ, <strong>plus les aides de votre métropole ou intercommunalité</strong>. Lauze calcule tout et vous montre le reste à votre charge." },
              { numero: "03",
                titre:  "Trouver un artisan, sans démarchage",
                corps:  "Publiez votre dossier si vous le souhaitez. Les artisans RGE de votre territoire <strong>vous contactent</strong> avec leurs propositions. Vous choisissez." }
            ] %>
    </div>
  </section>

  <%# ── Bande pédagogique : où part la chaleur ─────────────────
        Enchaîne la narration : on a expliqué ce que Lauze fait, on
        montre maintenant sur quels postes le plan de travaux concentre
        l'effort. L'infographie SVG porte déjà son propre titre interne. %>
  <section style="background:#f8fafc; padding:96px 24px;">
    <div class="max-w-3xl mx-auto">
      <p style="text-align:center; font-size:1.0625rem; color:#475569;
                line-height:1.75; margin:0 0 40px;">
        C'est sur ces postes que Lauze concentre votre plan de travaux.
      </p>
      <%= image_tag "deperditions_thermiques.svg",
            alt: "Répartition des déperditions thermiques d'une maison non isolée (source ADEME)",
            class: "w-full h-auto" %>
    </div>
  </section>

  <%# ── Comment ça marche : 4 étapes du parcours propriétaire ─── %>
  <%= render "shared/comment_ca_marche",
        eyebrow: "Comment ça marche",
        title:   "Quatre étapes, pas dix",
        intro:   "Lauze vous guide du téléversement de votre DPE jusqu'à la mise en relation avec un artisan RGE. Aucune étape n'exige un appel téléphonique ni la saisie manuelle d'un formulaire d'aide.",
        steps: [
          { numero: "01",
            titre:  "Téléversez votre DPE",
            corps:  "Lauze lit votre diagnostic et en extrait classe énergétique, surface, année et système de chauffage. Plus de re-saisie.",
            image:  "screenshots/etape-1.png" },
          { numero: "02",
            titre:  "Découvrez votre plan de travaux",
            corps:  "Un plan d'action priorisé poste par poste : isolation, chauffage, ventilation. <strong>Quel ordre, quel saut de classe</strong>.",
            image:  "screenshots/etape-2.png" },
          { numero: "03",
            titre:  "Voyez vos aides à l'euro près",
            corps:  "MaPrimeRénov', CEE, éco-PTZ <strong>et les aides de votre intercommunalité</strong>, calculés selon votre foyer fiscal.",
            image:  "screenshots/etape-3.png" },
          { numero: "04",
            titre:  "Choisissez un artisan RGE",
            corps:  "Publiez votre dossier si vous le souhaitez. Les artisans RGE de votre territoire vous contactent avec leurs propositions.",
            image:  "screenshots/etape-4.png" }
        ] %>

  <%# ── CTA final en carte arrondie ──────────────────────────── %>
  <section style="position:relative; padding:0; overflow:hidden;">

    <div style="position:absolute; inset:0; z-index:0;">
      <img src="<%= asset_path("personae/proprietaires-cta.jpg") %>"
           alt="" style="width:100%; height:100%; object-fit:cover;">
      <div style="position:absolute; inset:0;
                  background:linear-gradient(135deg,rgba(15,23,42,.92) 0%,rgba(30,58,95,.88) 100%);"></div>
    </div>

    <div style="position:relative; z-index:1; padding:88px 32px;">
      <div style="max-width:760px; margin:0 auto; text-align:center; color:#fff;">

        <h2 style="font-size:clamp(1.7rem,4vw,2.4rem); font-weight:900;
                   margin:0 0 20px; letter-spacing:-0.02em; line-height:1.2;">
          Gratuit, sans engagement, sans inscription préalable
        </h2>
        <p style="font-size:1.15rem; color:#cbd5e1; max-width:600px;
                  margin:0 auto 36px; line-height:1.65;">
          L'analyse DPE et le calcul d'aides sont libres d'accès. Vous créez
          un compte uniquement si vous voulez sauvegarder votre plan ou
          publier votre dossier.
        </p>

        <%= link_to "Analyser mon bien gratuitement", new_property_path,
            style: "display:inline-block; background:#fff; color:#065f46;
                    font-weight:700; font-size:1.1rem; padding:18px 42px;
                    border-radius:16px; text-decoration:none;
                    box-shadow:0 8px 32px rgba(0,0,0,.2);" %>
      </div>
    </div>
  </section>

</div>
