<%# app/views/pages/about.html.erb — refonte visuelle %>

<div class="max-w-5xl mx-auto">

<%# ── Hero ─────────────────────────────────────────────────── %>
<div class="relative rounded-3xl overflow-hidden mb-16" style="height:420px;">
  <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=1400&q=80"
       alt="Logement français" class="w-full h-full object-cover">
  <div class="absolute inset-0" style="background:linear-gradient(120deg,rgba(15,23,42,0.88) 0%,rgba(15,23,42,0.45) 60%,rgba(15,23,42,0.10) 100%);"></div>
  <div class="absolute inset-0 flex flex-col justify-end px-10 pb-10">
    <p class="text-emerald-400 text-sm font-black uppercase tracking-widest mb-3">Comment ça fonctionne</p>
    <h1 class="text-white font-black leading-none mb-4" style="font-size:clamp(2rem,5vw,3.5rem); letter-spacing:-0.03em;">
      L'immobilier,<br>enfin lisible.
    </h1>
    <p class="text-gray-300 text-lg leading-relaxed max-w-xl">
      Le monde du logement est complexe et fragmenté. Lotys rassemble tout ce qu'il faut pour décider sereinement — en quelques minutes.
    </p>
  </div>
</div>

<%# ── Pourquoi Lotys — 3 colonnes ────────────────────────── %>
<div class="mb-16">
  <h2 class="text-3xl font-black text-gray-900 mb-10 text-center" style="letter-spacing:-0.02em;">Pourquoi Lotys ?</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <div class="rounded-2xl p-8 border border-gray-100 bg-white shadow-sm hover:shadow-md transition-shadow">
      <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center text-3xl mb-5">🏚️</div>
      <h3 class="text-lg font-black text-gray-900 mb-3">Un parc qui vieillit</h3>
      <p class="text-base text-gray-500 leading-relaxed">Des millions de logements construits avant 1975 sont énergivores. Leurs propriétaires font face à des choix patrimoniaux importants, souvent sans accompagnement adapté.</p>
    </div>

    <div class="rounded-2xl p-8 border border-gray-100 bg-white shadow-sm hover:shadow-md transition-shadow">
      <div class="w-14 h-14 rounded-2xl bg-orange-50 flex items-center justify-center text-3xl mb-5">🧩</div>
      <h3 class="text-lg font-black text-gray-900 mb-3">Une multitude d'intervenants</h3>
      <p class="text-base text-gray-500 leading-relaxed">Artisans, banques, conseillers Maison de l'Habitat... Chaque acteur apporte sa part — mais personne ne donne une vision d'ensemble.</p>
    </div>

    <div class="rounded-2xl p-8 border border-gray-100 bg-white shadow-sm hover:shadow-md transition-shadow">
      <div class="w-14 h-14 rounded-2xl bg-emerald-50 flex items-center justify-center text-3xl mb-5">💡</div>
      <h3 class="text-lg font-black text-gray-900 mb-3">Des aides méconnues</h3>
      <p class="text-base text-gray-500 leading-relaxed">Éco-PTZ, MaPrimeRénov', CEE... Les dispositifs existent et sont puissants. Ils restent difficiles à articuler sans un accompagnement dédié.</p>
    </div>

  </div>
</div>

<%# ── 4 étapes ──────────────────────────────────────────────── %>
<div class="mb-16">
  <h2 class="text-3xl font-black text-gray-900 mb-10 text-center" style="letter-spacing:-0.02em;">4 étapes pour une décision éclairée</h2>

  <div class="space-y-4">

    <% [
      { n: "1", color_bg: "#334155", color_light: "#f1f5f9", color_border: "#cbd5e1",
        img: "https://images.unsplash.com/photo-1554995207-c18c203602cb?w=500&q=80",
        titre: "Vous décrivez votre bien",
        texte: "Adresse, surface, DPE, copropriété ou non. Vous pouvez aussi télécharger vos documents — DPE, titre de propriété, PV d'AG, devis. L'IA les analyse en quelques secondes et en extrait l'essentiel." },
      { n: "2", color_bg: "#ea580c", color_light: "#fff7ed", color_border: "#fed7aa",
        img: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=500&q=80",
        titre: "Lotys analyse votre situation",
        texte: "Estimation de valeur basée sur les ventes réelles du secteur (données DVF officielles). Calcul automatique de vos droits aux aides nationales. Pour les copropriétés, estimation du potentiel en cas de vente groupée à un promoteur." },
      { n: "3", color_bg: "#059669", color_light: "#f0fdf4", color_border: "#bbf7d0",
        img: "https://images.unsplash.com/photo-1543286386-2e659306cd6c?w=500&q=80",
        titre: "Vous comparez plusieurs scénarios",
        texte: "Rénover : travaux prioritaires, aides mobilisables, reste à charge, valeur après travaux. Vendre : estimation actuelle et conditions optimales. Vendre en bloc : pour les copropriétés avec potentiel de densification urbaine." },
      { n: "4", color_bg: "#1d4ed8", color_light: "#eff6ff", color_border: "#bfdbfe",
        img: "https://images.unsplash.com/photo-1521791136064-7986c2920216?w=500&q=80",
        titre: "Les prestataires viennent à vous",
        texte: "Si vous le souhaitez, publiez votre dossier. Les artisans RGE, courtiers et promoteurs de votre secteur peuvent vous faire une proposition directement sur la plateforme. Vous gardez le contrôle, vous choisissez." },
    ].each do |s| %>

      <div class="bg-white rounded-2xl overflow-hidden border shadow-sm hover:shadow-md transition-shadow flex flex-col md:flex-row" style="border-color:<%= s[:color_border] %>;">

        <%# Barre couleur verticale %>
        <div class="hidden md:block w-1.5 shrink-0" style="background:<%= s[:color_bg] %>;"></div>

        <%# Header coloré avec numéro + titre %>
        <div class="md:hidden px-6 py-4 flex items-center gap-3" style="background:<%= s[:color_light] %>; border-bottom:1px solid <%= s[:color_border] %>;">
          <span class="w-8 h-8 rounded-xl flex items-center justify-center text-white font-black text-base shrink-0" style="background:<%= s[:color_bg] %>;"><%= s[:n] %></span>
          <p class="font-black text-gray-900 text-base"><%= s[:titre] %></p>
        </div>

        <%# Photo %>
        <img src="<%= s[:img] %>" alt="<%= s[:titre] %>"
             class="w-full md:w-56 h-44 md:h-auto object-cover shrink-0">

        <%# Contenu %>
        <div class="p-7 flex items-start gap-5 flex-1">
          <div class="w-10 h-10 rounded-xl hidden md:flex items-center justify-center text-white font-black text-lg shrink-0" style="background:<%= s[:color_bg] %>;"><%= s[:n] %></div>
          <div>
            <h3 class="hidden md:block text-lg font-black text-gray-900 mb-2"><%= s[:titre] %></h3>
            <p class="text-base text-gray-500 leading-relaxed"><%= s[:texte] %></p>
          </div>
        </div>

      </div>

    <% end %>
  </div>
</div>

<%# ── Dispositif local Nancy ──────────────────────────────── %>
<div class="rounded-2xl overflow-hidden mb-10 flex flex-col md:flex-row" style="background:#f0fdf4; border:1px solid #bbf7d0;">
  <div class="p-8 md:p-10 flex-1">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-3xl">📍</span>
      <h2 class="text-2xl font-black text-gray-900" style="letter-spacing:-0.02em;">L'accompagnement local à Nancy</h2>
    </div>
    <p class="text-base text-gray-600 leading-relaxed mb-6">
      Au-delà des aides nationales, Nancy dispose d'un accompagnement local dédié aux propriétaires. Lotys s'appuie sur ces ressources pour affiner ses recommandations.
    </p>
    <div class="bg-white rounded-xl p-5 border border-emerald-100">
      <p class="text-base text-gray-700 leading-relaxed">
        <strong>Éco-PTZ, MaPrimeRénov', CEE, aides de la Métropole du Grand Nancy</strong> — Lotys calcule automatiquement vos droits et vous guide dans les démarches, en tenant compte de votre situation réelle.
      </p>
    </div>
  </div>
</div>

<%# ── Pourquoi Nancy — dark ────────────────────────────────── %>
<div class="rounded-2xl overflow-hidden mb-16 flex flex-col md:flex-row" style="background:#0f172a;">
  <img src="<%= asset_path 'nancy.jpeg' %>"
       alt="Nancy" class="w-full md:w-72 h-52 md:h-auto object-cover shrink-0">
  <div class="p-8 md:p-10">
    <p class="text-emerald-400 text-xs font-black uppercase tracking-widest mb-3">Terrain d'expérimentation</p>
    <h2 class="text-2xl font-black text-white mb-5" style="letter-spacing:-0.02em;">Pourquoi commencer à Nancy ?</h2>
    <p class="text-gray-300 leading-relaxed mb-4 text-base">
      Nancy concentre exactement les enjeux que Lotys adresse : un parc immobilier ancien avec une forte proportion de logements énergivores, des petites copropriétés de centre-ville avec un potentiel de densification, et une métropole engagée dans des transformations urbaines profondes d'ici 2030.
    </p>
    <p class="text-gray-400 leading-relaxed text-base">
      C'est ici que nous testons et affinons la plateforme — avant de l'étendre à d'autres villes françaises.
    </p>
  </div>
</div>

<%# ── CTA final ────────────────────────────────────────────── %>
<div class="text-center py-10 border-t border-gray-100">
  <p class="text-3xl font-black text-gray-900 mb-2" style="letter-spacing:-0.02em;">Prêt à analyser votre bien ?</p>
  <p class="text-gray-400 mb-8 text-base">Gratuit, sans engagement, résultat en quelques minutes.</p>
  <%= link_to "Commencer maintenant →", new_property_path,
      class: "inline-block bg-emerald-600 text-white px-10 py-4 rounded-2xl hover:bg-emerald-700 font-bold text-lg shadow-sm transition" %>
</div>

</div>
