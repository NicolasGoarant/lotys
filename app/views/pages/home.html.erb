<%# ═══════════════════════════════════════════════════════════════════════
     Home v5.1 — textes des cards propriétaire et artisan reformulés.

     Changements vs v5 :
       - Card propriétaire : ajout de "thermique" pour préciser le type
         de rénovation (cohérent avec le H1 et le CTA).
       - Card artisan RGE : nouvelle formulation orientée action
         ("j'identifie", "contacter", "faire une première proposition")
         plutôt que liste de critères.
     ═══════════════════════════════════════════════════════════════════════ %>

<div class="relative">

  <%# ── Image de fond, fixée au viewport ─────────────────────────── %>
  <div style="position:fixed; top:0; left:0; width:100vw; height:100vh;
              z-index:-1; overflow:hidden; pointer-events:none;" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1460317442991-0ec209397118?q=80&w=1800&auto=format&fit=crop"
      alt=""
      style="width:100%; height:100%; object-fit:cover;">
  </div>

  <%# ── Contenu par-dessus l'image ──────────────────────────────── %>
  <div style="position:relative; z-index:1;">

    <%# Hero — overlay noir translucide. Hiérarchie : H1 → CTA → pill. %>
    <section style="background:rgba(0,0,0,0.55); padding:0;">
      <div class="relative flex items-center justify-center overflow-hidden"
           style="min-height:520px;">
        <div class="relative z-10 mx-auto flex w-full max-w-5xl flex-col
                    items-center px-6 py-20 text-center">

          <%# H1 — formulation simple sur 2 lignes. %>
          <h1 class="font-serif font-black text-white leading-none"
              style="font-size:clamp(2.8rem,6vw,4.5rem);
                     letter-spacing:-0.03em; max-width:900px;">
            <span class="block">Votre rénovation thermique,</span>
            <span class="text-emerald-400">en quelques clics</span>
          </h1>

          <%# CTA — avec emoji. %>
          <div class="mt-12">
            <%= link_to new_property_path,
                class: "inline-block rounded-2xl bg-emerald-500 px-12 py-6 font-bold
                        text-white shadow-lg shadow-emerald-900/30 transition
                        hover:bg-emerald-400",
                style: "font-size:1.1rem;" do %>
              <span style="margin-right:10px; font-size:1.25rem;">🧮</span>J'estime mes travaux de rénovation thermique
            <% end %>
          </div>

          <%# ── Garantie anti-funnel commercial — halo intensifié ─── %>
          <div class="lotys-pulse"
               style="display:inline-flex; align-items:center; justify-content:center;
                      gap:14px; margin-top:30px; padding:18px 30px;
                      background:rgba(16,185,129,.18);
                      border:2px solid rgba(110,231,183,.6);
                      border-radius:999px;
                      flex-wrap:wrap;">
            <span style="font-size:1.6rem; line-height:1;">🛡️</span>
            <span style="font-size:1.15rem; color:#fff; font-weight:700;
                         line-height:1.35;">
              Sans appel commercial,<br class="lotys-mobile-only">
              <span class="lotys-desktop-space"> </span>sans capture de coordonnées
            </span>
          </div>
        </div>
      </div>
    </section>

    <%# Hub 3 personae — eyebrow + H2. %>
    <section style="background:rgba(0,0,0,0.55); padding:56px 24px 88px;
                    backdrop-filter:blur(4px);
                    -webkit-backdrop-filter:blur(4px);">
      <div style="max-width:1100px; margin:0 auto;">

        <div style="text-align:center; margin-bottom:48px;">
          <p style="font-size:.75rem; font-weight:800; color:#34d399;
                    text-transform:uppercase; letter-spacing:.12em;
                    margin:0 0 12px;">
            Lotys, pour qui ?
          </p>
          <h2 style="font-size:clamp(1.8rem,4vw,2.6rem); font-weight:900;
                     color:#fff; margin:0; letter-spacing:-0.02em;
                     line-height:1.2;">
            Trois publics, un même outil
          </h2>
        </div>

        <div style="display:grid;
                    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
                    gap:24px;">

          <%# Card 1 — Propriétaire %>
          <%= link_to proprietaires_path,
              style: "display:block; text-decoration:none;
                      background:rgba(255,255,255,.06);
                      border:1px solid rgba(255,255,255,.12);
                      border-radius:20px; padding:36px 32px;
                      backdrop-filter:blur(8px); transition:all .2s ease;",
              onmouseover: "this.style.borderColor='rgba(110,231,183,.5)';
                            this.style.transform='translateY(-4px)';
                            this.style.background='rgba(255,255,255,.09)';",
              onmouseout:  "this.style.borderColor='rgba(255,255,255,.12)';
                            this.style.transform='';
                            this.style.background='rgba(255,255,255,.06)';" do %>
            <div style="font-size:3rem; text-align:center;
                        margin-bottom:20px;">🏠</div>
            <h3 style="font-size:1.5rem; font-weight:900; color:#fff;
                       text-align:center; margin:0 0 14px;
                       letter-spacing:-0.01em;">
              Je suis propriétaire
            </h3>
            <p style="font-size:1.05rem; color:#cbd5e1; line-height:1.65;
                      text-align:center; margin:0 0 20px;">
              Je veux comprendre combien coûte la rénovation thermique de
              mon logement, quelles aides je peux obtenir, et qui peut
              faire les travaux.
            </p>
            <p style="font-size:1rem; font-weight:700; color:#34d399;
                      text-align:center; margin:0;">
              Découvrir le parcours →
            </p>
          <% end %>

          <%# Card 2 — Artisan RGE %>
          <%= link_to artisans_path,
              style: "display:block; text-decoration:none;
                      background:rgba(255,255,255,.06);
                      border:1px solid rgba(255,255,255,.12);
                      border-radius:20px; padding:36px 32px;
                      backdrop-filter:blur(8px); transition:all .2s ease;",
              onmouseover: "this.style.borderColor='rgba(110,231,183,.5)';
                            this.style.transform='translateY(-4px)';
                            this.style.background='rgba(255,255,255,.09)';",
              onmouseout:  "this.style.borderColor='rgba(255,255,255,.12)';
                            this.style.transform='';
                            this.style.background='rgba(255,255,255,.06)';" do %>
            <div style="font-size:3rem; text-align:center;
                        margin-bottom:20px;">🔧</div>
            <h3 style="font-size:1.5rem; font-weight:900; color:#fff;
                       text-align:center; margin:0 0 14px;
                       letter-spacing:-0.01em;">
              Je suis artisan RGE
            </h3>
            <p style="font-size:1.05rem; color:#cbd5e1; line-height:1.65;
                      text-align:center; margin:0 0 20px;">
              J'identifie des projets de rénovation thermique pour
              contacter le propriétaire et lui faire de premières propositions.
            </p>
            <p style="font-size:1rem; font-weight:700; color:#34d399;
                      text-align:center; margin:0;">
              Voir les projets →
            </p>
          <% end %>

          <%# Card 3 — Collectivité %>
          <%= link_to collectivites_path,
              style: "display:block; text-decoration:none;
                      background:rgba(255,255,255,.06);
                      border:1px solid rgba(255,255,255,.12);
                      border-radius:20px; padding:36px 32px;
                      backdrop-filter:blur(8px); transition:all .2s ease;",
              onmouseover: "this.style.borderColor='rgba(110,231,183,.5)';
                            this.style.transform='translateY(-4px)';
                            this.style.background='rgba(255,255,255,.09)';",
              onmouseout:  "this.style.borderColor='rgba(255,255,255,.12)';
                            this.style.transform='';
                            this.style.background='rgba(255,255,255,.06)';" do %>
            <div style="font-size:3rem; text-align:center;
                        margin-bottom:20px;">🏛️</div>
            <h3 style="font-size:1.5rem; font-weight:900; color:#fff;
                       text-align:center; margin:0 0 14px;
                       letter-spacing:-0.01em;">
              Je suis une collectivité
            </h3>
            <p style="font-size:1.05rem; color:#cbd5e1; line-height:1.65;
                      text-align:center; margin:0 0 20px;">
              Je veux offrir à mes habitants un outil qui intègre mes
              dispositifs locaux, et m'aide à mesurer l'effort de rénovation sur
              mon territoire.
            </p>
            <p style="font-size:1rem; font-weight:700; color:#34d399;
                      text-align:center; margin:0;">
              Découvrir l'offre EPCI →
            </p>
          <% end %>

        </div>
      </div>
    </section>

    <%# Carte géographique — eyebrow + H2 + sous-texte d'orientation. %>
    <section style="background:rgba(0,0,0,0.55); padding:72px 24px;
                    backdrop-filter:blur(4px);
                    -webkit-backdrop-filter:blur(4px);">
      <div style="max-width:1000px; margin:0 auto;">

        <div style="text-align:center; margin-bottom:36px;">
          <p style="font-size:.75rem; font-weight:800; color:#34d399;
                    text-transform:uppercase; letter-spacing:.12em;
                    margin:0 0 10px;">
            Sur le terrain
          </p>
          <h2 style="font-size:clamp(1.6rem,4vw,2.4rem); font-weight:900;
                     color:#fff; margin:0 0 14px; line-height:1.2;">
            Les projets publiés sur Lotys
          </h2>
          <p style="font-size:1rem; color:#94a3b8; max-width:560px;
                    margin:0 auto; line-height:1.6;">
            Chaque marqueur est un projet de rénovation publié par son propriétaire.
          </p>
        </div>

        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
        <div id="home-map"
             style="height:480px; border-radius:20px; overflow:hidden;
                    border:2px solid rgba(255,255,255,.15);
                    box-shadow:0 8px 40px rgba(0,0,0,.5);
                    background:#e5e7eb;"></div>

        <div style="display:flex; gap:24px; justify-content:center;
                    margin-top:20px; flex-wrap:wrap;">
          <% [["A-C","#16a34a","Bien performant"],
              ["D","#ca8a04","Peu performant"],
              ["E-G","#dc2626","Passoire thermique"]].each do |label,color,desc| %>
            <div style="display:flex; align-items:center; gap:8px;">
              <div style="width:14px; height:14px; border-radius:50%;
                          background:<%= color %>; flex-shrink:0;"></div>
              <span style="font-size:.8rem; color:#94a3b8;">
                <strong style="color:#e2e8f0;"><%= label %></strong> — <%= desc %>
              </span>
            </div>
          <% end %>
        </div>

      </div>
    </section>

  </div>

  <style>
    @keyframes lotys-pulse {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.55),
                    0 0 0 0 rgba(52, 211, 153, 0.0);
      }
      50% {
        box-shadow: 0 0 0 14px rgba(52, 211, 153, 0.0),
                    0 0 50px 8px rgba(52, 211, 153, 0.42);
      }
    }
    .lotys-pulse {
      animation: lotys-pulse 3s ease-in-out infinite;
    }
    .lotys-pulse:hover {
      animation-play-state: paused;
    }
    @media (prefers-reduced-motion: reduce) {
      .lotys-pulse { animation: none; }
    }

    .lotys-mobile-only { display: none; }
    .lotys-desktop-space { display: inline; }
    @media (max-width: 768px) {
      .lotys-mobile-only  { display: inline; }
      .lotys-desktop-space { display: none; }
      #home-map { height: 300px !important; border-radius: 12px !important; }
    }
  </style>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
  (function tryMap(attempts){
    var el = document.getElementById('home-map');
    if(!el) return;
    if(typeof L === 'undefined' || el._leaflet_id){
      if(attempts > 0) setTimeout(function(){ tryMap(attempts-1); }, 200);
      return;
    }
    var map = L.map(el, {zoomControl:true, scrollWheelZoom:true}).setView([48.6921,6.1844], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors', maxZoom: 19
    }).addTo(map);
    var biens = <%= (@published_properties || []).map { |p| {
      lat:     p.lat,
      lng:     p.lng,
      dpe:     p.dpe_class&.upcase || "?",
      address: p.address,
      type:    p.property_type&.capitalize || "Bien",
      surface: p.surface,
      img:     p.property_type == "maison" ?
                 "https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=300&q=70" :
                 "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=300&q=70",
      url:     "/properties/#{p.id}"
    }}.to_json.html_safe %>;
    var C = {A:'#16a34a', B:'#22c55e', C:'#84cc16', D:'#ca8a04',
             E:'#f97316', F:'#dc2626', G:'#991b1b'};
    biens.forEach(function(b){
      var col = C[b.dpe] || '#6b7280';
      var icon = L.divIcon({
        html:'<div style="width:32px;height:32px;border-radius:50%;background:'+col+';display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:900;color:#fff;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.4);">'+b.dpe+'</div>',
        className:'', iconSize:[32,32], iconAnchor:[16,16]
      });
      L.marker([b.lat,b.lng], {icon:icon}).addTo(map)
       .bindPopup(
        '<div style="width:200px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;padding:0;">'
        +'<img src="'+b.img+'" style="width:100%;height:90px;object-fit:cover;border-radius:6px 6px 0 0;display:block;">'
        +'<div style="padding:10px 12px;">'
        +'<p style="font-size:.8rem;font-weight:700;color:#6b7280;margin:0 0 4px;">'+b.type+' · '+b.surface+' m²</p>'
        +'<p style="font-size:.88rem;font-weight:800;color:#111;margin:0 0 10px;line-height:1.3;">'+b.address+'</p>'
        +'<a href="'+b.url+'" style="display:block;text-align:center;background:#059669;color:#fff;font-size:.75rem;font-weight:700;padding:6px;border-radius:6px;text-decoration:none;">Voir le dossier →</a>'
        +'</div></div>'
       , {maxWidth:220, padding:[0,0]});
    });
  })(20);
  </script>

</div>
