<%# ═══════════════════════════════════════════════════════════════════════
     Home v6 — utilise le partial _published_properties_map.

     Changements vs v5.2 :
       - Bloc carte (titre + Leaflet + script) factorisé dans
         pages/_published_properties_map.html.erb. Le partial est
         appelé avec theme: :dark pour conserver le rendu sur fond
         sombre. Aucun changement visuel attendu.
       - L'eyebrow du bloc carte est passé en argument explicite
         (ne change rien au rendu).
     ═══════════════════════════════════════════════════════════════════════ %>

<div class="relative">

  <%# ── Image de fond, fixée au viewport ─────────────────────────── %>
  <div style="position:fixed; top:0; left:0; width:100vw; height:100vh;
              z-index:-1; overflow:hidden; pointer-events:none;" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1460317442991-0ec209397118?q=80&w=1800&auto=format&fit=crop"
      alt=""
      style="width:100%; height:100%; object-fit:cover;">
  </div>

  <%# ── Contenu par-dessus l'image ──────────────────────────────── %>
  <div style="position:relative; z-index:1;">

    <%# Hero — overlay noir translucide. Hiérarchie : H1 → CTA → pill. %>
    <section style="background:rgba(0,0,0,0.55); padding:0;">
      <div class="relative flex items-center justify-center overflow-hidden"
           style="min-height:520px;">
        <div class="relative z-10 mx-auto flex w-full max-w-5xl flex-col
                    items-center px-6 py-20 text-center">

          <%# H1 — formulation simple sur 2 lignes. %>
          <h1 class="font-black text-white leading-none"
              style="font-size:clamp(2.8rem,6vw,4.5rem);
                     letter-spacing:-0.03em; max-width:900px;">
            <span class="block">Votre rénovation thermique,</span>
            <span class="text-emerald-400">en quelques clics</span>
          </h1>

          <%# CTA — avec emoji. %>
          <div class="mt-12">
            <%= link_to new_property_path,
                class: "inline-block rounded-2xl bg-emerald-500 px-12 py-6 font-bold
                        text-white shadow-lg shadow-emerald-900/30 transition
                        hover:bg-emerald-400",
                style: "font-size:1.1rem;" do %>
              <span style="margin-right:10px; font-size:1.25rem;">🧮</span>J'estime mes travaux de rénovation thermique
            <% end %>
          </div>

          <%# ── Garantie anti-funnel commercial — halo intensifié ─── %>
          <div class="lauze-pulse"
               style="display:inline-flex; align-items:center; justify-content:center;
                      gap:14px; margin-top:30px; padding:18px 30px;
                      background:rgba(16,185,129,.18);
                      border:2px solid rgba(110,231,183,.6);
                      border-radius:999px;
                      flex-wrap:wrap;">
            <span style="font-size:1.6rem; line-height:1;">🛡️</span>
            <span style="font-size:1.15rem; color:#fff; font-weight:700;
                         line-height:1.35;">
              Sans appel commercial,<br class="lauze-mobile-only">
              <span class="lauze-desktop-space"> </span>sans capture de coordonnées
            </span>
          </div>
        </div>
      </div>
    </section>

    <%# Hub 3 personae — eyebrow + H2. %>
    <section style="background:rgba(0,0,0,0.55); padding:56px 24px 88px;
                    backdrop-filter:blur(4px);
                    -webkit-backdrop-filter:blur(4px);">
      <div style="max-width:1100px; margin:0 auto;">

        <div style="text-align:center; margin-bottom:48px;">
          <p style="font-size:.75rem; font-weight:800; color:#34d399;
                    text-transform:uppercase; letter-spacing:.12em;
                    margin:0 0 12px;">
            Lauze, pour qui ?
          </p>
          <h2 style="font-size:clamp(1.8rem,4vw,2.6rem); font-weight:900;
                     color:#fff; margin:0; letter-spacing:-0.02em;
                     line-height:1.2;">
            Trois publics,<br class="lauze-mobile-only">
            <span class="lauze-desktop-space"> </span>un même outil
          </h2>
        </div>

        <div style="display:grid;
                    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
                    gap:24px;">

          <%# Card 1 — Propriétaire %>
          <%= link_to proprietaires_path,
              style: "display:block; text-decoration:none;
                      background:rgba(255,255,255,.06);
                      border:1px solid rgba(255,255,255,.12);
                      border-radius:20px; padding:36px 32px;
                      backdrop-filter:blur(8px); transition:all .2s ease;",
              onmouseover: "this.style.borderColor='rgba(110,231,183,.5)';
                            this.style.transform='translateY(-4px)';
                            this.style.background='rgba(255,255,255,.09)';",
              onmouseout:  "this.style.borderColor='rgba(255,255,255,.12)';
                            this.style.transform='';
                            this.style.background='rgba(255,255,255,.06)';" do %>
            <div style="font-size:3rem; text-align:center;
                        margin-bottom:20px;">🏠</div>
            <h3 style="font-size:1.5rem; font-weight:900; color:#fff;
                       text-align:center; margin:0 0 14px;
                       letter-spacing:-0.01em;">
              Je suis propriétaire
            </h3>
            <p style="font-size:1.05rem; color:#cbd5e1; line-height:1.65;
                      text-align:center; margin:0 0 20px;">
              Je veux comprendre combien coûte la rénovation thermique de
              mon logement, quelles aides je peux obtenir, et qui peut
              faire les travaux.
            </p>
            <p style="font-size:1rem; font-weight:700; color:#34d399;
                      text-align:center; margin:0;">
              Découvrir le parcours →
            </p>
          <% end %>

          <%# Card 2 — Artisan RGE %>
          <%= link_to artisans_path,
              style: "display:block; text-decoration:none;
                      background:rgba(255,255,255,.06);
                      border:1px solid rgba(255,255,255,.12);
                      border-radius:20px; padding:36px 32px;
                      backdrop-filter:blur(8px); transition:all .2s ease;",
              onmouseover: "this.style.borderColor='rgba(110,231,183,.5)';
                            this.style.transform='translateY(-4px)';
                            this.style.background='rgba(255,255,255,.09)';",
              onmouseout:  "this.style.borderColor='rgba(255,255,255,.12)';
                            this.style.transform='';
                            this.style.background='rgba(255,255,255,.06)';" do %>
            <div style="font-size:3rem; text-align:center;
                        margin-bottom:20px;">🔧</div>
            <h3 style="font-size:1.5rem; font-weight:900; color:#fff;
                       text-align:center; margin:0 0 14px;
                       letter-spacing:-0.01em;">
              Je suis artisan RGE
            </h3>
            <p style="font-size:1.05rem; color:#cbd5e1; line-height:1.65;
                      text-align:center; margin:0 0 20px;">
              J'identifie des projets de rénovation thermique pour
              contacter le propriétaire et faire une première proposition.
            </p>
            <p style="font-size:1rem; font-weight:700; color:#34d399;
                      text-align:center; margin:0;">
              Voir les projets →
            </p>
          <% end %>

          <%# Card 3 — Collectivité %>
          <%= link_to collectivites_path,
              style: "display:block; text-decoration:none;
                      background:rgba(255,255,255,.06);
                      border:1px solid rgba(255,255,255,.12);
                      border-radius:20px; padding:36px 32px;
                      backdrop-filter:blur(8px); transition:all .2s ease;",
              onmouseover: "this.style.borderColor='rgba(110,231,183,.5)';
                            this.style.transform='translateY(-4px)';
                            this.style.background='rgba(255,255,255,.09)';",
              onmouseout:  "this.style.borderColor='rgba(255,255,255,.12)';
                            this.style.transform='';
                            this.style.background='rgba(255,255,255,.06)';" do %>
            <div style="font-size:3rem; text-align:center;
                        margin-bottom:20px;">🏛️</div>
            <h3 style="font-size:1.5rem; font-weight:900; color:#fff;
                       text-align:center; margin:0 0 14px;
                       letter-spacing:-0.01em;">
              Je suis une collectivité
            </h3>
            <p style="font-size:1.05rem; color:#cbd5e1; line-height:1.65;
                      text-align:center; margin:0 0 20px;">
              Je veux offrir à mes habitants un outil qui intègre mes
              dispositifs locaux, et mesurer l'effort de rénovation sur
              mon territoire.
            </p>
            <p style="font-size:1rem; font-weight:700; color:#34d399;
                      text-align:center; margin:0;">
              Découvrir l'offre EPCI →
            </p>
          <% end %>

        </div>
      </div>
    </section>

    <%# Carte géographique — appel du partial factorisé.
        Theme dark, map_id "home-map" pour rester cohérent avec
        l'historique de cette page. %>
    <section style="background:rgba(0,0,0,0.55); padding:72px 24px;
                    backdrop-filter:blur(4px);
                    -webkit-backdrop-filter:blur(4px);">
      <%= render "pages/published_properties_map",
                 properties: @published_properties,
                 theme:      :dark,
                 map_id:     "home-map" %>
    </section>

  </div>

  <style>
    @keyframes lauze-pulse {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.55),
                    0 0 0 0 rgba(52, 211, 153, 0.0);
      }
      50% {
        box-shadow: 0 0 0 14px rgba(52, 211, 153, 0.0),
                    0 0 50px 8px rgba(52, 211, 153, 0.42);
      }
    }
    .lauze-pulse {
      animation: lauze-pulse 3s ease-in-out infinite;
    }
    .lauze-pulse:hover {
      animation-play-state: paused;
    }
    @media (prefers-reduced-motion: reduce) {
      .lauze-pulse { animation: none; }
    }

    .lauze-mobile-only { display: none; }
    .lauze-desktop-space { display: inline; }
    @media (max-width: 768px) {
      .lauze-mobile-only  { display: inline; }
      .lauze-desktop-space { display: none; }
    }
  </style>

</div>
