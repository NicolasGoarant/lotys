<% variant ||= :default %>

<% if variant.to_sym == :overlay %>
  <footer class="absolute bottom-0 left-0 right-0 z-20 border-t border-white/10 bg-black/20 backdrop-blur-sm">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-4 text-sm text-white/80 md:flex-row md:items-center md:justify-between">
      <div>
        <span class="font-semibold text-white">Lotys</span>
        <span class="ml-2">L’immobilier, enfin lisible.</span>
      </div>

      <div class="flex flex-wrap gap-4">
        <%= link_to "Comment ça marche", "#", class: "transition hover:text-white" %>
        <%= link_to "Mentions légales", "#", class: "transition hover:text-white" %>
        <%= link_to "Confidentialité", "#", class: "transition hover:text-white" %>
        <%= link_to "Contact", "#", class: "transition hover:text-white" %>
      </div>
    </div>
  </footer>
<% else %>
  <footer class="border-t border-gray-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-8 text-sm text-gray-600 md:flex-row md:items-center md:justify-between">
      <div>
        <span class="font-semibold text-gray-900">Lotys</span>
        <span class="ml-2">L’immobilier, enfin lisible.</span>
      </div>

      <div class="flex flex-wrap gap-4">
        <%= link_to "Comment ça marche", "#", class: "transition hover:text-gray-900" %>
        <%= link_to "Mentions légales", "#", class: "transition hover:text-gray-900" %>
        <%= link_to "Confidentialité", "#", class: "transition hover:text-gray-900" %>
        <%= link_to "Contact", "#", class: "transition hover:text-gray-900" %>
      </div>
    </div>
  </footer>
<% end %>
