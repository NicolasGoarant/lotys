<% variant ||= :default %>

<% if variant.to_sym == :overlay %>
  <%# Footer transparent pour la home (sur fond image) %>
  <footer class="relative z-10 border-t border-white/10 bg-black/50 backdrop-blur-md text-white/85">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-5 text-sm md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-2">
        <%= image_tag "lauze_logo.png", height: 24, alt: "Lauze", class: "h-6 w-auto" %>
        <span class="font-bold text-white">Lauze</span>
        <span class="text-white/50">© <%= Date.current.year %></span>
      </div>
      <div class="flex flex-wrap gap-5">
        <%= link_to "Comment ça marche", about_path, class: "hover:text-white transition" %>
        <%= link_to "Contact", contact_path, class: "hover:text-white transition" %>
        <%= link_to "Mentions légales", mentions_legales_path, class: "hover:text-white transition" %>
        <%= link_to "Confidentialité", confidentialite_path, class: "hover:text-white transition" %>
      </div>
    </div>
  </footer>
<% else %>
  <%# Footer blanc, par défaut %>
  <footer class="border-t border-gray-200 bg-white text-gray-600">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-5 text-sm md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-2">
        <%= image_tag "lauze_logo.png", height: 24, alt: "Lauze", class: "h-6 w-auto" %>
        <span class="font-bold text-emerald-600">Lauze</span>
        <span class="text-gray-400">© <%= Date.current.year %></span>
      </div>
      <div class="flex flex-wrap gap-5">
        <%= link_to "Comment ça marche", about_path, class: "hover:text-emerald-600 transition" %>
        <%= link_to "Contact", contact_path, class: "hover:text-emerald-600 transition" %>
        <%= link_to "Mentions légales", mentions_legales_path, class: "hover:text-emerald-600 transition" %>
        <%= link_to "Confidentialité", confidentialite_path, class: "hover:text-emerald-600 transition" %>
      </div>
    </div>
  </footer>
<% end %>
