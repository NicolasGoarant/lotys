<%# Corps interne d'une colonne — factorisé pour partager le markup
    entre la variante <a> (item avec link) et la variante <div>.
    Échelle typo généreuse : 01/02 en 22px serif (poids éditorial),
    h3 en 26px serif, corps en 17px line-height 1.75. %>
<p style="font-family:'Fraunces',Georgia,serif;
          font-size:1.375rem; font-weight:700; color:<%= numero_color %>;
          font-feature-settings:'tnum'; letter-spacing:.02em;
          line-height:1; margin:0 0 18px;
          display:flex; align-items:center; gap:12px;">
  <span><%= item[:numero] %></span>
  <% if item[:emoji].present? %>
    <span aria-hidden="true"
          style="font-size:1.5rem; line-height:1;">
      <%= item[:emoji] %>
    </span>
  <% end %>
</p>
<% if item[:icone_svg].present? %>
  <div style="margin-bottom:16px; color:<%= numero_color %>;">
    <%= item[:icone_svg].html_safe %>
  </div>
<% end %>
<h3 style="font-family:'Fraunces',Georgia,serif;
           font-size:1.625rem; font-weight:700; color:<%= title_color %>;
           line-height:1.2; letter-spacing:-0.01em; margin:0 0 16px;">
  <%= item[:titre] %>
</h3>
<p style="font-size:1.0625rem; color:<%= body_color %>; line-height:1.75;
          margin:0; max-width:60ch;">
  <%= item[:corps].html_safe %>
</p>
<% if item[:link].present? && item[:link_label].present? %>
  <p style="font-size:1rem; font-weight:700; color:<%= link_color %>;
            margin:22px 0 0;">
    <%= item[:link_label] %>
  </p>
<% end %>
