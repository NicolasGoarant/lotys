<div class="max-w-2xl mx-auto">

  <%# Récapitulatif enrichi du dossier %>
  <% dpe = @property.dpe_class&.upcase %>
  <% dpe_colors = { "A"=>"#16a34a","B"=>"#22c55e","C"=>"#84cc16","D"=>"#eab308","E"=>"#f97316","F"=>"#ea580c","G"=>"#dc2626" } %>
  <% dpe_labels = { "A"=>"Très performant","B"=>"Performant","C"=>"Assez performant","D"=>"Peu performant","E"=>"Énergivore","F"=>"Très énergivore","G"=>"Passoire thermique" } %>
  <% dpe_cible = { "G"=>"C ou mieux","F"=>"C","E"=>"D" } %>

  <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden mb-6 shadow-sm">
    <%# Photos d'illustration %>
    <% photos = { "appartement" => "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=800&q=80", "maison" => "https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=800&q=80" } %>
    <div class="h-40 bg-gray-100 overflow-hidden relative">
      <img src="<%= photos[@property.property_type] || photos['appartement'] %>" class="w-full h-full object-cover">
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end px-5 pb-4">
        <div>
          <p class="text-white font-bold text-lg leading-tight">
            <% type_label = @property.property_type == "maison" ? "Maison" : "Appartement"
               rooms_label = @property.nb_rooms.present? ? " T#{@property.nb_rooms}" : ""
               surface_label = @property.surface.present? ? " de #{@property.surface} m²" : ""
               copro_label = @property.is_copropriete ? " · Copropriété #{@property.nb_lots} lots" : ""
               city_label = @property.city.present? ? " · #{@property.city}" : "" %>
            <%= "#{type_label}#{rooms_label}#{surface_label}#{copro_label}#{city_label}" %>
            <% if @property.surface %> · <%= @property.surface %> m²<% end %>
          </p>
          <p class="text-white/75 text-sm"><%= @property.city %><% if @property.is_copropriete %> · Copropriété <%= @property.nb_lots %> lots<% end %></p>
        </div>
      </div>
    </div>

    <div class="p-5">
      <%# DPE + scénario %>
      <div class="flex flex-wrap gap-2 mb-4">
        <% if dpe %>
          <span class="inline-flex items-center gap-1.5 text-sm font-bold px-3 py-1 rounded-full text-white" style="background:<%= dpe_colors[dpe] || '#6b7280' %>">
            DPE <%= dpe %> — <%= dpe_labels[dpe] %>
          </span>
          <% if dpe_cible[dpe] %>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold px-3 py-1 rounded-full bg-blue-100 text-blue-800">
              🔨 Objectif : DPE <%= dpe_cible[dpe] %>
            </span>
          <% end %>
        <% end %>
        <% if @property.is_copropriete && @property.valuation&.bulk_sale_estimate %>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold px-3 py-1 rounded-full bg-orange-100 text-orange-800">🏗️ Vente en bloc envisagée</span>
        <% end %>
      </div>

      <%# Métriques clés %>
      <div class="grid grid-cols-3 gap-3 mb-4">
        <% if @property.surface %>
          <div class="bg-gray-50 rounded-xl p-3 text-center">
            <p class="text-xs text-gray-500 mb-0.5">Surface</p>
            <p class="font-bold text-gray-800"><%= @property.surface %> m²</p>
          </div>
        <% end %>
        <% if @property.nb_rooms %>
          <div class="bg-gray-50 rounded-xl p-3 text-center">
            <p class="text-xs text-gray-500 mb-0.5">Pièces</p>
            <p class="font-bold text-gray-800"><%= @property.nb_rooms %></p>
          </div>
        <% end %>
        <% if @property.construction_year %>
          <div class="bg-gray-50 rounded-xl p-3 text-center">
            <p class="text-xs text-gray-500 mb-0.5">Construit en</p>
            <p class="font-bold text-gray-800"><%= @property.construction_year %></p>
          </div>
        <% end %>
      </div>

      <%# Description propriétaire %>
      <% if @property.description.present? %>
        <div class="bg-gray-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Ce que dit le propriétaire</p>
          <p class="text-sm text-gray-700 leading-relaxed italic">"<%= @property.description.truncate(200) %>"</p>
        </div>
      <% end %>
    </div>
  </div>

  <%= form_with model: [@property, @offer], class: "space-y-5" do |f| %>

    <% if @offer.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-2xl p-4 text-sm text-red-700">
        <% @offer.errors.full_messages.each do |msg| %><p>⚠️ <%= msg %></p><% end %>
      </div>
    <% end %>

    <%# Type d'offre %>
    <div class="bg-white border border-gray-100 rounded-2xl p-6">
      <p class="text-sm font-bold text-gray-700 mb-4">Quel type de proposition faites-vous ?</p>
      <div class="grid grid-cols-1 gap-3" id="type-choice">

        <label class="offer-type-label cursor-pointer border-2 border-gray-200 rounded-xl p-4 flex items-start gap-4 transition hover:border-blue-300"
               onclick="selectType('renovation', this)">
          <%= f.radio_button :offer_type, "renovation", class: "hidden mt-1" %>
          <span class="text-2xl shrink-0">🔨</span>
          <div>
            <p class="font-bold text-gray-800">Devis rénovation / travaux</p>
            <p class="text-xs text-gray-500 mt-0.5">Isolation, chauffage, menuiseries — vous proposez une intervention chiffrée.</p>
          </div>
        </label>

        <label class="offer-type-label cursor-pointer border-2 border-gray-200 rounded-xl p-4 flex items-start gap-4 transition hover:border-purple-300"
               onclick="selectType('financement', this)">
          <%= f.radio_button :offer_type, "financement", class: "hidden mt-1" %>
          <span class="text-2xl shrink-0">🏦</span>
          <div>
            <p class="font-bold text-gray-800">Expression d'intérêt — financement</p>
            <p class="text-xs text-gray-500 mt-0.5">Vous signifiez votre intérêt pour étudier le dossier. Le propriétaire vous contactera avec ses informations personnelles.</p>
          </div>
        </label>

        <label class="offer-type-label cursor-pointer border-2 border-gray-200 rounded-xl p-4 flex items-start gap-4 transition hover:border-orange-300"
               onclick="selectType('achat_promoteur', this)">
          <%= f.radio_button :offer_type, "achat_promoteur", class: "hidden mt-1" %>
          <span class="text-2xl shrink-0">🏗️</span>
          <div>
            <p class="font-bold text-gray-800">Offre d'achat — promoteur / investisseur</p>
            <p class="text-xs text-gray-500 mt-0.5">Vous proposez un prix d'acquisition ferme ou indicatif.</p>
          </div>
        </label>

      </div>
    </div>

    <%# Bloc montant — masqué pour financement %>
    <div id="bloc-montant" class="bg-white border border-gray-100 rounded-2xl p-6 hidden">
      <p class="text-sm font-bold text-gray-700 mb-3" id="montant-label">Montant proposé</p>
      <div class="flex items-center border border-gray-200 rounded-xl overflow-hidden bg-gray-50">
        <%= f.number_field :amount, placeholder: "ex : 24 500",
            class: "flex-1 px-4 py-3 text-sm bg-transparent border-none outline-none",
            min: 0 %>
        <span class="px-4 text-gray-400 text-sm shrink-0">€</span>
      </div>
      <p class="text-xs text-gray-400 mt-2" id="montant-hint"></p>
    </div>

    <%# Bloc message %>
    <div class="bg-white border border-gray-100 rounded-2xl p-6">
      <p class="text-sm font-bold text-gray-700 mb-1" id="desc-label">Votre message</p>
      <p class="text-xs text-gray-400 mb-3" id="desc-hint">Décrivez votre proposition clairement.</p>
      <%= f.text_area :description,
          rows: 4,
          id: "desc-field",
          placeholder: "Décrivez votre proposition...",
          class: "w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400 bg-gray-50 resize-none" %>
    </div>

    <%# Encadré info financement — visible uniquement pour ce type %>
    <div id="bloc-financement-info" class="hidden bg-purple-50 border border-purple-200 rounded-2xl p-5 text-sm text-purple-800">
      <p class="font-bold mb-2">ℹ️ Comment fonctionne une expression d'intérêt ?</p>
      <p class="leading-relaxed text-purple-700">Votre proposition sera transmise au propriétaire. <strong>Si celui-ci est intéressé</strong>, il vous contactera directement et vous communiquera les éléments complémentaires nécessaires à une simulation complète : revenus, situation professionnelle, charges de crédit existantes.</p>
      <p class="mt-2 text-purple-600 text-xs">Lotys ne transmet aucune donnée personnelle du propriétaire sans son accord explicite.</p>
    </div>

    <%# CTA %>
    <div class="text-center pb-4">
      <%= f.submit "Envoyer ma proposition →",
          class: "bg-emerald-600 text-white px-10 py-4 rounded-2xl hover:bg-emerald-700 font-bold text-base shadow-sm cursor-pointer transition" %>
      <p class="text-xs text-gray-400 mt-3">Votre identité n'est pas visible du propriétaire avant qu'il accepte votre offre.</p>
    </div>

  <% end %>
</div>

<script>
const typeConfig = {
  renovation: {
    montant: true,
    montantLabel: "Montant du devis (TTC)",
    montantHint: "Montant total des travaux proposés, aides déduites ou non.",
    descLabel: "Détail de votre intervention",
    descHint: "Prestations incluses, délai d'intervention, certifications RGE, accompagnement dossier MaPrimeRénov'…",
    descPlaceholder: "Ex : Isolation combles + remplacement chaudière fioul par PAC air/eau. Certifié RGE Qualibat. Accompagnement dossier MaPrimeRénov' inclus. Délai : 6 semaines.",
    borderColor: "border-blue-400",
    bgColor: "#eff6ff",
    finInfo: false
  },
  financement: {
    montant: false,
    descLabel: "Votre message au propriétaire",
    descHint: "Présentez votre établissement, vos spécialités (éco-PTZ, prêt travaux, crédit immobilier), et indiquez comment vous contacter.",
    descPlaceholder: "Ex : Courtier spécialisé en financement de rénovation énergétique. Partenaire de 15 banques. Je peux monter un dossier éco-PTZ + prêt travaux complémentaire. Réponse de principe en 48h.",
    borderColor: "border-purple-400",
    bgColor: "#faf5ff",
    finInfo: true
  },
  achat_promoteur: {
    montant: true,
    montantLabel: "Offre d'achat indicative (€)",
    montantHint: "Prix indicatif ou fourchette — précisez dans le message si l'offre est sous conditions.",
    descLabel: "Détail de votre offre",
    descHint: "Projet envisagé, conditions suspensives, délai de réalisation, accompagnement notarial…",
    descPlaceholder: "Ex : Acquisition en vue de réhabilitation et division en 4 appartements. Offre sous 30 jours. Accompagnement notarial offert.",
    borderColor: "border-orange-400",
    bgColor: "#fff7ed",
    finInfo: false
  }
};

function selectType(type, el) {
  // Reset tous les labels
  document.querySelectorAll('.offer-type-label').forEach(l => {
    l.style.borderColor = '#e5e7eb';
    l.style.background = 'white';
  });

  // Activer le label sélectionné
  const cfg = typeConfig[type];
  el.style.borderColor = cfg.borderColor.replace('border-', '').replace('-400', '');
  // Utiliser une couleur directe
  const colors = { renovation: '#3b82f6', financement: '#a855f7', achat_promoteur: '#f97316' };
  el.style.borderColor = colors[type];
  el.style.background = cfg.bgColor;

  // Bloc montant
  const blocMontant = document.getElementById('bloc-montant');
  if (cfg.montant) {
    blocMontant.classList.remove('hidden');
    document.getElementById('montant-label').textContent = cfg.montantLabel;
    document.getElementById('montant-hint').textContent = cfg.montantHint;
  } else {
    blocMontant.classList.add('hidden');
  }

  // Description
  document.getElementById('desc-label').textContent = cfg.descLabel;
  document.getElementById('desc-hint').textContent = cfg.descHint;
  document.getElementById('desc-field').placeholder = cfg.descPlaceholder;

  // Info financement
  const blocFin = document.getElementById('bloc-financement-info');
  cfg.finInfo ? blocFin.classList.remove('hidden') : blocFin.classList.add('hidden');
}
</script>
