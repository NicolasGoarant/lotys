<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%# Title et og:image surchargables par la vue via content_for. Fallback
       "Lauze" si aucune vue n'a défini de titre — comportement historique
       préservé. Utilisé notamment par le portail EPCI (C7) pour un partage
       social crédible aux couleurs de la collectivité. %>
  <title><%= content_for?(:title) ? yield(:title) : "Lauze" %></title>
  <% if content_for?(:og_image) %>
    <meta property="og:image" content="<%= yield(:og_image) %>">
    <meta name="twitter:card"  content="summary_large_image">
  <% end %>
  <% if content_for?(:og_description) %>
    <meta property="og:description" content="<%= yield(:og_description) %>">
    <meta name="description"        content="<%= yield(:og_description) %>">
  <% end %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="min-h-screen bg-white text-gray-900 flex flex-col">
  <%= render "shared/navbar" %>

  <% if notice.present? %>
    <%# Auto-disparition après 4 s (cf. controllers/flash_controller.js). Les
        alertes ci-dessous ne portent PAS data-controller="flash" — un message
        d'erreur doit rester affiché tant que l'utilisateur ne navigue pas. %>
    <div class="mx-auto mt-4 w-full max-w-5xl rounded-xl bg-green-50 px-4 py-3 text-green-700"
         data-controller="flash"
         style="transition: opacity 800ms ease-out">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="mx-auto mt-4 w-full max-w-5xl rounded-xl bg-red-50 px-4 py-3 text-red-700">
      <%= alert %>
    </div>
  <% end %>

  <main class="flex-1">
    <%= yield %>
  </main>

  <%= render "shared/footer", variant: (controller_name == "pages" && action_name == "home" ? :overlay : :default) %>
</body>
</html>
