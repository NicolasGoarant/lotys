
<%# Bloc vert mobile %>
<div class="lg-hide" style="background:linear-gradient(135deg,#059669,#065f46);padding:20px 20px 24px;">
  <p style="color:white;font-size:1.3rem;font-weight:900;line-height:1.25;margin:0 0 14px;">Pas reçu l'email ?<br>On vous le renvoie.</p>
  <div style="display:flex;flex-direction:column;gap:8px;">
    <% [
      ["📨", "Renvoi immédiat", "Quelques secondes maximum"],
      ["📬", "Pensez aux indésirables", "Le filtre anti-spam fait des siennes"],
      ["✅", "Lien à usage unique", "Sécurisé et personnel"],
    ].each do |emoji, title, desc| %>
      <div style="display:flex;align-items:center;gap:10px;background:rgba(255,255,255,0.12);border-radius:10px;padding:10px 14px;">
        <span style="font-size:1.1rem;"><%= emoji %></span>
        <div>
          <p style="color:white;font-weight:700;font-size:0.8rem;margin:0;"><%= title %></p>
          <p style="color:#6ee7b7;font-size:0.72rem;margin:1px 0 0;"><%= desc %></p>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# Layout 2 colonnes desktop %>
<div class="auth-layout">

  <%# Colonne verte desktop %>
  <div class="lg-show auth-green-col" style="display:none;">
    <div style="position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=900&q=80');background-size:cover;background-position:center;opacity:0.12;"></div>
    <div style="position:relative;z-index:10;">
      <p style="color:white;font-size:2.25rem;font-weight:900;line-height:1.2;margin-bottom:2rem;">Pas reçu l'email ?<br>On vous le renvoie.</p>
      <% [
        ["📨", "Renvoi immédiat", "Quelques secondes maximum"],
        ["📬", "Pensez aux indésirables", "Le filtre anti-spam fait parfois des siennes"],
        ["✅", "Lien à usage unique", "Sécurisé et strictement personnel"],
      ].each do |emoji, title, desc| %>
        <div style="display:flex;gap:12px;margin-bottom:1.25rem;">
          <span style="font-size:1.5rem;line-height:1;margin-top:2px;"><%= emoji %></span>
          <div>
            <p style="color:white;font-weight:600;margin:0;"><%= title %></p>
            <p style="color:#6ee7b7;font-size:0.875rem;margin:2px 0 0;"><%= desc %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Colonne formulaire %>
  <div class="auth-form-col">
    <div style="width:100%;max-width:380px;">

      <h1 style="font-size:1.75rem;font-weight:900;color:#111827;margin:0 0 4px;">Renvoyer l'email de confirmation</h1>
      <p style="color:#6b7280;font-size:0.875rem;margin:0 0 1.75rem;">
        Saisissez l'email utilisé à l'inscription, on vous renvoie le lien de confirmation.
      </p>

      <% if resource.errors.any? %>
        <div style="background:#fef2f2;border:1px solid #fecaca;color:#dc2626;border-radius:0.75rem;padding:12px 16px;font-size:0.875rem;margin-bottom:1.25rem;">
          <% resource.errors.full_messages.each do |msg| %>
            <p style="margin:0 0 4px;"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f| %>
        <div style="margin-bottom:1.25rem;">
          <%= f.label :email, "Email", style: "display:block;font-size:0.875rem;font-weight:600;color:#374151;margin-bottom:6px;" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
              style: "width:100%;padding:12px 16px;border-radius:12px;border:1px solid #e5e7eb;background:white;font-size:0.875rem;box-sizing:border-box;",
              placeholder: "vous@exemple.fr" %>
        </div>
        <%= f.submit "Renvoyer l'email →",
            style: "width:100%;background:#059669;color:white;font-weight:700;padding:14px;border-radius:12px;border:none;font-size:0.9375rem;cursor:pointer;" %>
      <% end %>

      <p style="text-align:center;font-size:0.875rem;color:#6b7280;margin-top:1.5rem;">
        <%= link_to "← Retour à la connexion", new_session_path(resource_name), style: "color:#059669;font-weight:600;text-decoration:none;" %>
      </p>

      <% if devise_mapping.recoverable? %>
        <p style="text-align:center;font-size:0.8125rem;color:#9ca3af;margin-top:0.75rem;">
          <%= link_to "Mot de passe oublié ?", new_password_path(resource_name), style: "color:#6b7280;text-decoration:underline;" %>
        </p>
      <% end %>

    </div>
  </div>
</div>

<style>
  .auth-layout { display: block; }
  .auth-form-col {
    background: #f9fafb;
    padding: 2rem 1.5rem 5rem;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .auth-green-col {
    width: 50%;
    background: linear-gradient(135deg,#059669,#065f46);
    flex-direction: column;
    justify-content: center;
    padding: 4rem;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .auth-layout { display: flex; min-height: calc(100vh - 60px); }
    .auth-form-col { flex: 1; padding: 3rem 1.5rem; }
    .lg-show { display: flex !important; }
    .lg-hide { display: none !important; }
  }
</style>
