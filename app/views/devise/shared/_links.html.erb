<%# Partial historique Devise — listé ici en français pour le cas où une vue
    non personnalisée le réutilise. Les vues stylées (sessions, registrations,
    passwords, confirmations) ont leurs propres liens contextuels et ne
    rendent PAS ce partial. %>

<div style="margin-top:1.25rem;display:flex;flex-direction:column;gap:6px;font-size:0.875rem;text-align:center;">

  <%- if controller_name != 'sessions' %>
    <p style="margin:0;"><%= link_to "Se connecter", new_session_path(resource_name), style: "color:#059669;font-weight:600;text-decoration:none;" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p style="margin:0;"><%= link_to "Créer un compte", new_registration_path(resource_name), style: "color:#059669;font-weight:600;text-decoration:none;" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p style="margin:0;"><%= link_to "Mot de passe oublié ?", new_password_path(resource_name), style: "color:#6b7280;text-decoration:underline;" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p style="margin:0;"><%= link_to "Pas reçu l'email de confirmation ?", new_confirmation_path(resource_name), style: "color:#6b7280;text-decoration:underline;" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p style="margin:0;"><%= link_to "Pas reçu l'email de déverrouillage ?", new_unlock_path(resource_name), style: "color:#6b7280;text-decoration:underline;" %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p style="margin:0;"><%= button_to "Se connecter avec #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false } %></p>
    <% end %>
  <% end %>

</div>
