<%# app/views/properties/_form.html.erb %>

<%= form_with model: property do |f| %>

  <%# Erreurs %>
  <% if property.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-sm text-red-700 mb-5">
      <% property.errors.full_messages.each do |msg| %>
        <p class="flex items-start gap-2"><span>⚠️</span><span><%= msg %></span></p>
      <% end %>
    </div>
  <% end %>

  <%# ── Section : Localisation ──────────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm mb-4 overflow-hidden">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">📍 Localisation</p>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <%= f.label :address, "Adresse", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :address, placeholder: "3 impasse du Canal",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
      <div>
        <%= f.label :city, "Ville", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :city, placeholder: "Nancy",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
      <div>
        <%= f.label :zipcode, "Code postal", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :zipcode, placeholder: "54000",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
    </div>
  </div>

  <%# ── Section : Caractéristiques ──────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm mb-4 overflow-hidden">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">🏠 Caractéristiques</p>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :property_type, "Type de bien", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :property_type,
              [["Appartement", "appartement"], ["Maison", "maison"]],
              { include_blank: "— Sélectionner —" },
              class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
      <div>
        <%= f.label :surface, "Surface (m²)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :surface, placeholder: "46",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
      <div>
        <%= f.label :construction_year, "Année de construction", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :construction_year, placeholder: "1948",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
      <div>
        <%= f.label :nb_rooms, "Nombre de pièces", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :nb_rooms, placeholder: "3",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>

      <%# Copropriété %>
      <div class="sm:col-span-2 flex items-center gap-3 py-1">
        <%= f.check_box :is_copropriete,
            class: "w-4 h-4 accent-emerald-600 rounded shrink-0" %>
        <%= f.label :is_copropriete, "Bien en copropriété",
            class: "text-sm font-medium text-gray-700 cursor-pointer" %>
      </div>
      <div>
        <%= f.label :nb_lots, "Nombre de lots (copropriété)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :nb_lots, placeholder: "6",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
    </div>
  </div>

  <%# ── Section : Performance énergétique ───────────────────────── %>
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm mb-4 overflow-hidden">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">⚡ Performance énergétique</p>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :dpe_class, "Classe DPE actuelle", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :dpe_class, %w[A B C D E F G],
              { include_blank: "— Inconnue —" },
              class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
      <div>
        <%= f.label :dpe_target, "Classe DPE visée", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-xs text-gray-400 mb-1.5">Objectif après travaux de rénovation</p>
        <%= f.select :dpe_target, %w[A B C D E F G],
              { include_blank: "— Non définie —" },
              class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
    </div>
  </div>

  <%# ── Section : Situation ──────────────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm mb-4 overflow-hidden">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">📋 Situation</p>
    </div>
    <div class="p-5 space-y-4">
      <div class="flex items-center gap-3">
        <%= f.check_box :vacant, class: "w-4 h-4 accent-emerald-600 rounded shrink-0" %>
        <%= f.label :vacant, "Bien actuellement vacant (inoccupé)", class: "text-sm font-medium text-gray-700 cursor-pointer" %>
      </div>
    </div>
  </div>

  <%# ── Section : Foyer fiscal (dérive la tranche pour MPR / Grand Nancy) ─ %>
  <div class="bg-white rounded-2xl border border-emerald-100 shadow-sm mb-6 overflow-hidden">
    <div class="px-5 py-3 bg-emerald-50 border-b border-emerald-100">
      <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider">💰 Foyer fiscal</p>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :household_size, "Nombre de personnes du foyer fiscal",
              class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :household_size, min: 1, max: 19,
              class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>
      <div>
        <%= f.label :rfr, "Revenu fiscal de référence (€)",
              class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-xs text-gray-400 mb-1.5">Sur votre dernier avis d'imposition.</p>
        <%= f.number_field :rfr, min: 0, step: 1,
              class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" %>
      </div>

      <% if property.household_size.present? %>
        <% seuils = IncomeBracketCalculator.plafonds_for(property.household_size) %>
        <p class="sm:col-span-2 text-xs text-gray-500 leading-relaxed">
          Pour un foyer de <%= property.household_size %> personne<%= "s" if property.household_size.to_i > 1 %> :
          très modestes ≤ <%= number_with_delimiter(seuils[:tres_modeste]) %> € ·
          modestes ≤ <%= number_with_delimiter(seuils[:modeste]) %> € ·
          intermédiaires ≤ <%= number_with_delimiter(seuils[:intermediaire]) %> € ·
          au-delà : supérieurs.
        </p>
      <% end %>

      <% if property.income_bracket.present? %>
        <p class="sm:col-span-2 text-sm font-semibold text-emerald-700">
          Tranche dérivée : <%= property.income_bracket.humanize %>
        </p>
      <% else %>
        <p class="sm:col-span-2 text-sm text-gray-500 italic">
          Renseignez vos revenus pour calculer vos aides.
        </p>
      <% end %>
    </div>
  </div>

  <%# ── Actions ──────────────────────────────────────────────────── %>
  <div class="flex flex-col sm:flex-row gap-3">
    <%= f.submit "Enregistrer les modifications",
        class: "flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl hover:bg-emerald-700 text-sm font-bold cursor-pointer text-center transition" %>
    <%= link_to "Annuler", property, class: "flex-1 text-center border border-gray-200 text-gray-500 px-6 py-3 rounded-xl hover:bg-gray-50 text-sm font-medium transition" %>
  </div>

<% end %>
