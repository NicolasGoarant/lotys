<%# app/views/properties/_simple_aids.html.erb
     Bloc Aides simplifié : une ligne par aide, montant selon profil revenus sélectionné.

     Particularité : Grand Nancy Rénovation Globale est rendue EN DOUBLE :
       - ligne active dans la liste des subventions (affichée si cible = A ou B)
       - bloc potentiel grisé sous le total (affiché sinon)
     Le JS (recalcAidesProportionnel) bascule entre les deux selon la cible DPE
     courante du slider, et met à jour le total en conséquence.

     Locals attendus :
       - property            : la Property
       - aid_result          : retour de AidCalculatorService
       - aid_projection      : retour de AidProjectionService (peut être nil)
                               Hash { target:, delta:, total: } si une cible supérieure
                               débloque plus d'aides. nil = silence (déjà optimal, revenus
                               manquants, ou aucun saut ne change le total).
       - is_owner_connecte   : true si propriétaire connecté du bien. Discrimine les
                               actions qui MUTENT (submits réels) vs le claimant
                               anonyme à qui on propose de s'inscrire au lieu de
                               cliquer un submit qui jetterait sa saisie au passage
                               par sign-in. Défaut false = sûr (jamais de fuite owner
                               si l'appelant oublie le local).
-%>

<% aid_projection   ||= nil %>
<% is_owner_connecte = local_assigns.fetch(:is_owner_connecte, false) %>

<%# income_bracket n'est plus saisie directement : on la dérive de
    household_size + RFR via IncomeBracketCalculator (cf. before_save).
    Les seuils € sont calculés au runtime selon la taille du foyer — plus
    de libellés "< 21 k€" figés qui mentaient pour les foyers > 1 personne. %>
<% seuils_foyer = property.household_size.to_i > 0 ? IncomeBracketCalculator.plafonds_for(property.household_size) : nil %>

<%# Extraction explicite des aides connues %>
<% subventions  = (aid_result && aid_result[:subventions])        || [] %>
<% potentielles = (aid_result && aid_result[:aides_potentielles]) || [] %>

<% gn_slug      = "grand_nancy_renovation_globale" %>
<% mpr_aid      = subventions.find { |a| a[:type] == "mpr" } %>
<% cee_aid      = subventions.find { |a| a[:type] == "cee" } %>
<% gn_aid       = subventions.find { |a| a[:slug] == gn_slug } || potentielles.find { |a| a[:slug] == gn_slug } %>
<% gn_active_now = subventions.any? { |a| a[:slug] == gn_slug } %>
<% other_potentielles = potentielles.reject { |a| a[:slug] == gn_slug } %>

<%# Drapeau posé par TravauxDefaultsDeriver quand au moins une colonne
    structurée a été remplie par défaut faute d'analyse documentaire. La vue
    doit alors clairement signaler que les montants sont des estimations
    indicatives, pas des chiffres mesurés. %>
<% inputs_estimes = (property.equipements_selection || {})["inputs_estimes"] == true %>

<%# Total initial : MPR + CEE + (GN si active) — aligné sur le serveur %>
<% total_initial = [mpr_aid, cee_aid, (gn_active_now ? gn_aid : nil)].compact.sum { |a| a[:amount].to_i } %>

<div class="cd">
  <div class="cd-hd" style="background:#5b21b6;display:flex;align-items:center;justify-content:space-between;gap:10px;">
    <span>💶 Aides auxquelles vous avez droit</span>
    <%# Texte du badge stale, révélé en JS par marquerAidesPerimees() après
         chaque coche/décoche. Owner : peut cliquer le submit pour obtenir
         le vrai calcul. Claimant : pas de chemin vers un vrai recalcul tant
         qu'il n'est pas inscrit — on lui dit honnêtement "estimation
         indicative". Le JS reste agnostique : il ne fait que basculer
         display:none → inline-block, le texte est figé côté serveur. %>
    <span id="aides-stale-badge" style="display:none;background:#fbbf24;color:#78350f;font-size:.62rem;font-weight:800;padding:3px 8px;border-radius:10px;text-transform:none;letter-spacing:0;">
      <% if is_owner_connecte %>
        À recalculer — cliquez "Mettre à jour les aides"
      <% else %>
        Estimation indicative — créez votre compte pour le calcul exact
      <% end %>
    </span>
  </div>

  <div style="padding:20px;">
    <%# Saisie du foyer fiscal : persiste household_size + rfr en DB via
        update_income_bracket. income_bracket est dérivé au before_save. %>
    <%= form_with url: update_income_bracket_property_path(property),
                  method: :patch,
                  scope: :property,
                  data: { turbo: false },
                  html: { style: "margin:0 0 20px;" } do |f| %>
      <p class="lbl" style="margin-bottom:8px;">Votre foyer fiscal</p>
      <div style="display:grid;grid-template-columns:1fr 1fr auto;gap:8px;align-items:end;">
        <div>
          <label style="display:block;font-size:.7rem;font-weight:600;color:#6b7280;margin-bottom:4px;">Nombre de personnes</label>
          <%= f.number_field :household_size, value: property.household_size, min: 1, max: 19,
                style: "width:100%;padding:9px 10px;border:1px solid #e5e7eb;border-radius:8px;font-size:.85rem;background:#fff;" %>
        </div>
        <div>
          <label style="display:block;font-size:.7rem;font-weight:600;color:#6b7280;margin-bottom:4px;">RFR (€)</label>
          <%= f.number_field :rfr, value: property.rfr, min: 0, step: 1,
                placeholder: "Avis d'imposition",
                style: "width:100%;padding:9px 10px;border:1px solid #e5e7eb;border-radius:8px;font-size:.85rem;background:#fff;" %>
        </div>
        <%# Owner : vrai submit qui poste vers update_income_bracket. Claimant :
             lien d'inscription au même emplacement — l'action est protégée par
             authenticate_user! et la saisie RFR serait perdue au sign-in. %>
        <% if is_owner_connecte %>
          <%= f.submit "Recalculer",
                style: "padding:10px 14px;background:#5b21b6;color:#fff;border:none;border-radius:8px;font-weight:700;font-size:.78rem;cursor:pointer;white-space:nowrap;" %>
        <% else %>
          <%= link_to "Créer un compte pour calculer →",
                new_user_registration_path,
                style: "padding:10px 14px;background:#5b21b6;color:#fff;border-radius:8px;font-weight:700;font-size:.78rem;text-decoration:none;display:inline-block;white-space:nowrap;text-align:center;" %>
        <% end %>
      </div>

      <% if property.income_bracket.present? && seuils_foyer %>
        <p class="lbl" style="margin-top:10px;color:#5b21b6;text-transform:none;letter-spacing:0;font-weight:600;font-size:.72rem;">
          Tranche dérivée : <strong><%= property.income_bracket.humanize %></strong>
          <span style="color:#9ca3af;font-weight:500;">
            (foyer de <%= property.household_size %> ·
            très modestes ≤ <%= number_with_delimiter(seuils_foyer[:tres_modeste]) %> € ·
            modestes ≤ <%= number_with_delimiter(seuils_foyer[:modeste]) %> € ·
            intermédiaires ≤ <%= number_with_delimiter(seuils_foyer[:intermediaire]) %> €)
          </span>
        </p>
      <% elsif property.rfr.blank? %>
        <p class="lbl" style="margin-top:10px;color:#9ca3af;text-transform:none;letter-spacing:0;font-weight:500;font-size:.72rem;font-style:italic;">
          Renseignez vos revenus pour calculer vos aides.
        </p>
      <% end %>
    <% end %>

    <% if mpr_aid || cee_aid || gn_aid %>
      <%# Bandeau d'honnêteté : montants estimés sur surfaces et équipements
           par défaut, faute de quantites_mpr issues d'une analyse documentaire.
           Inciter explicitement à lancer (ou relancer) l'analyse pour affiner. %>
      <% if inputs_estimes %>
        <div style="background:#fef3c7;border:1px solid #fde68a;border-radius:10px;padding:10px 12px;margin-bottom:14px;display:flex;gap:8px;align-items:flex-start;">
          <span style="font-size:.95rem;flex-shrink:0;">ℹ️</span>
          <p class="bod" style="font-size:.78rem;color:#78350f;line-height:1.45;">
            <strong>Estimation indicative</strong> — les montants ci-dessous reposent sur des
            surfaces et équipements <em>par défaut</em> dérivés des cases cochées, faute
            d'analyse documentaire complète. Pour affiner, ajoutez votre DPE, vos devis ou
            relancez l'analyse depuis la fiche du bien.
          </p>
        </div>
      <% end %>

      <%# Ligne MPR %>
      <% if mpr_aid %>
        <div style="display:flex;justify-content:space-between;align-items:baseline;padding:11px 0;border-bottom:1px solid #f3f4f6;gap:12px;">
          <div style="flex:1;">
            <p class="bod" style="font-weight:600;">🏛️ <%= mpr_aid[:name].split("—").first.strip %></p>
          </div>
          <p class="bod" style="font-weight:800;white-space:nowrap;font-size:1rem;" id="aide-mpr-val">
            <%= number_to_currency(mpr_aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
          </p>
        </div>
      <% end %>

      <%# Ligne CEE %>
      <% if cee_aid %>
        <div style="display:flex;justify-content:space-between;align-items:baseline;padding:11px 0;border-bottom:1px solid #f3f4f6;gap:12px;">
          <div style="flex:1;">
            <p class="bod" style="font-weight:600;">🔋 <%= cee_aid[:name].split("—").first.strip %></p>
          </div>
          <p class="bod" style="font-weight:800;white-space:nowrap;font-size:1rem;" id="aide-cee-val">
            <%= number_to_currency(cee_aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
          </p>
        </div>
      <% end %>

      <%# Ligne Grand Nancy — version ACTIVE (affichée si cible DPE = A ou B).
           Le JS bascule son display en fonction du slider. -%>
      <% if gn_aid %>
        <div id="gn-active-row"
             style="display:<%= gn_active_now ? 'flex' : 'none' %>;justify-content:space-between;align-items:baseline;padding:11px 0;border-bottom:1px solid #f3f4f6;gap:12px;">
          <div style="flex:1;">
            <p class="bod" style="font-weight:600;">🏛️ <%= gn_aid[:name].split("—").first.strip %></p>
            <p class="lbl" style="margin-top:2px;font-size:.66rem;">Complémentaire à MaPrimeRénov'</p>
          </div>
          <p class="bod" style="font-weight:800;white-space:nowrap;font-size:1rem;" id="aide-gn-val">
            <%= number_to_currency(gn_aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
          </p>
        </div>
      <% end %>

      <%# Total des aides — mis à jour en temps réel par le JS %>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px;background:#ede9fe;border-radius:12px;margin-top:14px;">
        <p class="bod" style="font-weight:700;color:#5b21b6;">💰 Total des aides</p>
        <p style="font-size:1.25rem;font-weight:900;color:#5b21b6;white-space:nowrap;" id="aide-total-val">
          <%= number_to_currency(total_initial, unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
        </p>
      </div>

      <%# Invitation à viser plus ambitieux (LECTURE SEULE, ne touche ni à
           la cible serveur ni au total ci-dessus). Affichée uniquement si
           AidProjectionService a trouvé une cible supérieure qui débloque
           réellement plus d'aides. Le delta est arrondi au 500 € le plus
           proche : "~X €" = ordre de grandeur honnête, pas un chiffre net. -%>
      <% if aid_projection %>
        <% delta_arrondi = aid_projection[:delta] >= 1000 ? (aid_projection[:delta] / 500.0).round * 500 : aid_projection[:delta] %>
        <div style="margin-top:14px;padding:14px 16px;background:#faf5ff;border:2px dashed #c4b5fd;border-radius:12px;">
          <p class="bod" style="margin:0 0 6px;font-size:.82rem;color:#374151;">
            Vos aides actuelles sont calculées sur votre objectif <strong><%= property.dpe_target %></strong>.
          </p>
          <p class="bod" style="margin:0;font-size:.82rem;color:#374151;line-height:1.5;">
            En visant <strong><%= aid_projection[:target] %></strong>, vous débloqueriez environ
            <strong style="color:#5b21b6;">~<%= number_to_currency(delta_arrondi, unit: "€", format: "%n %u", precision: 0, delimiter: " ") %></strong>
            de plus — glissez la jauge dans la card « Rénovation énergétique » pour voir le détail.
          </p>
        </div>
      <% end %>

      <%# Bloc Grand Nancy — version POTENTIELLE (affichée si cible DPE ≠ A/B).
           Le JS bascule son display en fonction du slider, et écrit le montant
           dans #aide-gn-pot-val. Le préfixe "+" est porté par un span séparé
           pour ne pas être écrasé par le JS. La carte est volontairement
           lisible (liseré violet Lauze, badge "À DÉBLOQUER") pour que
           l'utilisateur la voie sans la confondre avec une aide acquise.
           Le montant N'EST PAS additionné au "Total des aides" : il reste
           conditionnel tant que la cible DPE n'a pas basculé en A ou B. -%>
      <% if gn_aid %>
        <div id="gn-potential-block" style="display:<%= gn_active_now ? 'none' : 'block' %>;margin-top:14px;padding:14px 16px;background:#fff;border:2px dashed #5b21b6;border-radius:12px;">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap;">
            <div style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
              <span style="font-size:.6rem;font-weight:800;color:#5b21b6;background:#ede9fe;padding:3px 8px;border-radius:6px;text-transform:uppercase;letter-spacing:.08em;white-space:nowrap;">À débloquer</span>
              <p class="bod" style="font-weight:700;color:#1f2937;font-size:.9rem;">🏛️ <%= gn_aid[:name].split("—").first.strip %></p>
            </div>
            <p class="bod" style="font-weight:800;color:#5b21b6;white-space:nowrap;font-size:1rem;">
              + <span id="aide-gn-pot-val"><%= number_to_currency(gn_aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %></span>
            </p>
          </div>
          <%# Invitation à activer Grand Nancy Rénovation Globale.
               Owner : le bouton « Mettre à jour les aides » existe pour lui et
               recharge avec le vrai montant. Claimant : le bouton n'existe pas
               (cf. fix point 1) — référencer son libellé serait mensonger. On
               renvoie plutôt vers la création de compte. %>
          <p class="bod" style="margin:0;font-size:.78rem;color:#374151;line-height:1.5;">
            <% if is_owner_connecte %>
              Atteignez l'<strong>objectif B ou A</strong> pour activer cette aide : ajustez la jauge
              dans la card « Rénovation énergétique » puis cliquez <strong>« Mettre à jour les aides »</strong>.
              Non comptée dans le total ci-dessus tant que la condition n'est pas remplie.
            <% else %>
              Atteignez l'<strong>objectif B ou A</strong> pour activer cette aide : ajustez la jauge
              dans la card « Rénovation énergétique », puis
              <%= link_to "créez votre compte", new_user_registration_path, style: "color:#5b21b6;font-weight:700;text-decoration:underline;" %>
              pour valider cette estimation. Non comptée dans le total ci-dessus tant que la condition
              n'est pas remplie.
            <% end %>
          </p>
        </div>
      <% end %>

      <%# Autres aides potentielles (hors Grand Nancy) %>
      <% if other_potentielles.any? %>
        <p class="lbl" style="margin-top:18px;margin-bottom:6px;color:#9ca3af;">Aides disponibles sous condition</p>
        <% other_potentielles.each do |aid| %>
          <div style="padding:10px 12px;background:#f9fafb;border:1px dashed #d1d5db;border-radius:10px;margin-bottom:6px;opacity:0.75;">
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;">
              <p class="bod" style="font-weight:600;color:#6b7280;font-size:.85rem;">
                🏛️ <%= aid[:name].split("—").first.strip %>
              </p>
              <p class="bod" style="font-weight:700;color:#6b7280;white-space:nowrap;font-size:.9rem;">
                <%= number_to_currency(aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
              </p>
            </div>
            <p class="lbl" style="margin-top:4px;color:#9ca3af;text-transform:none;letter-spacing:0;font-weight:500;font-size:.72rem;line-height:1.4;">
              💡 <%= aid[:note] || aid[:basis] %>
            </p>
          </div>
        <% end %>
      <% end %>

      <%# Prérequis France Rénov' %>
      <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:12px 14px;margin-top:14px;display:flex;gap:10px;align-items:flex-start;">
        <span style="font-size:1rem;flex-shrink:0;">ℹ️</span>
        <p class="bod" style="font-size:.8rem;color:#78350f;line-height:1.5;">
          <strong>Avant de démarrer les travaux</strong>, contactez un conseiller
          <a href="https://france-renov.gouv.fr" target="_blank" rel="noopener" style="color:#b45309;font-weight:700;text-decoration:underline;">France Rénov'</a>
          pour activer vos aides. Sans cette étape, les dossiers MaPrimeRénov' et Grand Nancy ne sont pas recevables.
        </p>
      </div>

    <% else %>
      <% if property.draft? || property.analyzing? %>
        <%# Analyse pas (encore) terminée → l'absence d'aides est suspecte,
            on guide l'utilisateur vers la cause probable. %>
        <p class="bod" style="color:#9ca3af;font-style:italic;">Aucune aide calculable — vérifiez que l'analyse IA a bien été lancée.</p>
      <% elsif aid_projection %>
        <%# Pas d'aide à la cible courante MAIS une cible supérieure en
            débloquerait. On invite à explorer plutôt que d'annoncer un
            verdict décourageant ("Aucune aide retenue") qui ferait fuir
            un propriétaire qui en aurait pourtant droit. -%>
        <% delta_arrondi = aid_projection[:delta] >= 1000 ? (aid_projection[:delta] / 500.0).round * 500 : aid_projection[:delta] %>
        <div style="padding:14px 16px;background:#faf5ff;border:2px dashed #c4b5fd;border-radius:12px;">
          <p class="bod" style="margin:0 0 6px;font-size:.82rem;color:#374151;">
            Vos aides actuelles sont calculées sur votre objectif <strong><%= property.dpe_target %></strong>.
          </p>
          <p class="bod" style="margin:0;font-size:.82rem;color:#374151;line-height:1.5;">
            En visant <strong><%= aid_projection[:target] %></strong>, vous débloqueriez environ
            <strong style="color:#5b21b6;">~<%= number_to_currency(delta_arrondi, unit: "€", format: "%n %u", precision: 0, delimiter: " ") %></strong>
            de plus — glissez la jauge dans la card « Rénovation énergétique » pour voir le détail.
          </p>
        </div>
      <% else %>
        <%# Bien analysé/publié sans aides ET aucune cible supérieure ne
            change la donne : message neutre. Pas de faux espoir. %>
        <p class="bod" style="color:#9ca3af;font-style:italic;">Aucune aide retenue pour le moment — ajustez la jauge ci-dessus.</p>
      <% end %>
    <% end %>

    <%# Errors / warnings du calculateur, si existants.
        On filtre les erreurs préfixées "[interne]" (pannes techniques
        type "règle absente en DB") — elles vont en logs Heroku via
        Rails.logger.error, pas à l'écran utilisateur. La vue n'affiche
        que les erreurs métier explicables ("logement doit avoir ≥ 15 ans"). -%>
    <% if aid_result && aid_result[:errors]&.any? %>
      <% user_facing_errors = aid_result[:errors].reject { |e| e.to_s.start_with?("[interne]") } %>
      <% if user_facing_errors.any? %>
        <div style="margin-top:10px;">
          <% user_facing_errors.each do |err| %>
            <p class="lbl" style="color:#b45309;margin-bottom:4px;font-size:.7rem;text-transform:none;letter-spacing:0;">⚠ <%= err %></p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
