<%# app/views/properties/_simple_aids.html.erb
     Bloc Aides simplifié : une ligne par aide, montant selon profil revenus sélectionné.

     Particularité : Grand Nancy Rénovation Globale est rendue EN DOUBLE :
       - ligne active dans la liste des subventions (affichée si cible = A ou B)
       - bloc potentiel grisé sous le total (affiché sinon)
     Le JS (recalcAidesProportionnel) bascule entre les deux selon la cible DPE
     courante du slider, et met à jour le total en conséquence.

     Locals attendus :
       - property : la Property
       - aid_result : retour de AidCalculatorService
-%>

<% profil_actuel = property.income_bracket.to_s.presence || "superieur" %>
<% profils = [
  { key: "tres_modeste",  label: "Très modestes", sublabel: "< 21 k€" },
  { key: "modeste",       label: "Modestes",      sublabel: "21–30 k€" },
  { key: "intermediaire", label: "Intermédiaires", sublabel: "30–45 k€" },
  { key: "superieur",     label: "Supérieurs",    sublabel: "> 45 k€" }
] %>

<%# Extraction explicite des aides connues %>
<% subventions  = (aid_result && aid_result[:subventions])        || [] %>
<% potentielles = (aid_result && aid_result[:aides_potentielles]) || [] %>

<% gn_slug      = "grand_nancy_renovation_globale" %>
<% mpr_aid      = subventions.find { |a| a[:type] == "mpr" } %>
<% cee_aid      = subventions.find { |a| a[:type] == "cee" } %>
<% gn_aid       = subventions.find { |a| a[:slug] == gn_slug } || potentielles.find { |a| a[:slug] == gn_slug } %>
<% gn_active_now = subventions.any? { |a| a[:slug] == gn_slug } %>
<% other_potentielles = potentielles.reject { |a| a[:slug] == gn_slug } %>

<%# Total initial : MPR + CEE + (GN si active) — aligné sur le serveur %>
<% total_initial = [mpr_aid, cee_aid, (gn_active_now ? gn_aid : nil)].compact.sum { |a| a[:amount].to_i } %>

<div class="cd">
  <div class="cd-hd" style="background:#5b21b6;display:flex;align-items:center;justify-content:space-between;gap:10px;">
    <span>💶 Aides auxquelles vous avez droit</span>
    <span id="aides-stale-badge" style="display:none;background:#fbbf24;color:#78350f;font-size:.62rem;font-weight:800;padding:3px 8px;border-radius:10px;text-transform:none;letter-spacing:0;">
      À recalculer — cliquez "Mettre à jour les aides"
    </span>
  </div>

  <div style="padding:20px;">
    <%# Sélecteur de profil revenus : persiste en DB via update_income_bracket %>
    <p class="lbl" style="margin-bottom:8px;">Revenus annuels de votre foyer fiscal</p>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:20px;">
      <% profils.each do |p| %>
        <% actif = profil_actuel == p[:key] %>
        <%= button_to update_income_bracket_property_path(property),
              method: :patch,
              params: { income_bracket: p[:key] },
              form: { style: "margin:0;", data: { turbo: false } },
              style: "padding:10px 6px;border-radius:10px;border:2px solid #{actif ? '#5b21b6' : '#e5e7eb'};background:#{actif ? '#faf5ff' : '#fff'};color:#{actif ? '#5b21b6' : '#374151'};font-weight:700;font-size:.78rem;cursor:pointer;text-align:center;width:100%;line-height:1.2;" do %>
          <%= p[:label] %><br><span style="font-size:.7rem;font-weight:500;opacity:.75;"><%= p[:sublabel] %></span>
        <% end %>
      <% end %>
    </div>

    <% if mpr_aid || cee_aid || gn_aid %>
      <%# Ligne MPR %>
      <% if mpr_aid %>
        <div style="display:flex;justify-content:space-between;align-items:baseline;padding:11px 0;border-bottom:1px solid #f3f4f6;gap:12px;">
          <div style="flex:1;">
            <p class="bod" style="font-weight:600;">🏛️ <%= mpr_aid[:name].split("—").first.strip %></p>
          </div>
          <p class="bod" style="font-weight:800;white-space:nowrap;font-size:1rem;" id="aide-mpr-val">
            <%= number_to_currency(mpr_aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
          </p>
        </div>
      <% end %>

      <%# Ligne CEE %>
      <% if cee_aid %>
        <div style="display:flex;justify-content:space-between;align-items:baseline;padding:11px 0;border-bottom:1px solid #f3f4f6;gap:12px;">
          <div style="flex:1;">
            <p class="bod" style="font-weight:600;">🔋 <%= cee_aid[:name].split("—").first.strip %></p>
          </div>
          <p class="bod" style="font-weight:800;white-space:nowrap;font-size:1rem;" id="aide-cee-val">
            <%= number_to_currency(cee_aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
          </p>
        </div>
      <% end %>

      <%# Ligne Grand Nancy — version ACTIVE (affichée si cible DPE = A ou B).
           Le JS bascule son display en fonction du slider. -%>
      <% if gn_aid %>
        <div id="gn-active-row"
             style="display:<%= gn_active_now ? 'flex' : 'none' %>;justify-content:space-between;align-items:baseline;padding:11px 0;border-bottom:1px solid #f3f4f6;gap:12px;">
          <div style="flex:1;">
            <p class="bod" style="font-weight:600;">🏛️ <%= gn_aid[:name].split("—").first.strip %></p>
            <p class="lbl" style="margin-top:2px;font-size:.66rem;">Complémentaire à MaPrimeRénov'</p>
          </div>
          <p class="bod" style="font-weight:800;white-space:nowrap;font-size:1rem;" id="aide-gn-val">
            <%= number_to_currency(gn_aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
          </p>
        </div>
      <% end %>

      <%# Total des aides — mis à jour en temps réel par le JS %>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px;background:#ede9fe;border-radius:12px;margin-top:14px;">
        <p class="bod" style="font-weight:700;color:#5b21b6;">💰 Total des aides</p>
        <p style="font-size:1.25rem;font-weight:900;color:#5b21b6;white-space:nowrap;" id="aide-total-val">
          <%= number_to_currency(total_initial, unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
        </p>
      </div>

      <%# Bloc Grand Nancy — version POTENTIELLE (affichée si cible DPE ≠ A/B).
           Le JS bascule son display en fonction du slider. -%>
      <% if gn_aid %>
        <div id="gn-potential-block" style="display:<%= gn_active_now ? 'none' : 'block' %>;margin-top:18px;">
          <p class="lbl" style="margin-bottom:6px;color:#9ca3af;">Aides disponibles sous condition</p>
          <div style="padding:10px 12px;background:#f9fafb;border:1px dashed #d1d5db;border-radius:10px;margin-bottom:6px;opacity:0.75;">
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;">
              <p class="bod" style="font-weight:600;color:#6b7280;font-size:.85rem;">
                🏛️ <%= gn_aid[:name].split("—").first.strip %>
              </p>
              <p class="bod" style="font-weight:700;color:#6b7280;white-space:nowrap;font-size:.9rem;" id="aide-gn-pot-val">
                <%= number_to_currency(gn_aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
              </p>
            </div>
            <p class="lbl" style="margin-top:4px;color:#9ca3af;text-transform:none;letter-spacing:0;font-weight:500;font-size:.72rem;line-height:1.4;">
              💡 Débloquée si vous visez un DPE A ou B. Glissez la jauge dans la card Rénovation pour l'activer.
            </p>
          </div>
        </div>
      <% end %>

      <%# Autres aides potentielles (hors Grand Nancy) %>
      <% if other_potentielles.any? %>
        <p class="lbl" style="margin-top:18px;margin-bottom:6px;color:#9ca3af;">Aides disponibles sous condition</p>
        <% other_potentielles.each do |aid| %>
          <div style="padding:10px 12px;background:#f9fafb;border:1px dashed #d1d5db;border-radius:10px;margin-bottom:6px;opacity:0.75;">
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;">
              <p class="bod" style="font-weight:600;color:#6b7280;font-size:.85rem;">
                🏛️ <%= aid[:name].split("—").first.strip %>
              </p>
              <p class="bod" style="font-weight:700;color:#6b7280;white-space:nowrap;font-size:.9rem;">
                <%= number_to_currency(aid[:amount], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %>
              </p>
            </div>
            <p class="lbl" style="margin-top:4px;color:#9ca3af;text-transform:none;letter-spacing:0;font-weight:500;font-size:.72rem;line-height:1.4;">
              💡 <%= aid[:note] || aid[:basis] %>
            </p>
          </div>
        <% end %>
      <% end %>

      <%# Prérequis France Rénov' %>
      <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:12px 14px;margin-top:14px;display:flex;gap:10px;align-items:flex-start;">
        <span style="font-size:1rem;flex-shrink:0;">ℹ️</span>
        <p class="bod" style="font-size:.8rem;color:#78350f;line-height:1.5;">
          <strong>Avant de démarrer les travaux</strong>, contactez un conseiller
          <a href="https://france-renov.gouv.fr" target="_blank" rel="noopener" style="color:#b45309;font-weight:700;text-decoration:underline;">France Rénov'</a>
          pour activer vos aides. Sans cette étape, les dossiers MaPrimeRénov' et Grand Nancy ne sont pas recevables.
        </p>
      </div>

    <% else %>
      <p class="bod" style="color:#9ca3af;font-style:italic;">Aucune aide calculable — vérifiez que l'analyse IA a bien été lancée.</p>
    <% end %>

    <%# Errors / warnings du calculateur, si existants %>
    <% if aid_result && aid_result[:errors]&.any? %>
      <div style="margin-top:10px;">
        <% aid_result[:errors].each do |err| %>
          <p class="lbl" style="color:#b45309;margin-bottom:4px;font-size:.7rem;text-transform:none;letter-spacing:0;">⚠ <%= err %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
