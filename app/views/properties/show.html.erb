<%# show.html.erb — vue unifiée propriétaire + prestataire %>

<% parsed    = @property.analysis&.content.present? ? (JSON.parse(@property.analysis.content) rescue nil) : nil %>
<% v         = parsed&.[]("valeur") %>
<% e         = parsed&.[]("energie") %>
<% i_        = parsed&.[]("idees") %>
<%# Deux notions distinctes :
     - is_owner_connecte : possède le compte ET le bien. Seul autorisé à
       *agir* (publier, modifier, supprimer, gérer les documents).
     - can_see_full_dossier : *voit* le dossier complet (jauge interactive,
       aides, financement, valeur estimée). Vrai si propriétaire connecté
       OU détenteur en cookie signé du claim_token du bien (parcours
       d'estimation anonyme). Le calcul correspondant côté serveur
       (@aid_result) est élargi de la même façon dans PropertiesController#show. %>
<% is_owner_connecte    = user_signed_in? && current_user == @property.user %>
<% can_see_full_dossier = is_owner_connecte || claimable_by_browser?(@property) %>

<% dpe_all    = %w[A B C D E F G] %>
<% dpe_colors = {"A"=>"#16a34a","B"=>"#4ade80","C"=>"#a3e635","D"=>"#ca8a04","E"=>"#fb923c","F"=>"#ef4444","G"=>"#991b1b"} %>
<% dpe_labels = {"A"=>"Très performant","B"=>"Performant","C"=>"Assez performant","D"=>"Peu performant","E"=>"Énergivore","F"=>"Très énergivore","G"=>"Passoire thermique"} %>
<% dpe_cur    = (@property.dpe_class || e&.[]("dpe_estime"))&.upcase %>
<% dpe_cib    = (e&.[]("dpe_cible"))&.upcase %>
<% travaux_claude = (e&.[]("travaux") || []).sort_by{|t| t["priorite"].to_i} %>
<% cur_idx    = dpe_all.index(dpe_cur) || 5 %>

<%# ── Travaux actifs : travaux_selection jsonb sur Property (7 macro-postes) ─
     On regroupe les travaux Claude par code canonique et on garde le plus
     représentatif pour l'affichage (prix médian, libellé). -%>
<% travaux_groupes = {} %>
<% travaux_claude.each do |t|
     code = TravauxMapperService.code_for_poste(t["poste"])
     next unless code
     travaux_groupes[code] ||= { poste: t["poste"], cout_min: 0, cout_max: 0 }
     travaux_groupes[code][:cout_min] += t["cout_min"].to_i
     travaux_groupes[code][:cout_max] += t["cout_max"].to_i
   end %>

<%# Travaux cochés (ordre canonique) pour calculs de budget et DPE cible %>
<% travaux_actifs = can_see_full_dossier ? @property.travaux_actifs : TravauxMapperService::CANONICAL_CODES %>

<%# ── Aides : valeurs issues d'AidCalculatorService (source unique de vérité) ─ %>
<% mpr_entry   = (@aid_result && @aid_result[:subventions]&.find { |s| s[:type] == "mpr" }) %>
<% mpr_montant = mpr_entry ? mpr_entry[:amount].to_i : 0 %>
<% mpr_taux    = AidCalculatorService::MPR_TAUX_2026[@property.income_bracket.to_s] || 0 %>

<%# CEE et Grand Nancy : détectés explicitement pour permettre le rendu dual
     (Grand Nancy active OU potentielle selon la cible DPE courante). %>
<% cee_entry   = (@aid_result && @aid_result[:subventions]&.find { |s| s[:type] == "cee" }) %>
<% cee_montant = cee_entry ? cee_entry[:amount].to_i : 0 %>

<% gn_slug = "grand_nancy_renovation_globale" %>
<% gn_in_actives = @aid_result && @aid_result[:subventions]&.find { |s| s[:slug] == gn_slug } %>
<% gn_in_potentielles = @aid_result && @aid_result[:aides_potentielles]&.find { |s| s[:slug] == gn_slug } %>
<% gn_entry     = gn_in_actives || gn_in_potentielles %>
<% gn_montant   = gn_entry ? gn_entry[:amount].to_i : 0 %>
<% gn_active_now = gn_in_actives.present? %>

<%# ── Budget : somme des médianes des travaux actifs uniquement ─ %>
<% budget_mediane = travaux_groupes.sum do |code, grp|
     travaux_actifs.include?(code) ? ((grp[:cout_min] + grp[:cout_max]) / 2.0).round(-2).to_i : 0
   end %>
<% budget_max_brut = travaux_claude.sum{|t| t["cout_max"].to_i} %>
<% budget_min_brut = travaux_claude.sum{|t| t["cout_min"].to_i} %>

<%# ── Matrice DPE pré-calculée (PropertyDpeMatrixService) ───────────────────
     Désormais calculée dans PropertiesController#show (cf. @dpe_matrix) pour
     que AidCalculatorService puisse aligner sa cible DPE sur la classe
     atteignable réelle (override dpe_target_override) plutôt que sur le
     forfait DB @property.dpe_target. La vue se contente de relire l'ivar :
     même valeur, une seule instanciation par requête (~80 ms économisés),
     et garantie d'alignement entre les aides calculées et la jauge.
     Quand le bloc Aides n'est pas rendu (visiteur sans claim), le
     controller n'instancie pas la matrice → @dpe_matrix reste nil ici,
     ce qui active le cas dégradé γ plus bas (jauge désactivée). -%>
<% dpe_matrix = @dpe_matrix %>

<%# ── DPE cible estimé via la matrice serveur (Temps 3b-2 commit 3) ────────
     `tgt_idx_estime` est la classe atteignable calculée par le moteur 3CL
     pour la combinaison de gestes déjà cochés en DB. Clé de combinaison :
     `travaux_actifs.sort.join(",")` — format exact produit par
     PropertyDpeMatrixService#calculer_combinaisons (l. 116).

     CAS DÉGRADÉ (décision γ du diagnostic 3b-2) : si la matrice n'est pas
     calculable (surface ou année manquante, ou utilisateur non autorisé),
     `tgt_idx_estime` vaut `cur_idx` (pas d'estimation, pas de saut). La
     jauge interactive sera désactivée avec un message d'invite (cf. zone
     « jauge interactive » plus bas, condition `unless dpe_matrix`). Aucun
     calcul forfaitaire de repli — la jauge ne calcule pas plutôt que de
     calculer faux. -%>
<% tgt_idx_estime = if dpe_matrix
                       cle_combi = travaux_actifs.sort.join(",")
                       classe_estimee = dpe_matrix.dig(:combinaisons, cle_combi, :classe)
                       classe_estimee ? dpe_all.index(classe_estimee) : cur_idx
                     else
                       cur_idx
                     end %>
<%# ── tgt_idx : init cohérente cases↔curseur ────────────────────────────
     Le curseur de la jauge se cale TOUJOURS sur la classe atteignable
     calculée par la matrice pour la combinaison de gestes cochés. Plus
     aucune lecture de `dpe_cib` (analyse Claude) ni de `@property.dpe_target`
     (colonne DB) à l'init du curseur : ces deux sources étaient des suggestions
     forfaitaires qui pouvaient diverger de la réalité thermique du bien
     (symptôme : curseur sur C alors que les 5 cases cochées menaient à A).
     `tgt_idx_estime` intègre déjà le cas dégradé γ (matrice absente → cur_idx). -%>
<% tgt_idx = tgt_idx_estime %>
<% sauts   = cur_idx - tgt_idx %>

<%# Aides totales : source = AidCalculatorService %>
<% total_aides = @aid_result ? @aid_result[:total_subventions].to_i : 0 %>

<%# Reste à financer = budget affiché (médiane, travaux cochés) - aides réelles %>
<% reste = [budget_mediane - total_aides, 0].max %>

<%# Décomposition Éco-PTZ vs prêt bancaire %>
<% ptz_entry   = @aid_result && @aid_result[:financement]&.find { |f| f[:type] == "eco_ptz" } %>
<% ptz_plafond = ptz_entry ? ptz_entry[:amount].to_i : 30_000 %>
<% ptz_utilise = [reste, ptz_plafond].min %>
<% reste_banque = [reste - ptz_utilise, 0].max %>

<style>
  .sh  { max-width:600px; margin:0 auto; padding:20px 14px 60px; }
  .lbl { font-size:.68rem; font-weight:700; color:#9ca3af;
         text-transform:uppercase; letter-spacing:.07em; }
  .bod { font-size:.88rem; color:#374151; line-height:1.6; }
  .big { font-size:1.6rem; font-weight:900; color:#111; line-height:1; }
  .cd  { background:#fff; border-radius:18px; border:1px solid #e5e7eb;
         box-shadow:0 2px 14px rgba(0,0,0,.07); margin-bottom:24px; overflow:hidden; scroll-margin-top:80px; }
  #aides, #financement, #travaux { scroll-margin-top: 80px; }
  .cd-hd { padding:13px 20px; font-size:.75rem; font-weight:800;
            text-transform:uppercase; letter-spacing:.09em; color:#fff; }
  .row { display:flex; justify-content:space-between; align-items:baseline;
         gap:12px; padding:11px 0; border-bottom:1px solid #f3f4f6; }
  .row:last-child { border-bottom:none; }
  .row p:last-child { white-space:nowrap; flex-shrink:0; }
  .dpe-track { position:relative; height:48px; display:flex; border-radius:24px; overflow:hidden; }
  .dpe-seg   { flex:1; display:flex; align-items:center; justify-content:center;
               font-size:.85rem; font-weight:900; color:rgba(255,255,255,.75); }
  .pin       { position:absolute; top:50%; transform:translate(-50%,-50%);
               pointer-events:none; transition:left .3s cubic-bezier(.4,0,.2,1); z-index:5; }
  #pin-tgt   { z-index:6; }
  .pin-dot   { width:32px; height:32px; border-radius:50%; display:flex; align-items:center;
               justify-content:center; font-size:.85rem; font-weight:900; color:#fff;
               border:3px solid #fff; box-shadow:0 2px 8px rgba(0,0,0,.25); }
  @keyframes pulse-pin {
    0%,100% { transform:scale(1); }
    50%     { transform:scale(1.2); box-shadow:0 0 0 6px rgba(5,150,105,.15); }
  }
  #pin-tgt-dot { animation: pulse-pin 1.8s ease-in-out infinite; }

  .travail-check { display:flex; align-items:center; gap:10px; padding:10px 12px;
                   background:#f9fafb; border-radius:10px; margin-bottom:6px;
                   cursor:pointer; transition:background .15s, opacity .2s; }
  .travail-check:hover { background:#f3f4f6; }
  .travail-check input[type=checkbox] { width:18px; height:18px; accent-color:#059669;
                                         cursor:pointer; flex-shrink:0; margin:0; }
  .travail-check.off { opacity:0.5; }
  .travail-check.off .travail-label { text-decoration:line-through; color:#9ca3af; }
</style>

<div class="sh">

<%= render "analysis_status", property: @property %>

<%# ── Adresse : tri-état exclusif quand @property.address est vide ─────
     ÉTAT 1 : analyzing → note douce "Nous recherchons l'adresse…". Pas
              de bandeau d'échec ni de formulaire (l'extraction tourne).
     ÉTAT 2 : analyse finie + address_detected présent → bandeau
              confirmation (source affichée, valeurs pré-remplies).
     ÉTAT 3 : analyse finie + address_detected vide → bandeau saisie
              manuelle avec formulaire.
     Dans les états 2 et 3, un seul endpoint : confirm_address_property_path
     (pose address_confirmed_at, relance geocoding + LocalAidCalculator).
     Réservé au propriétaire / claimant — un visiteur random est déjà
     exclu par la validation address_confirmed_when_published (C2). %>

<%# État 1 — En cours d'analyse : note neutre, pas de formulaire.
     Le polling controller (cf. _analysis_status) reload la page dès
     que le status quitte "analyzing", et cette note est remplacée par
     le bon bandeau (état 2 ou 3) au reload. -%>
<% if can_see_full_dossier && @property.address.blank? && @property.analyzing? %>
  <div id="address-analyzing-note"
       style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;gap:10px;">
    <span style="font-size:1.1rem;line-height:1;">🔍</span>
    <p style="font-size:.85rem;color:#1e40af;margin:0;line-height:1.4;">
      Nous recherchons l'adresse dans vos documents… vous pourrez la confirmer dès la fin de l'analyse.
    </p>
  </div>
<% end %>

<%# États 2 et 3 — Analyse terminée, address toujours vide → confirmation.
     `unless analyzing?` verrouille : pendant l'extraction, address_detected
     est nil par nature (le job n'a pas tourné) et cette branche
     déclencherait à tort le libellé "Nous n'avons pas pu déduire". -%>
<% if can_see_full_dossier && @property.address.blank? && !@property.analyzing? %>
  <% detected = @property.address_detected.present? %>
  <div class="cd" id="confirm-address" style="background:#fef3c7;border:1px solid #fbbf24;border-radius:12px;padding:20px 24px;margin-bottom:16px;">
    <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:14px;">
      <span style="font-size:1.8rem;line-height:1;">📍</span>
      <div>
        <% if detected %>
          <h2 style="font-size:1.05rem;font-weight:800;color:#92400e;margin:0 0 4px;">
            Nous avons détecté cette adresse dans vos documents
          </h2>
          <p style="font-size:.88rem;color:#78350f;margin:0;line-height:1.4;">
            Source : <strong><%= t_address_source(@property.address_source) %></strong>.
            Vérifiez et corrigez si besoin — vos aides locales seront recalculées après confirmation.
          </p>
        <% else %>
          <h2 style="font-size:1.05rem;font-weight:800;color:#92400e;margin:0 0 4px;">
            Renseignez l'adresse du bien
          </h2>
          <p style="font-size:.88rem;color:#78350f;margin:0;line-height:1.4;">
            Nous n'avons pas pu déduire l'adresse de vos documents. Merci de la saisir manuellement — sans elle nous ne pouvons pas calculer vos aides locales.
          </p>
        <% end %>
      </div>
    </div>

    <%= form_with url: confirm_address_property_path(@property), method: :post, data: { turbo: false } do |f| %>
      <div style="display:grid;grid-template-columns:1fr;gap:10px;margin-bottom:12px;">
        <input type="text" name="property[address]" placeholder="Numéro et rue"
               value="<%= @property.address_detected %>"
               style="width:100%;padding:11px 14px;border:1px solid #d97706;border-radius:8px;font-size:.95rem;background:white;" required>
        <div style="display:grid;grid-template-columns:120px 1fr;gap:10px;">
          <input type="text" name="property[zipcode]" placeholder="54000" maxlength="5" pattern="\d{5}"
                 value="<%= @property.zipcode_detected %>"
                 style="width:100%;padding:11px 14px;border:1px solid #d97706;border-radius:8px;font-size:.95rem;background:white;" required>
          <input type="text" name="property[city]" placeholder="Ville"
                 value="<%= @property.city_detected %>"
                 style="width:100%;padding:11px 14px;border:1px solid #d97706;border-radius:8px;font-size:.95rem;background:white;" required>
        </div>
      </div>
      <button type="submit"
              style="background:#d97706;color:white;font-weight:700;padding:11px 22px;border-radius:8px;border:none;cursor:pointer;font-size:.95rem;">
        <%= detected ? "Confirmer cette adresse" : "Enregistrer l'adresse" %>
      </button>
    <% end %>
  </div>
<% end %>

<%# ── HEADER avec photo ────────────────────────────────────── %>
<div class="cd">
  <% photo_url = @property.property_type == "maison" ?
       "https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=800&q=80" :
       "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=800&q=80" %>
  <div style="position:relative;height:180px;overflow:hidden;">
    <img src="<%= photo_url %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block;">
    <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(15,23,42,.85) 0%,rgba(15,23,42,.2) 60%,transparent 100%);"></div>
    <div style="position:absolute;bottom:0;left:0;right:0;padding:16px 20px;display:flex;align-items:flex-end;justify-content:space-between;gap:10px;">
      <div>
        <p class="lbl" style="color:rgba(255,255,255,.5);margin:0 0 2px;"><%= @property.city %></p>
        <h1 style="font-size:1.25rem;font-weight:900;color:#fff;margin:0 0 4px;line-height:1.2;"><%= @property.address %></h1>
        <p style="font-size:.92rem;font-weight:600;color:rgba(255,255,255,.85);">
          <%= @property.property_type&.capitalize %>
          <% if @property.nb_rooms %> · T<%= @property.nb_rooms %><% end %>
          · <%= @property.surface %> m²
          <% if @property.construction_year %> · <%= @property.construction_year %><% end %>
        </p>
      </div>
      <% if dpe_cur %>
        <div style="width:48px;height:48px;border-radius:12px;background:<%= dpe_colors[dpe_cur] %>;display:flex;align-items:center;justify-content:center;font-size:1.4rem;font-weight:900;color:#fff;flex-shrink:0;"><%= dpe_cur %></div>
      <% end %>
    </div>
  </div>

  <%# Mini-map %>
  <div id="prop-map" style="height:130px;"></div>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
  function initPropMap(){
    var el=document.getElementById('prop-map');
    if(!el||el._leaflet_id)return;
    var lat=<%= @property.lat.presence || 48.6921 %>;
    var lng=<%= @property.lng.presence || 6.1844 %>;
    var ll=[lat,lng];
    var col={"A":"#16a34a","B":"#22c55e","C":"#84cc16","D":"#ca8a04","E":"#f97316","F":"#dc2626","G":"#991b1b"};
    var c=col["<%= @property.dpe_class&.upcase || 'F' %>"]||"#6b7280";
    var map=L.map(el,{zoomControl:false,dragging:false,scrollWheelZoom:false,attributionControl:false}).setView(ll,15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(map);
    var icon=L.divIcon({html:'<div style="width:28px;height:28px;border-radius:50%;background:'+c+';display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:900;color:#fff;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.3);">'+"<%= @property.dpe_class&.upcase || '?' %>"+'</div>',className:'',iconSize:[28,28],iconAnchor:[14,14]});
    L.marker(ll,{icon:icon}).addTo(map);
  }
  document.addEventListener('turbo:load',initPropMap);
  document.addEventListener('DOMContentLoaded',initPropMap);
  </script>

  <%# Boutons selon profil — actions qui MUTENT le bien : réservées au
       propriétaire connecté. Un claimant anonyme ne doit jamais voir
       Publier ni Modifier (il devra s'inscrire pour récupérer son bien). %>
  <div style="padding:10px 16px;display:flex;gap:8px;flex-wrap:wrap;">
    <% if is_owner_connecte %>
      <%= link_to "Modifier", edit_property_path(@property), style:"font-size:.78rem;font-weight:600;padding:7px 12px;border-radius:8px;border:1px solid #e5e7eb;color:#374151;text-decoration:none;" %>
      <% if @property.draft? || @property.analyzed? %>
        <%= button_to "Lancer l'analyse →", analyze_property_path(@property), style:"font-size:.78rem;font-weight:700;padding:7px 12px;border-radius:8px;background:#1d4ed8;color:#fff;border:none;cursor:pointer;" %>
      <% end %>
      <% if @property.analyzed? %>
        <%= link_to "Publier →", preview_property_path(@property), style:"font-size:.78rem;font-weight:700;padding:7px 12px;border-radius:8px;background:#059669;color:#fff;text-decoration:none;" %>
      <% end %>
    <% else %>
      <%= link_to "← Retour à la carte", root_path, style:"font-size:.78rem;font-weight:600;padding:7px 12px;border-radius:8px;border:1px solid #e5e7eb;color:#374151;text-decoration:none;" %>
    <% end %>
  </div>
</div>

<%# ── VALEUR (dossier complet : propriétaire ou claimant) ────── %>
<% if v && can_see_full_dossier %>
<div class="cd">
  <div class="cd-hd" style="background:#ea580c;">🏷️ Valeur estimée</div>
  <div style="padding:20px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
      <div style="background:#f9fafb;border-radius:12px;padding:14px;text-align:center;">
        <p class="lbl" style="margin-bottom:5px;">Estimation basse</p>
        <p class="big"><%= number_to_currency(v["estimation_basse"], unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
      </div>
      <div style="background:#f9fafb;border-radius:12px;padding:14px;text-align:center;">
        <p class="lbl" style="margin-bottom:5px;">Estimation haute</p>
        <p class="big"><%= number_to_currency(v["estimation_haute"], unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
      </div>
    </div>
    <% if v["prix_acquisition"].present? %>
      <div class="row" style="padding:8px 0;">
        <p class="bod" style="color:#6b7280;">Prix d'achat</p>
        <p class="bod" style="font-weight:700;color:#6b7280;"><%= number_to_currency(v["prix_acquisition"], unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<%# ── RÉNOVATION ÉNERGÉTIQUE ──────────────────────────────── %>
<% if dpe_cur %>
<div class="cd" id="travaux">
  <div class="cd-hd" style="background:#059669;">⚡ Rénovation énergétique</div>
  <div style="padding:20px;">

    <% if %w[F G].include?(dpe_cur) %>
      <p class="bod" style="color:#dc2626;font-size:.82rem;margin-bottom:14px;">🚫 Ce logement ne peut plus être mis en location depuis le 1er janvier 2023.</p>
    <% elsif dpe_cur == "E" %>
      <p class="bod" style="color:#ea580c;font-size:.82rem;margin-bottom:14px;">⚠️ Interdiction de louer en 2028.</p>
    <% end %>

    <%# Jauge DPE : statique pour le visiteur artisan, interactive pour
         qui détient le dossier (propriétaire connecté ou claimant en cookie). %>
    <% if !can_see_full_dossier %>
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:20px;">
        <div style="text-align:center;">
          <div style="width:44px;height:44px;border-radius:10px;background:<%= dpe_colors[dpe_cur] %>;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:900;color:#fff;"><%= dpe_cur %></div>
          <p class="lbl" style="margin-top:4px;font-size:.6rem;">Actuel</p>
        </div>
        <% if dpe_cib && dpe_cib != dpe_cur %>
          <p style="font-size:1.3rem;color:#d1d5db;">→</p>
          <div style="text-align:center;">
            <div style="width:44px;height:44px;border-radius:10px;background:<%= dpe_colors[dpe_cib] || '#059669' %>;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:900;color:#fff;border:2px solid #059669;"><%= dpe_cib %></div>
            <p class="lbl" style="margin-top:4px;font-size:.6rem;color:#059669;">Objectif</p>
          </div>
        <% end %>
        <div style="flex:1;padding-left:4px;">
          <p class="bod" style="font-weight:700;"><%= dpe_labels[dpe_cur] %></p>
        </div>
      </div>

    <% else %>
      <%# Dossier complet (propriétaire OU claimant) : jauge interactive +
           slider caché qui écoute les changements. Glisser la jauge coche
           automatiquement les travaux atteignant la cible (cascade par
           priorité réelle calculée serveur sur le moteur 3CL).
           Décocher des travaux remonte la jauge estimée.

           CAS DÉGRADÉ (décision γ du diagnostic 3b-2) : si la matrice DPE
           n'est pas calculable (surface ou année manquante), la jauge est
           désactivée et un message d'invite est affiché. Aucun calcul
           forfaitaire de repli — la jauge ne calcule pas plutôt que de
           calculer faux. %>
      <%# Message d'invite dynamique : ne cite QUE les champs réellement
           manquants. Source de vérité unique = @property.surface /
           @property.construction_year — les mêmes colonnes que celles lues
           par l'en-tête (cf. haut de la vue) et par le controller pour
           décider d'instancier @dpe_matrix. Aucun autre attribut n'entre
           en compte : pas de « champ dérivé » qui divergerait. %>
      <% unless dpe_matrix %>
        <% champs_manquants = [] %>
        <% champs_manquants << "la surface habitable"    if @property.surface.blank? %>
        <% champs_manquants << "l'année de construction" if @property.construction_year.blank? %>
        <div style="background:#fef3c7;border:1px solid #fbbf24;border-radius:8px;padding:10px 14px;margin-bottom:12px;">
          <p class="bod" style="color:#92400e;font-weight:600;font-size:.78rem;line-height:1.4;">
            ⚠️ Complétez votre dossier (<%= champs_manquants.to_sentence(two_words_connector: " et ", last_word_connector: " et ") %>) pour estimer les classes atteignables.
          </p>
        </div>
      <% end %>
      <%# La classe DPE actuelle (dpe_cur) est communiquée par DEUX signaux
           complémentaires, sans pin rond dédié :
             1. le marqueur textuel « ▼ actuel » au-dessus du segment,
             2. le segment coloré à opacité pleine (0.4 pour les autres).
           Le pin rond reste RÉSERVÉ à l'objectif (pin-tgt) — ça évite le
           doublon visuel entre marqueur + pin qui pointaient le même
           segment. La partie projection (pin cible, label objectif,
           slider) reste conditionnée à la disponibilité de dpe_matrix.
           Centrage robuste : `.pin` utilise transform:translate(-50%,-50%),
           donc `left` = centre du segment sans avoir à connaître la
           largeur du pin (indépendant de box-sizing). %>
      <div style="position:relative;margin-bottom:6px;">
        <div style="display:flex;margin-bottom:4px;">
          <% dpe_all.each do |l| %>
            <div style="flex:1;text-align:center;">
              <% if l == dpe_cur %><span style="font-size:.6rem;font-weight:800;color:#ea580c;">▼ actuel</span><% end %>
            </div>
          <% end %>
        </div>
        <div class="dpe-track" id="dpe-track">
          <% dpe_all.each do |l| %>
            <div class="dpe-seg" style="background:<%= dpe_colors[l] %>;opacity:<%= l == dpe_cur ? '1' : '0.4' %>;"><%= l %></div>
          <% end %>
        </div>
        <% if dpe_matrix %>
          <div class="pin" id="pin-tgt" style="left:calc(<%= tgt_idx %>/7*100% + 1/14*100%);">
            <div class="pin-dot" style="background:<%= dpe_colors[dpe_all[tgt_idx]] || '#059669' %>;border-color:#059669;box-shadow:0 0 0 3px rgba(5,150,105,.3);" id="pin-tgt-dot"><%= dpe_all[tgt_idx] %></div>
          </div>
          <%# Slider HTML posé par-dessus la track A→G (7 segments).
               max=6 pour que chaque segment visuel corresponde à une position
               atteignable. Le clamp à cur_idx-1 (on ne peut pas cibler un DPE
               pire ou égal au DPE actuel) est fait en JS dans onSliderChange.
               Non rendu quand la matrice est absente : rien à projeter,
               donc pas de contrôle interactif. %>
          <input type="range" id="dpe-slider"
                 min="0" max="6" step="1"
                 value="<%= tgt_idx %>"
                 style="position:absolute;top:0;left:0;width:100%;height:48px;opacity:0;cursor:grab;margin:0;z-index:10;"
                 oninput="onSliderChange(this.value)">
        <% end %>
      </div>
      <% if dpe_matrix %>
        <p class="lbl" id="dpe-estim-lbl" style="text-align:center;margin-bottom:6px;color:#059669;font-size:.66rem;">
          Objectif : <span id="dpe-estim-val"><%= dpe_all[tgt_idx] %></span> · estimation indicative · glissez la jauge : les travaux s'ajustent à la cible
        </p>
        <%# Microtexte de recalage — masqué par défaut, révélé par
             onSliderChange quand la sémantique "au moins X" a recalé
             vers une classe MEILLEURE (et moins chère) que celle cliquée.
             Principe projet : jamais de recalage silencieux. -%>
        <p id="dpe-recale-note"
           style="display:none;text-align:center;margin:0 0 14px;color:#065f46;font-size:.72rem;font-weight:600;background:#d1fae5;border-radius:8px;padding:6px 12px;">
        </p>
      <% end %>
    <% end %>

    <%# ── Formulaire checkboxes de travaux (dossier complet) ──
         Affiché aussi au claimant : la simulation côté client (DOM/JS) tourne
         sans persistance. Le submit "Mettre à jour les aides" est protégé en
         amont par authenticate_user! sur update_travaux_selection — un anonyme
         sera redirigé vers la page d'inscription/connexion, ce qui fait office
         de CTA naturel pour rattacher l'orpheline. %>
    <% if can_see_full_dossier && travaux_groupes.any? %>
      <%= form_with model: @property,
                    url: update_travaux_selection_property_path(@property),
                    method: :patch,
                    local: true,
                    html: { id: "form-travaux", autocomplete: "off" } do |f| %>

        <%# Hidden field qui porte la cible DPE courante (positionnée par le slider).
             Mis à jour en JS à chaque changement du slider et des checkboxes, pour
             que le controller persiste aussi dpe_target et que Grand Nancy
             rénovation globale bascule en "active" si cible A/B.
             Init aligné sur `tgt_idx` (= classe matrice des cases cochées) : un
             submit "no-interaction" persiste donc une cible cohérente avec ce
             que l'utilisateur voit, pas une valeur DB héritée d'une suggestion
             forfaitaire antérieure. -%>
        <%= hidden_field_tag "property[dpe_target]", dpe_all[tgt_idx], id: "form-dpe-target" %>

        <%# Titre d'invitation explicite + actions rapides %>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;padding:10px 14px;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:10px;">
          <p class="bod" style="font-weight:700;color:#065f46;font-size:.88rem;">
            ☑️ Cochez les travaux que vous envisagez
          </p>
          <div style="display:flex;gap:6px;flex-shrink:0;">
            <button type="button" onclick="toggleAllTravaux(true)"
                    style="font-size:.7rem;font-weight:600;padding:5px 9px;border-radius:7px;background:#fff;color:#065f46;border:1px solid #a7f3d0;cursor:pointer;">
              Tout cocher
            </button>
            <button type="button" onclick="toggleAllTravaux(false)"
                    style="font-size:.7rem;font-weight:600;padding:5px 9px;border-radius:7px;background:#fff;color:#065f46;border:1px solid #a7f3d0;cursor:pointer;">
              Tout décocher
            </button>
          </div>
        </div>

        <% TravauxMapperService::CANONICAL_CODES.each do |code| %>
          <% next unless travaux_groupes[code] %>
          <% grp = travaux_groupes[code] %>
          <% mediane = ((grp[:cout_min] + grp[:cout_max]) / 2.0).round(-2).to_i %>
          <% coche = travaux_actifs.include?(code) %>
          <label class="travail-check <%= 'off' unless coche %>" data-code="<%= code %>" data-mediane="<%= mediane %>">
            <%= f.check_box code, { checked: coche, class: "travail-cb" }, "1", "0" %>
            <span style="font-size:1rem;flex-shrink:0;"><%= TravauxMapperService::EMOJIS[code] %></span>
            <span class="travail-label bod" style="font-weight:600;flex:1;"><%= TravauxMapperService::LABELS[code] %></span>
            <span class="bod" style="font-weight:700;white-space:nowrap;color:#374151;">
              ≈ <%= mediane.to_s.reverse.gsub(/(\d{3})(?=\d)/,'\\1 ').reverse %> €
            </span>
          </label>
        <% end %>

        <%# Budget total cohérent avec les cases cochées %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#f0fdf4;border-radius:10px;margin-top:10px;">
          <p class="lbl">Budget total estimé</p>
          <p style="font-size:1.1rem;font-weight:900;color:#065f46;" id="budget-val">
            ≈ <span id="budget-num"><%= budget_mediane.to_s.reverse.gsub(/(\d{3})(?=\d)/,'\\1 ').reverse %></span> €
          </p>
        </div>

        <%# Owner : vrai submit qui persiste la sélection et recharge la fiche
             avec @aid_result recalculé. Claimant : à la place, lien
             d'inscription — le submit serait intercepté par authenticate_user!
             et la sélection jetée au passage par sign-in (le POST n'est pas
             rejoué). Mieux vaut un CTA honnête qu'un bouton qui simule. %>
        <div style="display:flex;justify-content:flex-end;align-items:center;margin-top:12px;">
          <% if is_owner_connecte %>
            <%= f.submit "Mettre à jour les aides",
                  style:"font-size:.82rem;font-weight:700;padding:10px 16px;border-radius:8px;background:#059669;color:#fff;border:none;cursor:pointer;white-space:nowrap;" %>
          <% else %>
            <%= link_to "Créer un compte pour enregistrer mes ajustements →",
                  new_user_registration_path,
                  style:"font-size:.82rem;font-weight:700;padding:10px 16px;border-radius:8px;background:#059669;color:#fff;text-decoration:none;display:inline-block;white-space:nowrap;" %>
          <% end %>
        </div>
      <% end %>

    <% elsif travaux_claude.any? %>
      <%# Prestataire : lecture seule, pas de budget ni prix affichés %>
      <p class="lbl" style="margin-bottom:8px;">Travaux envisagés</p>
      <% travaux_claude.each do |t| %>
        <% code  = TravauxMapperService.code_for_poste(t["poste"]) %>
        <% emoji = code ? TravauxMapperService::EMOJIS[code] : "🔧" %>
        <div style="display:flex;align-items:center;gap:10px;padding:9px 12px;background:#f9fafb;border-radius:10px;margin-bottom:6px;">
          <span style="font-size:1rem;flex-shrink:0;"><%= emoji %></span>
          <p class="bod" style="font-weight:600;font-size:.88rem;flex:1;"><%= t["poste"] %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
<% end %>

<%# ── Aides locales conditionnées à la confirmation d'adresse (C6) ────
     AidCalculatorService gate Grand Nancy sur code_insee — donc sans
     confirmation, aucune aide locale ne remonte dans le résultat. Ce
     rappel est rendu DEHORS du bloc `if e` : dans le parcours
     "documents sans adresse" (C2), l'utilisateur peut atterrir sur la
     vue résultats avant la fin de l'analyse (pas encore de `e`), et
     doit voir dès ce moment le lien vers le bandeau de confirmation.
     Restreint à can_see_full_dossier pour ne pas révéler ce message à
     un visiteur random d'un bien published — de toute façon exclu par
     la validation address_confirmed_when_published (C2).
     Aussi gardé par !analyzing? : pendant l'extraction, l'ancre
     #confirm-address n'existe pas encore (état 1 du tri-état adresse),
     et pointer vers un bandeau absent serait trompeur. -%>
<% if can_see_full_dossier && @property.address.blank? && !@property.analyzing? %>
  <div class="cd" id="local-aids-locked" style="background:#faf5ff;border:2px dashed #c4b5fd;border-radius:12px;padding:14px 16px;margin-bottom:12px;">
    <p class="bod" style="margin:0;font-size:.85rem;color:#5b21b6;line-height:1.5;">
      🏛️ <strong>Vos aides locales</strong> (Grand Nancy, EPCI…)
      s'afficheront après confirmation de l'adresse — voir le
      <%= link_to "bandeau en haut de la page", "#confirm-address", style: "color:#5b21b6;text-decoration:underline;font-weight:700;" %>.
    </p>
  </div>
<% end %>

<%# ── AIDES + FINANCEMENT (dossier complet : propriétaire ou claimant) ── %>
<% if can_see_full_dossier && e %>

<div id="aides">
  <%= render "simple_aids",
             property: @property,
             aid_result: @aid_result,
             aid_projection: @aid_projection,
             dpe_target_effectif: @dpe_target_effectif,
             is_owner_connecte: is_owner_connecte %>
</div>

<div id="financement">
  <%= render "simple_financing",
             property: @property,
             aid_result: @aid_result,
             reste: reste,
             ptz_utilise: ptz_utilise,
             reste_banque: reste_banque,
             is_owner_connecte: is_owner_connecte %>
</div>

<% end %>

<%# ── AUTRES PISTES (dossier complet) ────────────────────── %>
<% if can_see_full_dossier && i_ && i_["scenarios"].present? %>
<div class="cd">
  <div class="cd-hd" style="background:#b45309;">💡 Autres pistes</div>
  <div style="padding:0 20px;">
    <% i_["scenarios"].each do |s| %>
      <% route_map = {"panneaux"=>"panneaux_solaires_path","borne"=>"borne_electrique_path","meublée"=>"location_meublee_path","combles"=>"amenagement_combles_path","extérieur"=>"espace_exterieur_path","stockage"=>"box_stockage_path"} %>
      <% guide_path = route_map.find{|k,_| s["titre"].to_s.downcase.include?(k)}&.last %>
      <div class="row" style="gap:12px;">
        <span style="font-size:1.1rem;flex-shrink:0;"><%= s["emoji"] %></span>
        <p class="bod" style="font-weight:700;font-size:.85rem;flex:1;"><%= s["titre"] %></p>
        <% if guide_path %>
          <%= link_to "En savoir plus →", send(guide_path), style:"font-size:.72rem;font-weight:700;color:#b45309;text-decoration:none;white-space:nowrap;flex-shrink:0;" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<%# ── FORMULAIRE PROPOSITION (prestataire) ──────────────────
     Affiché à qui n'est pas en train de consulter SON dossier. Le claimant
     anonyme regarde sa propre estimation : il n'a pas à voir le bloc artisan. %>
<% unless can_see_full_dossier %>
<%= render "offer_form", property: @property %>
<% end %>

<%# ── GALERIE PHOTOS ─────────────────────────────────────── %>
<% if @property.photos.attached? %>
<div class="cd">
  <div class="cd-hd" style="background:#0369a1;">📷 Photos du bien</div>
  <div style="padding:16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;">
    <% @property.photos.each do |photo| %>
      <div style="border-radius:10px;overflow:hidden;aspect-ratio:4/3;">
        <%= image_tag url_for(photo.variant(:medium)), style:"width:100%;height:100%;object-fit:cover;display:block;", loading:"lazy" %>
      </div>
    <% end %>
  </div>
  <% analysis_raw = @property.analysis&.raw_response %>
  <% photo_analysis = analysis_raw&.dig("photo_analysis") %>
  <% if photo_analysis && can_see_full_dossier %>
    <div style="padding:0 16px 16px;">
      <p class="lbl" style="margin-bottom:6px;">Analyse IA des photos</p>
      <p class="bod" style="color:#374151;"><%= photo_analysis.is_a?(Hash) ? photo_analysis["etat_general"] : photo_analysis %></p>
    </div>
  <% end %>
</div>
<% end %>

<%# ── DOCUMENTS ──────────────────
     Réservé au propriétaire CONNECTÉ : l'upload et la suppression de
     fichiers sont des écritures persistantes attribuables à un compte. Un
     claimant anonyme ne doit pas pouvoir attacher de documents tant qu'il
     n'a pas rattaché son orpheline à un User. %>
<% if is_owner_connecte %>
<div class="cd">
  <div style="background:#334155;padding:13px 20px;display:flex;align-items:center;justify-content:space-between;">
    <p style="font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#fff;">Documents (<%= @property.documents.count %>)</p>
    <%= link_to "+ Ajouter", new_property_document_path(@property), style:"font-size:.78rem;font-weight:600;color:rgba(255,255,255,.7);text-decoration:none;" %>
  </div>
  <% if @property.documents.any? %>
    <div style="padding:0 16px;">
      <% @property.documents.each do |doc| %>
        <div style="display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid #f9fafb;">
          <span style="font-size:.85rem;">📄</span>
          <p style="flex:1;font-size:.82rem;font-weight:600;color:#111;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= doc.name.presence || (doc.processed? ? doc.document_type.humanize : "Document") %></p>
          <% if doc.processed? %>
            <span style="font-size:.65rem;font-weight:700;color:#059669;">✓</span>
          <% else %>
            <span style="font-size:.65rem;font-weight:600;color:#d97706;font-style:italic;">Analyse en cours…</span>
          <% end %>
          <%= button_to "✕", property_document_path(@property, doc), method: :delete, style:"background:transparent;border:none;cursor:pointer;color:#d1d5db;font-size:.8rem;padding:4px;", data: { confirm: "Supprimer ?", turbo: false } %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div style="padding:14px 20px;"><p class="bod" style="color:#9ca3af;font-size:.82rem;">Aucun document.</p></div>
  <% end %>
</div>
<% end %>

</div>

<%# ── Matrice DPE pré-calculée serveur — source UNIQUE de la jauge ────────
     PropertyDpeMatrixService projette le moteur 3CL (DpeEngineService via
     PropertyDpeService) sur les 128 sous-ensembles des 7 gestes canoniques,
     plus un classement de priorité réel spécifique à CE bien.

     Statut Temps 3b-2 commit 3 (final) :
     - L'init server-side de tgt_idx_estime (~L66) consomme la matrice.
     - La jauge interactive (recalcTravaux + onSliderChange) consomme aussi
       la matrice via DPE_MATRIX en JS (cf. zone « État côté client » ci-dessous).
     - DPE_IMPACT supprimée du codebase entier.

     La variable `dpe_matrix` est calculée en haut de la vue (~L65) et
     réutilisée ici pour la balise JSON consommée par le JS.
     Balise présente uniquement si la matrice a pu être calculée (surface
     + année + autorisation). -%>
<% if dpe_matrix %>
  <script type="application/json" id="dpe-matrix-data"><%= raw dpe_matrix.to_json %></script>
<% end %>

<script>
// ═══ Logique pure de dérivation jauge → travaux (testée Node) ═════════════
// Inlinée depuis app/javascript/dpe_slider_logic.js. Le fichier est aussi
// utilisé tel quel par test/javascript/dpe_slider_logic_test.rb via Node CLI
// (cf. guard CommonJS à la fin du fichier). Inline ici pour éviter une étape
// d'asset pipeline (Lauze tourne en importmap, sans bundler).
<%= raw File.read(Rails.root.join("app/javascript/dpe_slider_logic.js")) %>

// ═══ État côté client ═══════════════════════════════════════════════════
var dpe_all=['A','B','C','D','E','F','G'];
var C_DPE={A:'#16a34a',B:'#4ade80',C:'#a3e635',D:'#ca8a04',E:'#fb923c',F:'#ef4444',G:'#991b1b'};
var CUR=<%= cur_idx %>;
// Cible DPE telle que rendue par le serveur (issue de l'analyse Claude / DB).
// Source de vérité au chargement : on ne dérive PAS la cible des cases cochées
// à l'init, c'est SERVER_TGT_IDX qui pilote slider + pin + hidden field.
var SERVER_TGT_IDX=<%= tgt_idx %>;

// ═══ Matrice DPE serveur — source UNIQUE de la jauge (Temps 3b-2 commit 3) ══
// Lue UNE FOIS au chargement depuis le script JSON embarqué par
// PropertyDpeMatrixService. La jauge entière (recalcTravaux + onSliderChange
// + deriveSelectionForTarget) ne consomme QUE cette matrice. Plus aucun
// forfait scalaire — DPE_IMPACT est supprimée du codebase.
//
// Si la balise dpe-matrix-data est absente (bien sans surface/année, ou
// utilisateur non autorisé), DPE_MATRIX vaut null : la jauge est désactivée
// proprement côté ERB (slider non rendu, message d'invite).
var DPE_MATRIX = (function(){
  var el = document.getElementById('dpe-matrix-data');
  if(!el) return null;
  try { return JSON.parse(el.textContent); }
  catch(e){ console.error('DPE_MATRIX parse error', e); return null; }
})();

// ═══ Référence serveur pour le recalcul proportionnel des aides ═══════════
// Au chargement de la page, on mémorise les vrais chiffres calculés par
// AidCalculatorService. Ces valeurs font autorité. Quand l'utilisateur
// coche/décoche, on ajuste proportionnellement au nouveau budget pour
// donner un feedback immédiat, sans prétendre recalculer officiellement
// (ça se fait au serveur, au clic "Mettre à jour les aides").
// On sépare MPR, CEE et Grand Nancy pour pouvoir basculer cette dernière
// quand l'utilisateur glisse la jauge sur A ou B (Grand Nancy s'active).
var SERVER_REF = {
  budget:         <%= budget_mediane %>,
  mpr:            <%= mpr_montant %>,
  cee:            <%= cee_montant %>,
  gn:             <%= gn_montant %>,
  gn_active_now:  <%= gn_active_now %>
};

// Flag : true tant que l'utilisateur n'a pas persisté sa sélection via le submit.
// Permet de savoir si les chiffres affichés sont encore "alignés" sur le serveur.
var TRAVAUX_DIRTY = false;

// ═══ Recalcul temps réel du budget et de la cible DPE selon cases cochées ═
// Sens 1 : checkboxes → jauge (utilisé par les onchange des checkboxes)
//
// Param `skipJaugeUpdate` : quand l'appel vient de onSliderChange, l'utilisateur
// a déjà choisi sa cible sur la jauge. On ne doit PAS recalculer cette cible
// depuis les cases cochées (qui pourraient donner un gain arrondi différent
// et faire "rebondir" la jauge — ex: je vise E, le recalc coche 1 travail et
// fait "sauter" la jauge sur D).
//
// Param `initialLoad` : appel depuis initShow au chargement de la page. À
// l'init, la cible DPE qui fait foi est celle du serveur (SERVER_TGT_IDX,
// issue de l'analyse Claude). On ne dérive PAS la cible des cases cochées
// (sinon un bien avec plein de travaux pré-cochés "auto-snappe" vers A et
// le hidden field form-dpe-target persiste cette cible non choisie au
// premier submit). On positionne donc la jauge sur SERVER_TGT_IDX et on
// ne marque rien comme "à recalculer".
function recalcTravaux(initialLoad){
  var total=0;
  var codesActifs=[];
  document.querySelectorAll('.travail-check').forEach(function(row){
    var cb=row.querySelector('input[type=checkbox].travail-cb');
    var coche=cb && cb.checked;
    row.classList.toggle('off', !coche);
    if(coche){
      total += parseInt(row.dataset.mediane||'0', 10);
      codesActifs.push(row.dataset.code);
    }
  });

  // Mise à jour budget affiché dans la card Rénovation
  var budgetNum=document.getElementById('budget-num');
  if(budgetNum){
    budgetNum.textContent = total.toLocaleString('fr-FR');
  }

  // Mise à jour de la jauge :
  //  - à l'init : on cale sur la cible serveur, source de vérité au load,
  //    pas sur les cases cochées (éviter le snap silencieux vers A si des
  //    cases sont pré-cochées par PropertyAnalysisJob).
  //  - toute autre interaction (case cochée/décochée, drag du slider qui
  //    aura pré-coché les cases via la cascade) : SOURCE DE VÉRITÉ UNIQUE
  //    = les cases cochées. On appelle deriveTargetFromSelection sur
  //    (codesActifs, matrice, CUR) et on updateJaugeDPE avec le résultat.
  //    Si la matrice n'a pas d'entrée pour la combinaison, fallback
  //    pessimiste à CUR (pas d'objectif inventé). Fix du bug prod
  //    « MÊME set de cases affiche tantôt A tantôt B selon l'historique ».
  if(initialLoad){
    updateJaugeDPE(SERVER_TGT_IDX);
    var sliderInit=document.getElementById('dpe-slider');
    if(sliderInit && sliderInit.value != SERVER_TGT_IDX){ sliderInit.value = SERVER_TGT_IDX; }
  } else {
    var tgtIdx = deriveTargetFromSelection({
      codesActifs:   codesActifs,
      combinaisons:  DPE_MATRIX ? DPE_MATRIX.combinaisons : null,
      currentDpeIdx: CUR
    });
    updateJaugeDPE(tgtIdx);
    var slider=document.getElementById('dpe-slider');
    if(slider && slider.value != tgtIdx){ slider.value = tgtIdx; }
  }

  // Feedback proportionnel sur les aides et le reste à financer.
  // Si le budget a varié, on applique le même ratio aux aides serveur connues.
  // Exemple : budget × 0.7 → MPR × 0.7 (approximation, car les forfaits
  // réels ne sont pas strictement linéaires, mais suffisant pour feedback).
  recalcAidesProportionnel(total);

  // Marquer les chiffres comme "à recalculer" pour inciter au submit —
  // sauf à l'init, où rien n'a changé du côté utilisateur.
  if(!initialLoad){
    TRAVAUX_DIRTY = true;
    marquerAidesPerimees();
  }
}

// Met à jour les cards Aides et Financement proportionnellement au nouveau budget.
// Base : valeurs serveur × ratio (budget actuel / budget initial).
// Cas spécial : Grand Nancy n'est active que si la cible DPE = A ou B.
// Quand elle est active, son montant entre dans le total. Sinon elle est
// affichée en "aides sous condition" (visuellement grisée, montant non compté).
function recalcAidesProportionnel(budgetActuel){
  var fmt = function(v){ return v.toLocaleString('fr-FR') + ' €'; };
  var ratio = SERVER_REF.budget > 0 ? (budgetActuel / SERVER_REF.budget) : 0;

  var mprEst = Math.max(0, Math.round(SERVER_REF.mpr * ratio));
  var ceeEst = Math.max(0, Math.round(SERVER_REF.cee * ratio));
  var gnEst  = Math.max(0, Math.round(SERVER_REF.gn  * ratio));

  // Lecture de la cible DPE courante via le hidden field (mis à jour par le slider)
  var hiddenTgt = document.getElementById('form-dpe-target');
  var currentLetter = hiddenTgt ? hiddenTgt.value : null;
  var gnActive = (currentLetter === 'A' || currentLetter === 'B');

  // Bascule visuelle : active row visible si gnActive, sinon potential block
  var gnActiveRow    = document.getElementById('gn-active-row');
  var gnPotentialBox = document.getElementById('gn-potential-block');
  if(gnActiveRow)    gnActiveRow.style.display    = gnActive ? 'flex' : 'none';
  if(gnPotentialBox) gnPotentialBox.style.display = gnActive ? 'none' : 'block';

  // Mise à jour des montants dans les deux variantes (active et potentielle)
  var gnActiveAmountEl = document.getElementById('aide-gn-val');
  var gnPotAmountEl    = document.getElementById('aide-gn-pot-val');
  if(gnActiveAmountEl) gnActiveAmountEl.textContent = fmt(gnEst);
  if(gnPotAmountEl)    gnPotAmountEl.textContent    = fmt(gnEst);

  // Total : MPR + CEE + (GN si active)
  var totalEst = mprEst + ceeEst + (gnActive ? gnEst : 0);

  // Écriture dans le DOM
  var mprEl   = document.getElementById('aide-mpr-val');
  var ceeEl   = document.getElementById('aide-cee-val');
  var totalEl = document.getElementById('aide-total-val');
  if(mprEl)   mprEl.textContent   = fmt(mprEst);
  if(ceeEl)   ceeEl.textContent   = fmt(ceeEst);
  if(totalEl) totalEl.textContent = fmt(totalEst);

  // Reste à financer
  var resteEst = Math.max(0, budgetActuel - totalEst);
  var resteEl = document.getElementById('financement-reste-val');
  if(resteEl) resteEl.textContent = fmt(resteEst);
  var resteSim = document.getElementById('financement-reste-sim');
  if(resteSim) resteSim.textContent = fmt(resteEst);

  // Simulateur mensualité mis à jour avec le nouveau reste
  SIM_M = resteEst;
  if(typeof calcPret === 'function') calcPret();
}

// Met un badge "à recalculer" sur les cards Aides et Financement pour indiquer
// que les montants affichés ne correspondent peut-être plus aux cases cochées.
// Effacé au prochain reload (après submit "Mettre à jour les aides").
function marquerAidesPerimees(){
  var el = document.getElementById('aides-stale-badge');
  if(el){ el.style.display = 'inline-block'; }
  var el2 = document.getElementById('financement-stale-badge');
  if(el2){ el2.style.display = 'inline-block'; }
}

// Sens jauge → travaux : le slider est un RACCOURCI pour préparer une
// sélection. La fonction pure deriveSelectionForTarget (cf.
// app/javascript/dpe_slider_logic.js + tests P/Q/I/N) coche les travaux
// nécessaires pour atteindre la cible demandée, puis recalcTravaux
// re-dérive l'objectif RÉELLEMENT atteint depuis ces cases.
//
// SOURCE DE VÉRITÉ UNIQUE = l'ensemble des cases cochées, TOUJOURS. Le
// slider ne pilote plus directement le label/pin : il coche, puis
// recalcTravaux() met à jour le label depuis la matrice. Si la cascade
// tombe sur un préfixe qui atteint une classe MOINS BONNE que le slider
// demandait (cible A demandée mais matrice n'atteint que B avec tous
// les gestes), on affiche B — honnête, pas d'objectif optimiste.
//
// SACRIFICE ASSUMÉ : les cochages manuels antérieurs sont écrasés par
// la cascade. C'est le prix de la cohérence "une lettre = une sélection".
//
// Pas de boucle : `cb.checked = X` (assignation propriété par script) ne
// dispatch PAS l'event 'change', donc le listener change qui appelle
// recalcTravaux n'est pas re-déclenché. Propriété structurelle.
// Helper : extraction des coûts médians depuis les data-mediane du DOM.
// Utilisé par onSliderChange (pour la sélection) et par initShow (pour
// calculer les classes dominées à l'affordance).
function extractTravauxCosts(){
  var costs = {};
  document.querySelectorAll('.travail-check').forEach(function(row){
    if(row.dataset.code){
      costs[row.dataset.code] = parseInt(row.dataset.mediane || '0', 10) || 0;
    }
  });
  return costs;
}

// Affiche le microtexte de recalage : "Bonne nouvelle : atteindre D coûte
// moins cher que E — objectif recalé sur D". Le message disparaît à la
// manipulation suivante (checkbox click → clearRecaleNote).
function showRecaleNote(clickedIdx, derivedIdx){
  var el = document.getElementById('dpe-recale-note');
  if(!el) return;
  var clicked = dpe_all[clickedIdx];
  var derived = dpe_all[derivedIdx];
  el.textContent = 'Bonne nouvelle : pour ce bien, atteindre ' + derived +
                   ' coûte moins cher que ' + clicked +
                   ' — objectif recalé sur ' + derived + '.';
  el.style.display = 'block';
}

function clearRecaleNote(){
  var el = document.getElementById('dpe-recale-note');
  if(el) el.style.display = 'none';
}

function onSliderChange(newTgtVal){
  var tgtIdx = parseInt(newTgtVal);

  // Clamp : impossible de cibler un DPE ≥ DPE actuel (ça n'a pas de sens).
  if(tgtIdx >= CUR){
    tgtIdx = Math.max(0, CUR - 1);
    var slider = document.getElementById('dpe-slider');
    if(slider){ slider.value = tgtIdx; }
  }

  // Cas dégradé : pas de matrice → pas de cascade possible. Le slider n'est
  // de toute façon pas rendu (cf. condition côté ERB), mais on garde la
  // garde-fou JS au cas où.
  if(!DPE_MATRIX){
    updateJaugeDPE(tgtIdx);
    clearRecaleNote();
    return;
  }

  // Sémantique "au moins X" : deriveSelectionForTarget retourne l'ensemble
  // LE MOINS CHER dont la classe dérivée est <= tgtIdx. Peut donc être
  // MEILLEURE que ce qui a été cliqué — flag `recale` posé pour qu'on
  // affiche honnêtement le décalage à l'utilisateur.
  var res = deriveSelectionForTarget({
    currentDpeIdx:  CUR,
    targetIdx:      tgtIdx,
    combinaisons:   DPE_MATRIX.combinaisons,
    travauxCosts:   extractTravauxCosts()
  });

  // Écriture DOM : on coche exactement ce que res.checked contient,
  // on décoche le reste. Sacrifice assumé "cochage manuel ne survit
  // pas à un drag de jauge".
  var checkedSet = new Set(res.checked);
  document.querySelectorAll('.travail-check').forEach(function(row){
    var cb = row.querySelector('input[type=checkbox].travail-cb');
    if(!cb || !row.dataset.code) return;
    cb.checked = checkedSet.has(row.dataset.code);
  });

  // Recalcul complet : le label/pin est dérivé des cases APRÈS cascade.
  // recalcTravaux positionne le pin sur res.derivedClasseIdx (via
  // deriveTargetFromSelection qui relit les cases).
  recalcTravaux();

  // Microtexte "recalé" : révélé si la classe dérivée est STRICTEMENT
  // MEILLEURE que celle cliquée (le user visait E, on lui donne D moins
  // cher). Le cas pessimist (classe dérivée > cliquée) est un vrai échec
  // "on n'a pas atteint la cible" — même flag mais message différent
  // serait faisable ; pour l'instant on garde le format positif car en
  // pratique le pessimist est très rare (matrice tronquée).
  if(res.recale && res.derivedClasseIdx < tgtIdx){
    showRecaleNote(tgtIdx, res.derivedClasseIdx);
  } else {
    clearRecaleNote();
  }
}

// Met à jour uniquement l'affichage de la jauge (sans toucher les checkboxes).
// Met aussi à jour le hidden field form-dpe-target pour que le submit
// persiste la cible DPE courante en DB.
//
// AFFORDANCE segments dominés : les segments marqués data-dominated=1 par
// initShow (classes qui ne seront jamais un point d'arrivée du slider —
// cliquer dessus recale toujours vers une classe meilleure) restent à
// opacité réduite MÊME quand ils sont dans la zone highlighted [tgtIdx,CUR].
// L'utilisateur voit dès le repos que ces classes sont "dominées".
function updateJaugeDPE(tgtIdx){
  var pin=document.getElementById('pin-tgt');
  var dot=document.getElementById('pin-tgt-dot');
  var lbl=document.getElementById('dpe-estim-val');
  var hiddenTgt=document.getElementById('form-dpe-target');
  if(pin){ pin.style.left='calc('+tgtIdx+'/7*100% + 1/14*100%)'; }
  if(dot){ dot.textContent=dpe_all[tgtIdx]; dot.style.background=C_DPE[dpe_all[tgtIdx]]; }
  if(lbl){ lbl.textContent=dpe_all[tgtIdx]; }
  if(hiddenTgt){ hiddenTgt.value=dpe_all[tgtIdx]; }
  document.querySelectorAll('.dpe-seg').forEach(function(seg,i){
    if(seg.dataset.dominated === '1'){
      seg.style.opacity = '0.2';
    } else {
      seg.style.opacity = (i>=tgtIdx && i<=CUR) ? '1' : '0.4';
    }
  });
}

// Raccourci : tout cocher ou tout décocher. recalcTravaux ensuite recale
// la jauge depuis le nouveau gain DPE cumulé.
function toggleAllTravaux(etat){
  document.querySelectorAll('.travail-cb').forEach(function(cb){
    cb.checked = !!etat;
  });
  recalcTravaux();
}

// ═══ Simulateur de prêt bancaire (sur le reliquat après Éco-PTZ) ════════
// Simulateur de prêt bancaire : porte sur le reste à financer COMPLET.
// L'Éco-PTZ est présenté comme une option annexe (à négocier avec la banque),
// pas comme une certitude de couverture partielle. Voir _simple_financing.html.erb.
var SIM_M=<%= reste %>;

function calcPret(){
  var D=parseInt((document.getElementById('sim-d')||{}).value)||15;
  var T=parseFloat((document.getElementById('sim-t')||{}).value)||0;
  var dl=document.getElementById('sim-d-lbl'); if(dl) dl.textContent=D+' ans';
  var tl=document.getElementById('sim-t-lbl'); if(tl) tl.textContent=T.toFixed(1)+' %';
  var M=SIM_M,n=D*12,fmt=function(x){return Math.round(x).toLocaleString('fr-FR')+' €';};
  var ms=document.getElementById('sim-mens'),st=document.getElementById('sim-total'),sc=document.getElementById('sim-cout');
  if(!ms)return;
  if(M<=0){
    ms.textContent='—';
    st.textContent='—';
    sc.textContent='—';
    return;
  }
  if(T===0){ms.textContent=fmt(M/n)+'/mois';st.textContent=fmt(M);sc.textContent='0 €';}
  else{var r=(T/100)/12,m=M*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1),tot=m*n;ms.textContent=fmt(m)+'/mois';st.textContent=fmt(tot);sc.textContent=fmt(tot-M);}
}

// ═══ Init ═══════════════════════════════════════════════════════════════
function initShow(){
  // Écoute sur chaque checkbox travaux pour feedback temps réel (sens
  // CASES → JAUGE : recalcTravaux recale la jauge sur la classe
  // atteignable via deriveTargetFromSelection). cb.checked = X par
  // script ne dispatch pas 'change', donc onSliderChange ne déclenche
  // pas ce listener — pas de boucle.
  // NB : on enveloppe l'appel pour NE PAS propager l'Event du listener
  // en premier argument de recalcTravaux, sinon initialLoad = Event =
  // truthy et on calerait le label sur SERVER_TGT_IDX à chaque clic.
  // Toute manipulation manuelle des cases fait disparaître le microtexte
  // de recalage (principe projet : le message ne persiste pas au-delà de
  // l'action qui l'a déclenchée).
  document.querySelectorAll('.travail-cb').forEach(function(cb){
    cb.addEventListener('change', function(){
      recalcTravaux();
      clearRecaleNote();
    });
  });
  // Appel d'init : initialLoad=true (on cale la jauge sur SERVER_TGT_IDX,
  // pas dérivée des cases). Empêche le snap silencieux vers une cible
  // ambitieuse (ex. A) au load si des cases ont été pré-cochées par
  // PropertyAnalysisJob, et sa persistance au premier submit sans
  // interaction réelle.
  recalcTravaux(true);
  calcPret();

  // ── Affordance : classes dominées ──────────────────────────────────
  // Une classe est DOMINÉE quand cliquer dessus recale toujours vers une
  // classe meilleure (cas E→D observé en prod). On marque les segments
  // correspondants au chargement (opacité réduite + title explicatif)
  // pour que l'utilisateur voie AVANT de cliquer que ces classes ne sont
  // pas des points d'arrivée utiles.
  if(DPE_MATRIX){
    var costsInit = extractTravauxCosts();
    var dominated = computeDominatedClasses({
      currentDpeIdx: CUR,
      combinaisons:  DPE_MATRIX.combinaisons,
      travauxCosts:  costsInit
    });
    var segs = document.querySelectorAll('.dpe-seg');
    dominated.forEach(function(i){
      var seg = segs[i];
      if(!seg) return;
      seg.dataset.dominated = '1';
      seg.style.cursor = 'help';
      // Reformuler proprement quelle classe le drag choisirait à la place.
      var alt = deriveSelectionForTarget({
        currentDpeIdx: CUR, targetIdx: i,
        combinaisons: DPE_MATRIX.combinaisons, travauxCosts: costsInit
      });
      seg.title = dpe_all[i] + ' n\'est pas un objectif utile pour ce bien : ' +
                  'atteindre ' + dpe_all[alt.derivedClasseIdx] +
                  ' coûte moins cher. La jauge recalera automatiquement.';
    });
    // Applique tout de suite l'opacité 0.2 sur les segments dominés (avant
    // le prochain updateJaugeDPE, qui les respectera).
    if(dominated.length){
      var tgtNow = document.getElementById('form-dpe-target');
      var curTgtIdx = tgtNow ? dpe_all.indexOf(tgtNow.value) : SERVER_TGT_IDX;
      if(curTgtIdx >= 0) updateJaugeDPE(curTgtIdx);
    }
  }

  // Fallback scroll vers l'ancre (#aides, #financement, #travaux).
  // Nécessaire avec Turbo Drive qui peut parfois ne pas respecter le hash natif.
  if(window.location.hash){
    var target = document.querySelector(window.location.hash);
    if(target){
      setTimeout(function(){
        target.scrollIntoView({behavior: 'smooth', block: 'start'});
      }, 80);
    }
  }
}
document.addEventListener('DOMContentLoaded', initShow);
document.addEventListener('turbo:load', initShow);
</script>
