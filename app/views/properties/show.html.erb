<%# JS — jauge DPE uniquement %>
<script>
var DPE=['A','B','C','D','E','F','G'];
var C={A:'#16a34a',B:'#4ade80',C:'#a3e635',D:'#facc15',E:'#fb923c',F:'#ef4444',G:'#991b1b'};
var CUR=<%= cur_idx %>;
var TRAVAUX=<%= travaux.map{|t|{poste:t["poste"],cout_min:t["cout_min"].to_i,cout_max:t["cout_max"].to_i,priorite:t["priorite"].to_i}}.to_json.html_safe %>;

function clickSeg(idx){
  // Cliquer sur un segment = choisir cet objectif (sauf segment actuel ou pire)
  if(idx>=CUR)return;
  document.getElementById('dpe-slider').value=idx;
  slideTgt(idx);
}

function slideTgt(v){
  // Retirer l'animation dès la première interaction
  document.getElementById('pin-tgt').classList.remove('nudge');
  v=parseInt(v);
  // Empêcher de viser pire ou identique
  if(v>=CUR){ v=Math.max(0,CUR-1); document.getElementById('dpe-slider').value=v; }

  var pct=(v/7*100+1/14*100).toFixed(2);
  document.getElementById('pin-tgt').style.left='calc('+pct+'% - 16px)';
  var dot=document.getElementById('pin-tgt-dot');
  dot.textContent=DPE[v];
  dot.style.background=C[DPE[v]];


  // Colorer les segments entre objectif et actuel
  document.querySelectorAll('.dpe-seg').forEach(function(seg,i){
    seg.style.opacity=(i>=v&&i<=CUR)?'1':'0.4';
  });

  calcTravaux(v);
}

function calcTravaux(tgtIdx){
  var sauts=CUR-tgtIdx;
  if(sauts<=0||!TRAVAUX.length){
    document.getElementById('trav-list').innerHTML='';
    document.getElementById('budget-val').textContent='—';
    return;
  }
  var sel=[],mn=0,mx=0,gains=0,html='';
  for(var i=0;i<TRAVAUX.length;i++){
    var t=TRAVAUX[i]; sel.push(t); mn+=t.cout_min; mx+=t.cout_max; gains++;
    var emojis={'isolation':'🧱','combles':'🏠','chauffage':'🔥','pompe':'🔥','chaudière':'🔥','mur':'🧱','extérieur':'🧱','intérieur':'🧱','ventilation':'💨','vmc':'💨','fenêtre':'🪟','menuiserie':'🪟','toit':'🏠','toiture':'🏠','sarking':'🏠','plancher':'🧱','ite':'🧱'};
    var emoji='🔧';
    Object.keys(emojis).forEach(function(k){if(t.poste.toLowerCase().includes(k))emoji=emojis[k];});
    html+='<div class="row"><p class="bod" style="font-weight:600;">'+emoji+' '+t.poste+'</p>'
         +'<p class="bod" style="font-weight:700;white-space:nowrap;">'+t.cout_min.toLocaleString('fr-FR')+' – '+t.cout_max.toLocaleString('fr-FR')+' €</p></div>';
    if(gains>=sauts)break;
  }
  document.getElementById('trav-list').innerHTML=html;
  document.getElementById('budget-val').textContent=mn.toLocaleString('fr-FR')+' – '+mx.toLocaleString('fr-FR')+' €';
  document.getElementById('budget-box').style.display='flex';
}

document.addEventListener('DOMContentLoaded',function(){
  slideTgt(<%= tgt_idx %>);
  calcPret();
  // Animation d'invitation : oscillation JS sur left du pin
  var pin=document.getElementById('pin-tgt');
  if(!pin)return;
  var base=parseFloat(pin.style.left);
  var steps=[-14,10,-8,5,-3,0];
  var delay=700;
  steps.forEach(function(dx,i){
    setTimeout(function(){
      pin.style.left='calc('+(<%=tgt_idx%>/7*100+1/14*100).toFixed(2)+'% - 16px + '+dx+'px)';
    }, delay + i*160);
  });
  setTimeout(function(){
    pin.style.left='calc('+(<%=tgt_idx%>/7*100+1/14*100).toFixed(2)+'% - 16px)';
  }, delay + steps.length*160);
});

// Sélecteur revenus
var MPR_TAUX=[0.70,0.50,0.35,0.15];
var _budget=<%= budget_max %>;
var _curRev=<%= {"tres_modeste"=>0,"modeste"=>1,"intermediaire"=>2,"superieur"=>3}[@property.income_bracket.to_s] || 3 %>;

function setRev(idx,key){
  _curRev=idx;
  [0,1,2,3].forEach(function(i){
    var b=document.getElementById('rev-'+i);
    if(!b)return;
    b.style.background=i===idx?'#ede9fe':'#fff';
    b.style.color=i===idx?'#5b21b6':'#374151';
    b.style.borderColor=i===idx?'#5b21b6':'#e5e7eb';
  });
  recalcAides(_budget);
}

function recalcAides(mx){
  if(!mx)return;
  var mpr=Math.min(Math.round(mx*MPR_TAUX[_curRev]),-2+20002,20000);
  mpr=Math.min(Math.round(mx*MPR_TAUX[_curRev]),20000);
  var cee=Math.min(Math.round(mx*0.08),4000);
  var reste=Math.max(0,mx-mpr-cee);
  var fmt=function(x){return x.toLocaleString('fr-FR')+' €';};
  var mprEl=document.getElementById('mpr-val');
  var ceeEl=document.getElementById('cee-val');
  var resteEl=document.getElementById('reste-val');
  if(mprEl) mprEl.textContent=mpr>0?fmt(mpr):'—';
  if(ceeEl) ceeEl.textContent=cee>0?fmt(cee):'—';
  if(resteEl) resteEl.textContent=reste>0?fmt(reste):mx>0?'0 €':'—';
  // Mettre à jour le slider financement
  var sl=document.getElementById('sim-m');
  if(sl&&reste>0){sl.value=reste;calcPret();}
}

// Simulateur prêt
function calcPret(){
  var M=typeof SIM_M!=='undefined'?SIM_M:(parseInt(document.getElementById('sim-m')&&document.getElementById('sim-m').value)||0);
  var D=parseInt(document.getElementById('sim-d').value)||15;
  var T=parseFloat(document.getElementById('sim-t').value)||0;

  document.getElementById('sim-d-lbl').textContent=D+' ans';
  document.getElementById('sim-t-lbl').textContent=T.toFixed(1)+' %';
  var n=D*12,fmt=function(x){return Math.round(x).toLocaleString('fr-FR')+' €';};
  if(T===0){var m=M/n;document.getElementById('sim-mens').textContent=fmt(m)+'/mois';document.getElementById('sim-total').textContent=fmt(M);document.getElementById('sim-cout').textContent='0 €';}
  else{var r=(T/100)/12,m=M*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1),tot=m*n;document.getElementById('sim-mens').textContent=fmt(m)+'/mois';document.getElementById('sim-total').textContent=fmt(tot);document.getElementById('sim-cout').textContent=fmt(tot-M);}
}
</script>
