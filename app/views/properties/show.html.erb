</div>
<% end %>

<%# ── RÉNOVATION : JAUGE + TRAVAUX ───────────────────────── %>
<% if dpe_cur %>
<div class="cd">
  <div class="cd-hd" style="background:#059669;">⚡ Rénovation énergétique</div>
  <div style="padding:20px;">



    <%# Animation sur le pin pour inviter à glisser %>
    <%# Wrapper pour la jauge + pin sans clip %>
    <div style="position:relative;margin-bottom:20px;">
      <%# Barre colorée (overflow:hidden pour arrondir les coins) %>
