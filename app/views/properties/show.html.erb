<%# show.html.erb v4 — ultra-épuré %>

<% parsed   = @property.analysis&.content.present? ? (JSON.parse(@property.analysis.content) rescue nil) : nil %>
<% v        = parsed&.[]("valeur") %>
<% e        = parsed&.[]("energie") %>
<% i_       = parsed&.[]("idees") %>
<% is_owner = user_signed_in? && current_user == @property.user %>

<% dpe_all = %w[A B C D E F G] %>
<% dpe_colors = {"A"=>"#16a34a","B"=>"#4ade80","C"=>"#a3e635","D"=>"#facc15","E"=>"#fb923c","F"=>"#ef4444","G"=>"#991b1b"} %>
<% dpe_cur    = (@property.dpe_class || e&.[]("dpe_estime"))&.upcase %>
<% dpe_cib    = (e&.[]("dpe_cible"))&.upcase %>
<% travaux    = (e&.[]("travaux") || []).sort_by{|t| t["priorite"].to_i} %>
<% cur_idx    = dpe_all.index(dpe_cur) || 5 %>
<% tgt_idx    = dpe_cib ? [dpe_all.index(dpe_cib) || (cur_idx-2), 0].max : [cur_idx-2, 0].max %>

<%# Aides selon profil %>
<% mpr_taux = case @property.income_bracket&.to_s
     when "tres_modeste"  then 0.70
     when "modeste"       then 0.50
     when "intermediaire" then 0.35
     else 0.15
   end %>
<% mpr_profil = case @property.income_bracket&.to_s
     when "tres_modeste"  then "Très modestes (< 21 000 €/an)"
     when "modeste"       then "Modestes (21–30 000 €/an)"
     when "intermediaire" then "Intermédiaires (30–45 000 €/an)"
     when "superieur"     then "Supérieurs (> 45 000 €/an)"
     else nil
   end %>
<% budget_max = travaux.sum{|t| t["cout_max"].to_i} %>
<% budget_min = travaux.sum{|t| t["cout_min"].to_i} %>
<% mpr_montant = budget_max > 0 ? [( budget_max * mpr_taux).round(-2), 20000].min : 0 %>
<% cee_montant = budget_max > 0 ? [(budget_max * 0.08).round(-2), 4000].min : 0 %>
<% sauts       = dpe_cur && dpe_cib ? (dpe_all.index(dpe_cur).to_i - dpe_all.index(dpe_cib).to_i) : 2 %>
<% eco_ptz     = sauts >= 3 ? 50000 : 30000 %>
<% total_aides = mpr_montant + cee_montant %>
<% reste       = [budget_max - total_aides, 0].max %>

<style>
  .sh  { max-width:600px; margin:0 auto; padding:20px 14px 60px;
         font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  .lbl { font-size:.68rem; font-weight:700; color:#9ca3af;
         text-transform:uppercase; letter-spacing:.07em; }
  .bod { font-size:.88rem; color:#374151; line-height:1.6; }
  .big { font-size:1.7rem; font-weight:900; color:#111; line-height:1; }
  .cd  { background:#fff; border-radius:18px; border:1px solid #e5e7eb;
         box-shadow:0 2px 14px rgba(0,0,0,.07); margin-bottom:32px; overflow:hidden; }
  .cd-hd { padding:13px 20px; font-size:.75rem; font-weight:800;
            text-transform:uppercase; letter-spacing:.09em; color:#fff; }
  .row { display:flex; justify-content:space-between; align-items:baseline;
         gap:12px; padding:11px 0; border-bottom:1px solid #f3f4f6; }
  .row:last-child { border-bottom:none; }
  .row p:last-child { white-space:nowrap; flex-shrink:0; }
  /* Jauge DPE */
  .dpe-track { position:relative; height:48px; display:flex;
               border-radius:24px; overflow:hidden; }
  .dpe-seg   { flex:1; display:flex; align-items:center; justify-content:center;
               font-size:.85rem; font-weight:900; color:rgba(255,255,255,.75); }
  .pin       { position:absolute; top:50%; transform:translateY(-50%);
               pointer-events:none; transition:left .15s; z-index:5; }
  .pin-dot   { width:32px; height:32px; border-radius:50%; display:flex; align-items:center;
               justify-content:center; font-size:.85rem; font-weight:900; color:#fff;
               border:3px solid #fff; box-shadow:0 2px 8px rgba(0,0,0,.25); }
  /* Animation pulse constante sur le pin objectif */
  @keyframes pulse-pin {
    0%, 100% { transform:scale(1); box-shadow:0 0 0 3px rgba(5,150,105,.3); }
    50%      { transform:scale(1.2); box-shadow:0 0 0 7px rgba(5,150,105,.12); }
  }
  #pin-tgt-dot { animation: pulse-pin 1.8s ease-in-out infinite; }
  /* Animation d'invitation à glisser — 2 allers-retours puis stop */

</style>

<div class="sh">

<%# ── HEADER ─────────────────────────────────────────────── %>
<div class="cd">
  <%# Photo du bien — réelle si disponible, placeholder sinon %>
  <% photo_url = @property.property_type == "maison" ?
       "https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=800&q=80" :
       "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=800&q=80" %>
  <div style="position:relative;height:180px;overflow:hidden;">
    <img src="<%= photo_url %>" alt="<%= @property.address %>"
         style="width:100%;height:100%;object-fit:cover;display:block;">
    <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(15,23,42,.85) 0%,rgba(15,23,42,.3) 60%,transparent 100%);"></div>
    <div style="position:absolute;bottom:0;left:0;right:0;padding:16px 20px;">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:10px;">
        <div>
          <p class="lbl" style="color:rgba(255,255,255,.6);margin:0 0 3px;"><%= @property.city %></p>
          <h1 style="font-size:1.25rem;font-weight:900;color:#fff;margin:0 0 4px;line-height:1.2;"><%= @property.address %></h1>
          <p style="font-size:.92rem;font-weight:600;color:rgba(255,255,255,.85);"><%= @property.property_type&.capitalize %><% if @property.nb_rooms %> · T<%= @property.nb_rooms %><% end %> · <%= @property.surface %> m²<% if @property.construction_year %> · <%= @property.construction_year %><% end %></p>
        </div>
        <% if dpe_cur %>
          <div style="width:44px;height:44px;border-radius:11px;background:<%= dpe_colors[dpe_cur] %>;display:flex;align-items:center;justify-content:center;font-size:1.3rem;font-weight:900;color:#fff;flex-shrink:0;border:2px solid rgba(255,255,255,.3);"><%= dpe_cur %></div>
        <% end %>
      </div>
    </div>
  </div>

</div>

<%# ── VALEUR ──────────────────────────────────────────────── %>
<% if v %>
<div class="cd">
  <div class="cd-hd" style="background:#ea580c;">🏷️ Valeur estimée</div>
  <div style="padding:20px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
