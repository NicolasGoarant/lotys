<%# show.html.erb — vue unifiée propriétaire + prestataire %>

<% parsed    = @property.analysis&.content.present? ? (JSON.parse(@property.analysis.content) rescue nil) : nil %>
<% v         = parsed&.[]("valeur") %>
<% e         = parsed&.[]("energie") %>
<% i_        = parsed&.[]("idees") %>
<%# Deux notions distinctes :
     - is_owner_connecte : possède le compte ET le bien. Seul autorisé à
       *agir* (publier, modifier, supprimer, gérer les documents).
     - can_see_full_dossier : *voit* le dossier complet (jauge interactive,
       aides, financement, valeur estimée). Vrai si propriétaire connecté
       OU détenteur en cookie signé du claim_token du bien (parcours
       d'estimation anonyme). Le calcul correspondant côté serveur
       (@aid_result) est élargi de la même façon dans PropertiesController#show. %>
<% is_owner_connecte    = user_signed_in? && current_user == @property.user %>
<% can_see_full_dossier = is_owner_connecte || claimable_by_browser?(@property) %>

<% dpe_all    = %w[A B C D E F G] %>
<% dpe_colors = {"A"=>"#16a34a","B"=>"#4ade80","C"=>"#a3e635","D"=>"#ca8a04","E"=>"#fb923c","F"=>"#ef4444","G"=>"#991b1b"} %>
<% dpe_labels = {"A"=>"Très performant","B"=>"Performant","C"=>"Assez performant","D"=>"Peu performant","E"=>"Énergivore","F"=>"Très énergivore","G"=>"Passoire thermique"} %>
<% dpe_cur    = (@property.dpe_class || e&.[]("dpe_estime"))&.upcase %>
<% dpe_cib    = (e&.[]("dpe_cible"))&.upcase %>
<% travaux_claude = (e&.[]("travaux") || []).sort_by{|t| t["priorite"].to_i} %>
<% cur_idx    = dpe_all.index(dpe_cur) || 5 %>

<%# ── Travaux actifs : travaux_selection jsonb sur Property (7 macro-postes) ─
     On regroupe les travaux Claude par code canonique et on garde le plus
     représentatif pour l'affichage (prix médian, libellé). -%>
<% travaux_groupes = {} %>
<% travaux_claude.each do |t|
     code = TravauxMapperService.code_for_poste(t["poste"])
     next unless code
     travaux_groupes[code] ||= { poste: t["poste"], cout_min: 0, cout_max: 0 }
     travaux_groupes[code][:cout_min] += t["cout_min"].to_i
     travaux_groupes[code][:cout_max] += t["cout_max"].to_i
   end %>

<%# Travaux cochés (ordre canonique) pour calculs de budget et DPE cible %>
<% travaux_actifs = can_see_full_dossier ? @property.travaux_actifs : TravauxMapperService::CANONICAL_CODES %>

<%# ── Aides : valeurs issues d'AidCalculatorService (source unique de vérité) ─ %>
<% mpr_entry   = (@aid_result && @aid_result[:subventions]&.find { |s| s[:type] == "mpr" }) %>
<% mpr_montant = mpr_entry ? mpr_entry[:amount].to_i : 0 %>
<% mpr_taux    = AidCalculatorService::MPR_TAUX_2026[@property.income_bracket.to_s] || 0 %>

<%# CEE et Grand Nancy : détectés explicitement pour permettre le rendu dual
     (Grand Nancy active OU potentielle selon la cible DPE courante). %>
<% cee_entry   = (@aid_result && @aid_result[:subventions]&.find { |s| s[:type] == "cee" }) %>
<% cee_montant = cee_entry ? cee_entry[:amount].to_i : 0 %>

<% gn_slug = "grand_nancy_renovation_globale" %>
<% gn_in_actives = @aid_result && @aid_result[:subventions]&.find { |s| s[:slug] == gn_slug } %>
<% gn_in_potentielles = @aid_result && @aid_result[:aides_potentielles]&.find { |s| s[:slug] == gn_slug } %>
<% gn_entry     = gn_in_actives || gn_in_potentielles %>
<% gn_montant   = gn_entry ? gn_entry[:amount].to_i : 0 %>
<% gn_active_now = gn_in_actives.present? %>

<%# ── Budget : somme des médianes des travaux actifs uniquement ─ %>
<% budget_mediane = travaux_groupes.sum do |code, grp|
     travaux_actifs.include?(code) ? ((grp[:cout_min] + grp[:cout_max]) / 2.0).round(-2).to_i : 0
   end %>
<% budget_max_brut = travaux_claude.sum{|t| t["cout_max"].to_i} %>
<% budget_min_brut = travaux_claude.sum{|t| t["cout_min"].to_i} %>

<%# ── DPE cible estimé selon les travaux cochés (heuristique TravauxMapperService) ─ %>
<% gain_dpe = TravauxMapperService.gain_dpe(travaux_actifs) %>
<% tgt_idx_estime = [cur_idx - gain_dpe, 0].max %>
<%# Conserve la cible DB si elle existe, sinon estimation heuristique %>
<% tgt_idx = dpe_cib && dpe_all.index(dpe_cib) ? dpe_all.index(dpe_cib) : tgt_idx_estime %>
<% sauts   = cur_idx - tgt_idx %>

<%# Aides totales : source = AidCalculatorService %>
<% total_aides = @aid_result ? @aid_result[:total_subventions].to_i : 0 %>

<%# Reste à financer = budget affiché (médiane, travaux cochés) - aides réelles %>
<% reste = [budget_mediane - total_aides, 0].max %>

<%# Décomposition Éco-PTZ vs prêt bancaire %>
<% ptz_entry   = @aid_result && @aid_result[:financement]&.find { |f| f[:type] == "eco_ptz" } %>
<% ptz_plafond = ptz_entry ? ptz_entry[:amount].to_i : 30_000 %>
<% ptz_utilise = [reste, ptz_plafond].min %>
<% reste_banque = [reste - ptz_utilise, 0].max %>

<style>
  .sh  { max-width:600px; margin:0 auto; padding:20px 14px 60px; }
  .lbl { font-size:.68rem; font-weight:700; color:#9ca3af;
         text-transform:uppercase; letter-spacing:.07em; }
  .bod { font-size:.88rem; color:#374151; line-height:1.6; }
  .big { font-size:1.6rem; font-weight:900; color:#111; line-height:1; }
  .cd  { background:#fff; border-radius:18px; border:1px solid #e5e7eb;
         box-shadow:0 2px 14px rgba(0,0,0,.07); margin-bottom:24px; overflow:hidden; scroll-margin-top:80px; }
  #aides, #financement, #travaux { scroll-margin-top: 80px; }
  .cd-hd { padding:13px 20px; font-size:.75rem; font-weight:800;
            text-transform:uppercase; letter-spacing:.09em; color:#fff; }
  .row { display:flex; justify-content:space-between; align-items:baseline;
         gap:12px; padding:11px 0; border-bottom:1px solid #f3f4f6; }
  .row:last-child { border-bottom:none; }
  .row p:last-child { white-space:nowrap; flex-shrink:0; }
  .dpe-track { position:relative; height:48px; display:flex; border-radius:24px; overflow:hidden; }
  .dpe-seg   { flex:1; display:flex; align-items:center; justify-content:center;
               font-size:.85rem; font-weight:900; color:rgba(255,255,255,.75); }
  .pin       { position:absolute; top:50%; transform:translateY(-50%);
               pointer-events:none; transition:left .3s cubic-bezier(.4,0,.2,1); z-index:5; }
  .pin-dot   { width:32px; height:32px; border-radius:50%; display:flex; align-items:center;
               justify-content:center; font-size:.85rem; font-weight:900; color:#fff;
               border:3px solid #fff; box-shadow:0 2px 8px rgba(0,0,0,.25); }
  @keyframes pulse-pin {
    0%,100% { transform:scale(1); }
    50%     { transform:scale(1.2); box-shadow:0 0 0 6px rgba(5,150,105,.15); }
  }
  #pin-tgt-dot { animation: pulse-pin 1.8s ease-in-out infinite; }

  .travail-check { display:flex; align-items:center; gap:10px; padding:10px 12px;
                   background:#f9fafb; border-radius:10px; margin-bottom:6px;
                   cursor:pointer; transition:background .15s, opacity .2s; }
  .travail-check:hover { background:#f3f4f6; }
  .travail-check input[type=checkbox] { width:18px; height:18px; accent-color:#059669;
                                         cursor:pointer; flex-shrink:0; margin:0; }
  .travail-check.off { opacity:0.5; }
  .travail-check.off .travail-label { text-decoration:line-through; color:#9ca3af; }
</style>

<div class="sh">
<%= render "analysis_status", property: @property %>

<%# ── HEADER avec photo ────────────────────────────────────── %>
<div class="cd">
  <% photo_url = @property.property_type == "maison" ?
       "https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=800&q=80" :
       "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=800&q=80" %>
  <div style="position:relative;height:180px;overflow:hidden;">
    <img src="<%= photo_url %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block;">
    <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(15,23,42,.85) 0%,rgba(15,23,42,.2) 60%,transparent 100%);"></div>
    <div style="position:absolute;bottom:0;left:0;right:0;padding:16px 20px;display:flex;align-items:flex-end;justify-content:space-between;gap:10px;">
      <div>
        <p class="lbl" style="color:rgba(255,255,255,.5);margin:0 0 2px;"><%= @property.city %></p>
        <h1 style="font-size:1.25rem;font-weight:900;color:#fff;margin:0 0 4px;line-height:1.2;"><%= @property.address %></h1>
        <p style="font-size:.92rem;font-weight:600;color:rgba(255,255,255,.85);">
          <%= @property.property_type&.capitalize %>
          <% if @property.nb_rooms %> · T<%= @property.nb_rooms %><% end %>
          · <%= @property.surface %> m²
          <% if @property.construction_year %> · <%= @property.construction_year %><% end %>
        </p>
      </div>
      <% if dpe_cur %>
        <div style="width:48px;height:48px;border-radius:12px;background:<%= dpe_colors[dpe_cur] %>;display:flex;align-items:center;justify-content:center;font-size:1.4rem;font-weight:900;color:#fff;flex-shrink:0;"><%= dpe_cur %></div>
      <% end %>
    </div>
  </div>

  <%# Mini-map %>
  <div id="prop-map" style="height:130px;"></div>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
  function initPropMap(){
    var el=document.getElementById('prop-map');
    if(!el||el._leaflet_id)return;
    var lat=<%= @property.lat.presence || 48.6921 %>;
    var lng=<%= @property.lng.presence || 6.1844 %>;
    var ll=[lat,lng];
    var col={"A":"#16a34a","B":"#22c55e","C":"#84cc16","D":"#ca8a04","E":"#f97316","F":"#dc2626","G":"#991b1b"};
    var c=col["<%= @property.dpe_class&.upcase || 'F' %>"]||"#6b7280";
    var map=L.map(el,{zoomControl:false,dragging:false,scrollWheelZoom:false,attributionControl:false}).setView(ll,15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(map);
    var icon=L.divIcon({html:'<div style="width:28px;height:28px;border-radius:50%;background:'+c+';display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:900;color:#fff;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.3);">'+"<%= @property.dpe_class&.upcase || '?' %>"+'</div>',className:'',iconSize:[28,28],iconAnchor:[14,14]});
    L.marker(ll,{icon:icon}).addTo(map);
  }
  document.addEventListener('turbo:load',initPropMap);
  document.addEventListener('DOMContentLoaded',initPropMap);
  </script>

  <%# Boutons selon profil — actions qui MUTENT le bien : réservées au
       propriétaire connecté. Un claimant anonyme ne doit jamais voir
       Publier ni Modifier (il devra s'inscrire pour récupérer son bien). %>
  <div style="padding:10px 16px;display:flex;gap:8px;flex-wrap:wrap;">
    <% if is_owner_connecte %>
      <%= link_to "Modifier", edit_property_path(@property), style:"font-size:.78rem;font-weight:600;padding:7px 12px;border-radius:8px;border:1px solid #e5e7eb;color:#374151;text-decoration:none;" %>
      <% if @property.draft? || @property.analyzed? %>
        <%= button_to "Lancer l'analyse →", analyze_property_path(@property), style:"font-size:.78rem;font-weight:700;padding:7px 12px;border-radius:8px;background:#1d4ed8;color:#fff;border:none;cursor:pointer;" %>
      <% end %>
      <% if @property.analyzed? %>
        <%= link_to "Publier →", preview_property_path(@property), style:"font-size:.78rem;font-weight:700;padding:7px 12px;border-radius:8px;background:#059669;color:#fff;text-decoration:none;" %>
      <% end %>
    <% else %>
      <%= link_to "← Retour à la carte", root_path, style:"font-size:.78rem;font-weight:600;padding:7px 12px;border-radius:8px;border:1px solid #e5e7eb;color:#374151;text-decoration:none;" %>
    <% end %>
  </div>
</div>

<%# ── VALEUR (dossier complet : propriétaire ou claimant) ────── %>
<% if v && can_see_full_dossier %>
<div class="cd">
  <div class="cd-hd" style="background:#ea580c;">🏷️ Valeur estimée</div>
  <div style="padding:20px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
      <div style="background:#f9fafb;border-radius:12px;padding:14px;text-align:center;">
        <p class="lbl" style="margin-bottom:5px;">Estimation basse</p>
        <p class="big"><%= number_to_currency(v["estimation_basse"], unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
      </div>
      <div style="background:#f9fafb;border-radius:12px;padding:14px;text-align:center;">
        <p class="lbl" style="margin-bottom:5px;">Estimation haute</p>
        <p class="big"><%= number_to_currency(v["estimation_haute"], unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
      </div>
    </div>
    <% if v["prix_acquisition"].present? %>
      <div class="row" style="padding:8px 0;">
        <p class="bod" style="color:#6b7280;">Prix d'achat</p>
        <p class="bod" style="font-weight:700;color:#6b7280;"><%= number_to_currency(v["prix_acquisition"], unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<%# ── RÉNOVATION ÉNERGÉTIQUE ──────────────────────────────── %>
<% if dpe_cur %>
<div class="cd" id="travaux">
  <div class="cd-hd" style="background:#059669;">⚡ Rénovation énergétique</div>
  <div style="padding:20px;">

    <% if %w[F G].include?(dpe_cur) %>
      <p class="bod" style="color:#dc2626;font-size:.82rem;margin-bottom:14px;">🚫 Ce logement ne peut plus être mis en location depuis le 1er janvier 2023.</p>
    <% elsif dpe_cur == "E" %>
      <p class="bod" style="color:#ea580c;font-size:.82rem;margin-bottom:14px;">⚠️ Interdiction de louer en 2028.</p>
    <% end %>

    <%# Jauge DPE : statique pour le visiteur artisan, interactive pour
         qui détient le dossier (propriétaire connecté ou claimant en cookie). %>
    <% if !can_see_full_dossier %>
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:20px;">
        <div style="text-align:center;">
          <div style="width:44px;height:44px;border-radius:10px;background:<%= dpe_colors[dpe_cur] %>;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:900;color:#fff;"><%= dpe_cur %></div>
          <p class="lbl" style="margin-top:4px;font-size:.6rem;">Actuel</p>
        </div>
        <% if dpe_cib && dpe_cib != dpe_cur %>
          <p style="font-size:1.3rem;color:#d1d5db;">→</p>
          <div style="text-align:center;">
            <div style="width:44px;height:44px;border-radius:10px;background:<%= dpe_colors[dpe_cib] || '#059669' %>;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:900;color:#fff;border:2px solid #059669;"><%= dpe_cib %></div>
            <p class="lbl" style="margin-top:4px;font-size:.6rem;color:#059669;">Objectif</p>
          </div>
        <% end %>
        <div style="flex:1;padding-left:4px;">
          <p class="bod" style="font-weight:700;"><%= dpe_labels[dpe_cur] %></p>
        </div>
      </div>

    <% else %>
      <%# Dossier complet (propriétaire OU claimant) : jauge interactive +
           slider caché qui écoute les changements. Glisser la jauge coche
           automatiquement les travaux nécessaires (par impact DPE décroissant).
           Décocher des travaux remonte la jauge estimée. %>
      <div style="position:relative;margin-bottom:6px;">
        <div style="display:flex;margin-bottom:4px;">
          <% dpe_all.each do |l| %>
            <div style="flex:1;text-align:center;">
              <% if l == dpe_cur %><span style="font-size:.6rem;font-weight:800;color:#ea580c;">▼ actuel</span><% end %>
            </div>
          <% end %>
        </div>
        <div class="dpe-track" id="dpe-track">
          <% dpe_all.each do |l| %>
            <div class="dpe-seg" style="background:<%= dpe_colors[l] %>;opacity:<%= l == dpe_cur ? '1' : '0.4' %>;"><%= l %></div>
          <% end %>
        </div>
        <div class="pin" id="pin-tgt" style="left:calc(<%= tgt_idx %>/7*100% + 1/14*100% - 16px);">
          <div class="pin-dot" style="background:<%= dpe_colors[dpe_all[tgt_idx]] || '#059669' %>;border-color:#059669;box-shadow:0 0 0 3px rgba(5,150,105,.3);" id="pin-tgt-dot"><%= dpe_all[tgt_idx] %></div>
        </div>
        <%# Slider HTML posé par-dessus la track A→G (7 segments).
             max=6 pour que chaque segment visuel corresponde à une position
             atteignable. Le clamp à cur_idx-1 (on ne peut pas cibler un DPE
             pire ou égal au DPE actuel) est fait en JS dans onSliderChange. %>
        <input type="range" id="dpe-slider"
               min="0" max="6" step="1"
               value="<%= tgt_idx %>"
               style="position:absolute;top:0;left:0;width:100%;height:48px;opacity:0;cursor:grab;margin:0;z-index:10;"
               oninput="onSliderChange(this.value)">
      </div>
      <p class="lbl" id="dpe-estim-lbl" style="text-align:center;margin-bottom:20px;color:#059669;font-size:.66rem;">
        Objectif : <span id="dpe-estim-val"><%= dpe_all[tgt_idx] %></span> · estimation indicative · glissez la jauge : les travaux s'ajustent à la cible
      </p>
    <% end %>

    <%# ── Formulaire checkboxes de travaux (dossier complet) ──
         Affiché aussi au claimant : la simulation côté client (DOM/JS) tourne
         sans persistance. Le submit "Mettre à jour les aides" est protégé en
         amont par authenticate_user! sur update_travaux_selection — un anonyme
         sera redirigé vers la page d'inscription/connexion, ce qui fait office
         de CTA naturel pour rattacher l'orpheline. %>
    <% if can_see_full_dossier && travaux_groupes.any? %>
      <%= form_with model: @property,
                    url: update_travaux_selection_property_path(@property),
                    method: :patch,
                    local: true,
                    html: { id: "form-travaux", autocomplete: "off" } do |f| %>

        <%# Hidden field qui porte la cible DPE courante (positionnée par le slider).
             Mis à jour en JS à chaque changement du slider et des checkboxes, pour
             que le controller persiste aussi dpe_target et que Grand Nancy
             rénovation globale bascule en "active" si cible A/B. -%>
        <%= hidden_field_tag "property[dpe_target]", (@property.dpe_target || dpe_all[tgt_idx]), id: "form-dpe-target" %>

        <%# Titre d'invitation explicite + actions rapides %>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;padding:10px 14px;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:10px;">
          <p class="bod" style="font-weight:700;color:#065f46;font-size:.88rem;">
            ☑️ Cochez les travaux que vous envisagez
          </p>
          <div style="display:flex;gap:6px;flex-shrink:0;">
            <button type="button" onclick="toggleAllTravaux(true)"
                    style="font-size:.7rem;font-weight:600;padding:5px 9px;border-radius:7px;background:#fff;color:#065f46;border:1px solid #a7f3d0;cursor:pointer;">
              Tout cocher
            </button>
            <button type="button" onclick="toggleAllTravaux(false)"
                    style="font-size:.7rem;font-weight:600;padding:5px 9px;border-radius:7px;background:#fff;color:#065f46;border:1px solid #a7f3d0;cursor:pointer;">
              Tout décocher
            </button>
          </div>
        </div>

        <% TravauxMapperService::CANONICAL_CODES.each do |code| %>
          <% next unless travaux_groupes[code] %>
          <% grp = travaux_groupes[code] %>
          <% mediane = ((grp[:cout_min] + grp[:cout_max]) / 2.0).round(-2).to_i %>
          <% coche = travaux_actifs.include?(code) %>
          <label class="travail-check <%= 'off' unless coche %>" data-code="<%= code %>" data-mediane="<%= mediane %>">
            <%= f.check_box code, { checked: coche, class: "travail-cb" }, "1", "0" %>
            <span style="font-size:1rem;flex-shrink:0;"><%= TravauxMapperService::EMOJIS[code] %></span>
            <span class="travail-label bod" style="font-weight:600;flex:1;"><%= TravauxMapperService::LABELS[code] %></span>
            <span class="bod" style="font-weight:700;white-space:nowrap;color:#374151;">
              ≈ <%= mediane.to_s.reverse.gsub(/(\d{3})(?=\d)/,'\\1 ').reverse %> €
            </span>
          </label>
        <% end %>

        <%# Budget total cohérent avec les cases cochées %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#f0fdf4;border-radius:10px;margin-top:10px;">
          <p class="lbl">Budget total estimé</p>
          <p style="font-size:1.1rem;font-weight:900;color:#065f46;" id="budget-val">
            ≈ <span id="budget-num"><%= budget_mediane.to_s.reverse.gsub(/(\d{3})(?=\d)/,'\\1 ').reverse %></span> €
          </p>
        </div>

        <%# Owner : vrai submit qui persiste la sélection et recharge la fiche
             avec @aid_result recalculé. Claimant : à la place, lien
             d'inscription — le submit serait intercepté par authenticate_user!
             et la sélection jetée au passage par sign-in (le POST n'est pas
             rejoué). Mieux vaut un CTA honnête qu'un bouton qui simule. %>
        <div style="display:flex;justify-content:flex-end;align-items:center;margin-top:12px;">
          <% if is_owner_connecte %>
            <%= f.submit "Mettre à jour les aides",
                  style:"font-size:.82rem;font-weight:700;padding:10px 16px;border-radius:8px;background:#059669;color:#fff;border:none;cursor:pointer;white-space:nowrap;" %>
          <% else %>
            <%= link_to "Créer un compte pour enregistrer mes ajustements →",
                  new_user_registration_path,
