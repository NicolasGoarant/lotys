      </div>

      <%# Slider invisible par-dessus %>
      <input type="range" id="dpe-slider" min="0" max="6" step="1" value="<%= tgt_idx %>"
             style="position:absolute;top:0;left:0;width:100%;height:48px;opacity:0;cursor:pointer;margin:0;z-index:10;"
             oninput="slideTgt(this.value)">
    </div>

<div style="margin-bottom:20px;display:none;"></div>

    <%# Travaux calculés %>
    <div id="trav-list"></div>

    <div style="background:#f9fafb;border-radius:10px;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;" id="budget-box" style="display:none;">
      <p class="lbl">Budget estimé</p>
      <p style="font-size:1.1rem;font-weight:900;color:#111;" id="budget-val">—</p>
    </div>
  </div>
</div>
<% end %>

<%# ── AIDES (national + local fusionnés) ─────────────────── %>
<% if e %>
<div class="cd">
  <div class="cd-hd" style="background:#5b21b6;">💶 Aides</div>
  <div style="padding:20px;">

    <%# Sélecteur revenus %>
    <p class="lbl" style="margin-bottom:8px;">Revenus annuels de votre foyer fiscal</p>
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:18px;">
      <% [["< 21k","tres_modeste",0],["21–30k","modeste",1],["30–45k","intermediaire",2],["> 45k","superieur",3]].each do |label,key,idx| %>
        <button onclick="setRev(<%= idx %>,'<%= key %>')"
                id="rev-<%= idx %>"
                style="padding:6px 10px;border-radius:8px;border:1.5px solid #e5e7eb;font-size:.78rem;font-weight:600;cursor:pointer;background:<%= @property.income_bracket.to_s == key ? '#ede9fe' : '#fff' %>;color:<%= @property.income_bracket.to_s == key ? '#5b21b6' : '#374151' %>;border-color:<%= @property.income_bracket.to_s == key ? '#5b21b6' : '#e5e7eb' %>;">
          <%= label %>
        </button>
      <% end %>
    </div>

    <%# 3 lignes d'aides nationales %>
    <div class="row">
      <p class="bod" style="font-weight:600;">🏛️ MaPrimeRénov'</p>
      <p class="bod" style="font-weight:800;" id="mpr-val"><%= mpr_montant > 0 ? number_to_currency(mpr_montant, unit:"€", format:"%n %u", precision:0, delimiter:" ") : "—" %></p>
    </div>
    <div class="row">
      <p class="bod" style="font-weight:600;">🔋 CEE</p>
      <p class="bod" style="font-weight:800;" id="cee-val"><%= cee_montant > 0 ? number_to_currency(cee_montant, unit:"€", format:"%n %u", precision:0, delimiter:" ") : "—" %></p>
    </div>
    <%# Reste %>
    <div style="background:#ede9fe;border-radius:10px;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;margin-top:14px;margin-bottom:16px;">
      <p class="bod" style="font-weight:700;color:#5b21b6;">💰 Reste à financer</p>
      <p style="font-size:1.1rem;font-weight:900;color:#5b21b6;" id="reste-val"><%= reste > 0 ? number_to_currency(reste, unit:"€", format:"%n %u", precision:0, delimiter:" ") : budget_max > 0 ? "0 €" : "—" %></p>
    </div>


  </div>
</div>
<% end %>

<%# ── FINANCEMENT ──────────────────────────────────────────── %>
<% if e %>
<div class="cd">
  <div class="cd-hd" style="background:#1d4ed8;">🏦 Financement</div>
  <div style="padding:20px;">
    <div class="row">
      <div>
        <p class="bod" style="font-weight:600;">🏦 Éco-PTZ</p>
        <p class="lbl" style="margin-top:2px;">Prêt à 0% · Sans condition de ressources · Cumulable MPR</p>
      </div>
      <p class="bod" style="font-weight:800;">jusqu'à <%= number_to_currency(eco_ptz, unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
    </div>
    <div class="row">
      <div>
        <p class="bod" style="font-weight:600;">🏗️ Prêt travaux classique</p>
        <p class="lbl" style="margin-top:2px;">Taux variable selon profil bancaire</p>
      </div>
      <p class="bod" style="color:#6b7280;">à négocier</p>
    </div>
    <div style="margin-top:16px;">
      <div style="background:#eff6ff;border-radius:10px;padding:10px 14px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;">
        <p class="bod" style="font-size:.82rem;color:#1e3a8a;font-weight:600;">Simulation sur le reste à financer</p>
        <p class="bod" style="font-weight:800;color:#1e3a8a;" id="fin-reste-lbl"><%= reste > 0 ? number_to_currency(reste, unit:"€", format:"%n %u", precision:0, delimiter:" ") : "—" %></p>
