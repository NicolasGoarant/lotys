<%# Bannière de prévisualisation %>
<div class="sticky top-0 z-50 bg-amber-50 border-b-2 border-amber-300 px-4 py-3 mb-6">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div>
      <p class="font-bold text-amber-800 text-sm">👁️ Mode prévisualisation — voici ce que verront les prestataires</p>
      <p class="text-amber-700 text-xs mt-0.5">Votre adresse, vos documents, vos offres reçues et votre plan de financement ne sont pas visibles.</p>
    </div>
    <div class="flex gap-2 shrink-0">
      <%= link_to "← Annuler", @property, class: "border border-amber-300 text-amber-800 bg-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-amber-50" %>
      <%= button_to "📢 Confirmer la publication", publish_property_path(@property),
          class: "bg-emerald-600 text-white px-5 py-2 rounded-xl text-sm font-bold hover:bg-emerald-700" %>
    </div>
  </div>
</div>

<div class="mx-auto w-full max-w-6xl px-3 sm:px-4 lg:px-6 pb-8">

<%# Header tiers %>
<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between mb-6">
  <div>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">
      <%= [@property.property_type&.capitalize, @property.construction_year ? "de #{@property.construction_year}" : nil].compact.join(" ") %>
      <% if @property.surface %> · <%= @property.surface %> m²<% end %>
    </h1>
    <p class="text-gray-500"><%= @property.city %><% if @property.is_copropriete %> · Copropriété <%= @property.nb_lots %> lots<% end %></p>
  </div>
  <div class="flex gap-2">
    <span class="text-xs px-3 py-1 rounded-full font-semibold bg-gray-100 text-gray-500">Aperçu prestataire</span>
  </div>
</div>

<%# Fiche identité — version tiers (sans adresse précise) %>
<% parsed_for_id = (@property.analysis&.content.present? ? (JSON.parse(@property.analysis.content) rescue nil) : nil) %>
<% dpe_colors = { "A"=>"#16a34a","B"=>"#22c55e","C"=>"#84cc16","D"=>"#eab308","E"=>"#f97316","F"=>"#ea580c","G"=>"#dc2626" } %>
<% dpe_labels = { "A"=>"Très performant","B"=>"Performant","C"=>"Assez performant","D"=>"Peu performant","E"=>"Énergivore","F"=>"Très énergivore","G"=>"Passoire thermique" } %>

<div class="bg-white rounded-2xl overflow-hidden mb-8 shadow-md" style="border:2px solid #e2e8f0; border-top:4px solid #475569;">
  <div class="flex items-start gap-3 sm:gap-4 px-4 sm:px-6 pt-4 sm:pt-6 pb-4 sm:pb-5 border-b-2 border-gray-100 bg-gray-50">
    <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=200&q=80&auto=format&fit=crop" alt="" class="w-16 h-16 sm:w-24 sm:h-24 rounded-xl object-cover shadow-sm flex-shrink-0">
    <div>
      <h2 class="font-black text-gray-900 text-lg sm:text-2xl leading-tight">📋 Identité du bien</h2>
      <p class="text-gray-500 text-sm"><%= @property.city %><% if @property.zipcode %> <%= @property.zipcode %><% end %></p>
    </div>
  </div>
  <div class="p-4 sm:p-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 text-sm mb-3">
      <div class="bg-gray-50 rounded-xl p-3 sm:p-4 text-center">
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wide mb-1">Type</p>
        <p class="font-bold text-gray-900"><%= @property.property_type&.capitalize || "—" %></p>
      </div>
      <div class="bg-gray-50 rounded-xl p-3 sm:p-4 text-center">
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wide mb-1">Surface</p>
        <p class="font-bold text-gray-900"><%= @property.surface ? "#{@property.surface} m²" : "—" %></p>
      </div>
      <div class="bg-gray-50 rounded-xl p-3 sm:p-4 text-center">
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wide mb-1">Construction</p>
        <p class="font-bold text-gray-900"><%= @property.construction_year || "—" %></p>
      </div>
      <div class="bg-gray-50 rounded-xl p-3 sm:p-4 text-center">
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wide mb-1">Pièces</p>
        <p class="font-bold text-gray-900"><%= @property.nb_rooms || "—" %></p>
      </div>
      <div class="bg-gray-50 rounded-xl p-3 sm:p-4 text-center">
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wide mb-1">Copropriété</p>
        <p class="font-bold text-gray-900"><%= @property.is_copropriete ? "Oui (#{@property.nb_lots} lots)" : "Non" %></p>
      </div>
      <div class="bg-gray-50 rounded-xl p-3 sm:p-4 text-center">
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wide mb-1">DPE</p>
        <% dpe_val = @property.dpe_class %>
        <% if dpe_val %>
          <span style="background:<%= dpe_colors[dpe_val.upcase] || '#6b7280' %>;" class="inline-block px-3 py-1 rounded-lg text-white font-black text-lg"><%= dpe_val.upcase %></span>
        <% else %>
          <p class="font-bold text-gray-900">—</p>
        <% end %>
      </div>
    </div>
    <% if @property.description.present? %>
      <div class="bg-gray-50 rounded-xl p-4 mb-3">
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wide mb-1">Contexte</p>
        <p class="text-gray-800 text-base leading-relaxed"><%= @property.description %></p>
      </div>
    <% end %>
    <% dpe_display = @property.dpe_class %>
    <% if dpe_display %>
      <div class="border-t border-gray-100 pt-4 mt-1">
        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wide mb-3">⚡ Performance énergétique</p>
        <div class="flex items-center gap-4 flex-wrap">
          <div class="flex items-center justify-center rounded-xl text-white font-black text-4xl shadow-md"
               style="background:<%= dpe_colors[dpe_display.upcase] || '#6b7280' %>; width:72px; height:72px;">
            <%= dpe_display.upcase %>
          </div>
          <div>
            <p class="text-lg font-bold text-gray-900"><%= dpe_labels[dpe_display.upcase] %></p>
            <% if %w[F G].include?(dpe_display.upcase) %>
              <p class="text-sm text-red-600 mt-0.5 font-semibold">⚠️ Ce logement ne peut plus être mis en location.</p>
            <% elsif dpe_display.upcase == "E" %>
              <p class="text-sm text-orange-600 mt-0.5 font-semibold">⚠️ Interdiction de louer prévue en 2028.</p>
            <% end %>
          </div>
          <div class="flex gap-1 ml-auto">
            <% %w[A B C D E F G].each do |letter| %>
              <div style="background:<%= dpe_colors[letter] %>; opacity:<%= letter == dpe_display.upcase ? '1' : '0.3' %>; width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-weight:900; font-size:0.75rem; color:#fff;">
                <%= letter %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# Analyse IA visible par les tiers %>
<% if @property.analysis&.content.present? %>
  <% parsed = (JSON.parse(@property.analysis.content) rescue nil) %>
  <% if parsed %>
    <% e = parsed&.[]("energie") %>
    <% if e %>
    <% dpe_hex2 = {"A"=>"#16a34a","B"=>"#22c55e","C"=>"#84cc16","D"=>"#eab308","E"=>"#f97316","F"=>"#ea580c","G"=>"#dc2626"} %>
    <div class="rounded-2xl overflow-hidden mb-8 bg-white" style="border:2px solid #e2e8f0; border-top:4px solid #ea580c; box-shadow:0 4px 16px rgba(0,0,0,0.08);">
      <div class="flex items-start gap-3 sm:gap-4 px-4 sm:px-6 pt-4 sm:pt-6 pb-4 sm:pb-5 border-b-2 border-gray-100 bg-gray-50">
        <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=200&q=80&auto=format&fit=crop" alt="" class="w-16 h-16 sm:w-24 sm:h-24 rounded-xl object-cover shadow-sm flex-shrink-0">
        <div class="flex-1 flex items-center justify-between">
          <h2 class="font-black text-gray-900 text-lg sm:text-2xl leading-tight">⚡ <%= e["titre"] %></h2>
          <% if e["urgence"] == "haute" %>
            <span style="background:#ef4444;color:#fff;" class="text-sm px-3 py-1.5 rounded-full font-bold">⚠️ Urgence réglementaire</span>
          <% end %>
        </div>
      </div>
      <div class="bg-white p-6">
        <div class="flex items-center gap-4 mb-5 flex-wrap">
          <span class="text-gray-700 text-sm font-semibold">DPE estimé :</span>
          <span style="background:<%= dpe_hex2[e['dpe_estime']] || '#9ca3af' %>;" class="px-4 py-1.5 rounded-lg text-white font-black text-xl"><%= e["dpe_estime"] %></span>
          <span class="text-gray-400 text-2xl">→</span>
          <span class="text-gray-700 text-sm font-semibold">Objectif :</span>
          <span style="background:<%= dpe_hex2[e['dpe_cible']] || '#9ca3af' %>;" class="px-4 py-1.5 rounded-lg text-white font-black text-xl"><%= e["dpe_cible"] %></span>
        </div>
        <p class="text-gray-800 leading-relaxed mb-5"><%= e["analyse"] %></p>
        <% if e["travaux"].present? %>
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Travaux envisagés</p>
          <div class="space-y-2">
            <% e["travaux"].sort_by{|t| t["priorite"].to_i}.each do |t| %>
              <div class="flex items-center justify-between bg-gray-50 rounded-xl px-4 py-3">
                <div class="flex items-center gap-3">
                  <span class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black flex items-center justify-center"><%= t["priorite"] %></span>
                  <div>
                    <p class="text-sm font-bold text-gray-900"><%= t["poste"] %></p>
                    <p class="text-xs text-emerald-700"><%= t["gain_dpe"] %></p>
                  </div>
                </div>
                <p class="text-sm font-bold text-gray-700 shrink-0"><%= number_to_currency(t["cout_min"], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %> – <%= number_to_currency(t["cout_max"], unit: "€", format: "%n %u", precision: 0, delimiter: " ") %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>
  <% end %>
<% end %>

<%# Bouton Faire une proposition %>
<div class="text-center py-6">
  <%= link_to "📩 Faire une proposition", new_property_offer_path(@property),
      class: "bg-emerald-600 text-white px-10 py-4 rounded-2xl hover:bg-emerald-700 font-bold text-lg shadow-md" %>
  <p class="text-xs text-gray-400 mt-3">Votre identité n'est pas visible du propriétaire avant qu'il accepte votre offre.</p>
</div>

</div>
