<% if property.analyzing? %>
  <div id="analysis-status"
       data-controller="poll"
       data-poll-url-value="<%= property_path(property, format: :json) %>"
       data-poll-interval-value="3000"
       style="background:#fefce8;border:1.5px solid #fde68a;border-radius:14px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:12px;">
    <div style="width:20px;height:20px;border:3px solid #f59e0b;border-top-color:transparent;border-radius:50%;animation:spin 1s linear infinite;flex-shrink:0;"></div>
    <div>
      <p style="font-weight:800;font-size:.9rem;color:#92400e;margin:0 0 2px;">Analyse en cours…</p>
      <p style="font-size:.78rem;color:#b45309;margin:0;">Lecture des documents, estimation DVF, calcul des aides. Prêt dans ~30 secondes.</p>
    </div>
  </div>
  <style>@keyframes spin{to{transform:rotate(360deg)}}</style>
<% elsif property.draft? && (property.surface.blank? || property.dpe_class.blank?) %>
  <% manquants = [] %>
  <% manquants << "surface" if property.surface.blank? %>
  <% manquants << "classe DPE" if property.dpe_class.blank? %>
  <div style="background:#fff7ed;border:1.5px solid #fed7aa;border-radius:14px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:flex-start;gap:12px;">
    <div style="font-size:1.4rem;flex-shrink:0;line-height:1;">⚠️</div>
    <div style="flex:1;">
      <p style="font-weight:800;font-size:.9rem;color:#9a3412;margin:0 0 4px;">Analyse incomplète</p>
      <p style="font-size:.78rem;color:#c2410c;margin:0 0 8px;">
        L'extraction automatique n'a pas pu déterminer <%= manquants.to_sentence %>. Complétez ces champs pour débloquer le calcul des aides et la publication.
      </p>
      <%= link_to "Compléter manuellement", edit_property_path(property),
                  style: "display:inline-block;font-size:.78rem;font-weight:700;padding:6px 12px;border-radius:8px;background:#c2410c;color:#fff;text-decoration:none;" %>
    </div>
  </div>
<% end %>
