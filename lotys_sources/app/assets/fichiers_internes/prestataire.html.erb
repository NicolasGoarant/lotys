<%# app/views/properties/prestataire.html.erb
    Vue dédiée aux prestataires (artisans, banquiers, courtiers)
    Accessible depuis la carte home via le popup marker %>

<% parsed  = @property.analysis&.content.present? ? (JSON.parse(@property.analysis.content) rescue nil) : nil %>
<% e       = parsed&.[]("energie") %>
<% v       = parsed&.[]("valeur") %>
<% i_      = parsed&.[]("idees") %>

<% dpe_colors = {"A"=>"#16a34a","B"=>"#4ade80","C"=>"#a3e635","D"=>"#ca8a04","E"=>"#fb923c","F"=>"#ef4444","G"=>"#991b1b"} %>
<% dpe_labels = {"A"=>"Très performant","B"=>"Performant","C"=>"Assez performant","D"=>"Peu performant","E"=>"Énergivore","F"=>"Très énergivore","G"=>"Passoire thermique"} %>
<% dpe_cur = (@property.dpe_class || e&.[]("dpe_estime"))&.upcase %>
<% dpe_cib = e&.[]("dpe_cible")&.upcase %>
<% travaux = (e&.[]("travaux") || []).sort_by{|t| t["priorite"].to_i} %>

<style>
  .pr { max-width:580px; margin:0 auto; padding:20px 14px 60px;
        font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  .lbl { font-size:.68rem; font-weight:700; color:#9ca3af;
         text-transform:uppercase; letter-spacing:.07em; }
  .bod { font-size:.88rem; color:#374151; line-height:1.6; }
  .big { font-size:1.6rem; font-weight:900; color:#111; line-height:1; }
  .cd  { background:#fff; border-radius:18px; border:1px solid #e5e7eb;
         box-shadow:0 2px 14px rgba(0,0,0,.07); margin-bottom:24px; overflow:hidden; }
  .cd-hd { padding:13px 20px; font-size:.75rem; font-weight:800;
            text-transform:uppercase; letter-spacing:.09em; color:#fff; }
  .row { display:flex; justify-content:space-between; align-items:baseline;
         gap:12px; padding:11px 0; border-bottom:1px solid #f3f4f6; }
  .row:last-child { border-bottom:none; }
  .row p:last-child { white-space:nowrap; flex-shrink:0; }
  .cta { display:block; text-align:center; background:#059669; color:#fff;
         font-size:1rem; font-weight:800; padding:16px; border-radius:14px;
         text-decoration:none; margin-top:8px; transition:background .15s; }
  .cta:hover { background:#047857; }
  .badge { display:inline-flex; align-items:center; justify-content:center;
           width:36px; height:36px; border-radius:9px; font-size:1rem;
           font-weight:900; color:#fff; flex-shrink:0; }
</style>

<div class="pr">

  <%# ── HEADER BIEN ─────────────────────────────────────────── %>
  <div class="cd">
    <% photo_url = @property.property_type == "maison" ?
         "https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=800&q=80" :
         "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=800&q=80" %>
    <div style="position:relative;height:200px;overflow:hidden;">
      <img src="<%= photo_url %>" alt=""
           style="width:100%;height:100%;object-fit:cover;display:block;">
      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(15,23,42,.9) 0%,rgba(15,23,42,.3) 60%,transparent 100%);"></div>
      <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 20px;">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:10px;">
          <div>
            <p class="lbl" style="color:rgba(255,255,255,.55);margin:0 0 3px;"><%= @property.city %></p>
            <h1 style="font-size:1.3rem;font-weight:900;color:#fff;margin:0 0 4px;line-height:1.2;"><%= @property.address %></h1>
            <p style="font-size:.9rem;font-weight:600;color:rgba(255,255,255,.8);">
              <%= @property.property_type&.capitalize %>
              <% if @property.nb_rooms %> · T<%= @property.nb_rooms %><% end %>
              · <%= @property.surface %> m²
              <% if @property.construction_year %> · <%= @property.construction_year %><% end %>
            </p>
          </div>
          <% if dpe_cur %>
            <div class="badge" style="background:<%= dpe_colors[dpe_cur] %>;"><%= dpe_cur %></div>
          <% end %>
        </div>
      </div>
    </div>
    <%# Lien retour %>
    <div style="padding:10px 18px;">
      <%= link_to "← Retour à la carte", root_path,
          style:"font-size:.78rem;font-weight:600;color:#6b7280;text-decoration:none;" %>
    </div>
  </div>

  <%# ── CE QUE LE PROPRIÉTAIRE RECHERCHE ───────────────────── %>
  <div class="cd">
    <div class="cd-hd" style="background:#1e293b;">📋 Le dossier</div>
    <div style="padding:18px 20px;">
      <% if dpe_cur %>
        <div style="display:flex;align-items:center;gap:12px;padding:12px;background:#f9fafb;border-radius:12px;margin-bottom:14px;">
          <div class="badge" style="background:<%= dpe_colors[dpe_cur] %>;"><%= dpe_cur %></div>
          <div style="flex:1;">
            <p class="lbl" style="margin-bottom:2px;">DPE actuel</p>
            <p class="bod" style="font-weight:700;"><%= dpe_labels[dpe_cur] %></p>
          </div>
          <% if dpe_cib %>
            <p style="font-size:1.2rem;color:#d1d5db;">→</p>
            <div class="badge" style="background:<%= dpe_colors[dpe_cib] || '#059669' %>;border:2px solid #059669;"><%= dpe_cib %></div>
            <div>
              <p class="lbl" style="margin-bottom:2px;">Objectif</p>
              <p class="bod" style="font-weight:700;color:#059669;"><%= dpe_labels[dpe_cib] %></p>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Travaux identifiés %>
      <% if travaux.any? %>
        <p class="lbl" style="margin-bottom:8px;">Travaux identifiés</p>
        <% travaux.each do |t| %>
          <div class="row">
            <p class="bod" style="font-weight:600;"><%= t["poste"] %></p>
            <p class="bod" style="font-weight:700;color:#374151;"><%= t["cout_min"].to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/,'\\1 ').reverse %> – <%= t["cout_max"].to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/,'\\1 ').reverse %> €</p>
          </div>
        <% end %>
        <% budget_min = travaux.sum{|t| t["cout_min"].to_i} %>
        <% budget_max = travaux.sum{|t| t["cout_max"].to_i} %>
        <div style="background:#f0fdf4;border-radius:10px;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;margin-top:10px;">
          <p class="lbl">Budget total estimé</p>
          <p style="font-size:1.1rem;font-weight:900;color:#065f46;"><%= budget_min.to_s.reverse.gsub(/(\d{3})(?=\d)/,'\\1 ').reverse %> – <%= budget_max.to_s.reverse.gsub(/(\d{3})(?=\d)/,'\\1 ').reverse %> €</p>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── VALEUR DU BIEN ──────────────────────────────────────── %>
  <% if v %>
  <div class="cd">
    <div class="cd-hd" style="background:#ea580c;">🏷️ Valeur du bien</div>
    <div style="padding:18px 20px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div style="background:#f9fafb;border-radius:12px;padding:14px;text-align:center;">
          <p class="lbl" style="margin-bottom:5px;">Estimation basse</p>
          <p class="big" style="font-size:1.3rem;"><%= number_to_currency(v["estimation_basse"], unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
        </div>
        <div style="background:#f9fafb;border-radius:12px;padding:14px;text-align:center;">
          <p class="lbl" style="margin-bottom:5px;">Estimation haute</p>
          <p class="big" style="font-size:1.3rem;"><%= number_to_currency(v["estimation_haute"], unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
        </div>
      </div>
      <% if v["prix_acquisition"].present? %>
        <div class="row" style="margin-top:8px;">
          <p class="bod" style="color:#6b7280;">Prix d'achat</p>
          <p class="bod" style="font-weight:700;color:#6b7280;"><%= number_to_currency(v["prix_acquisition"], unit:"€", format:"%n %u", precision:0, delimiter:" ") %></p>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <%# ── AUTRES PISTES (pour les prestataires) ───────────────── %>
  <% if i_ && i_["scenarios"].present? %>
  <div class="cd">
    <div class="cd-hd" style="background:#b45309;">💡 Opportunités</div>
    <div style="padding:0 20px;">
      <% i_["scenarios"].each do |s| %>
        <div class="row" style="gap:12px;">
          <span style="font-size:1.1rem;flex-shrink:0;"><%= s["emoji"] %></span>
          <div style="flex:1;">
            <p class="bod" style="font-weight:700;font-size:.85rem;"><%= s["titre"] %></p>
            <p class="lbl" style="margin-top:1px;"><%= s["gain_estime"] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <%# ── CTA FAIRE UNE PROPOSITION ───────────────────────────── %>
  <div style="padding:0 0 20px;">
    <% if user_signed_in? %>
      <%= link_to "📩 Faire une proposition", new_property_offer_path(@property),
          class: "cta" %>
    <% else %>
      <p class="lbl" style="text-align:center;margin-bottom:10px;">Vous devez être connecté pour faire une proposition</p>
      <%= link_to "Se connecter pour proposer →", new_user_session_path,
          class: "cta", style: "background:#1d4ed8;" %>
    <% end %>
    <p class="bod" style="text-align:center;color:#9ca3af;font-size:.72rem;margin-top:10px;">
      Le propriétaire recevra votre proposition et pourra vous contacter.
    </p>
  </div>

</div>
