<% return unless property.analysis.present? %>

<div class="mb-8 space-y-4 sm:space-y-6">
  <div class="grid grid-cols-2 gap-3 sm:gap-4">
    <div class="rounded-2xl border border-gray-200 bg-white p-4 sm:p-6 shadow-sm">
      <p class="text-xs sm:text-sm font-medium text-gray-500">Score énergie</p>
      <p class="mt-2 text-2xl sm:text-4xl font-black text-gray-900 leading-none">
        <%= property.analysis.score_energie || "—" %>
        <span class="text-sm sm:text-lg font-semibold text-gray-400">/100</span>
      </p>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-4 sm:p-6 shadow-sm">
      <p class="text-xs sm:text-sm font-medium text-gray-500">Score patrimonial</p>
      <p class="mt-2 text-2xl sm:text-4xl font-black text-gray-900 leading-none">
        <%= property.analysis.score_patrimonial || "—" %>
        <span class="text-sm sm:text-lg font-semibold text-gray-400">/100</span>
      </p>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-4 sm:p-6 shadow-sm">
    <h3 class="text-lg sm:text-xl font-bold text-gray-900">Timeline travaux</h3>

    <% if property.analysis.travaux_timeline.present? %>
      <div class="mt-4 space-y-3 sm:space-y-4">
        <% property.analysis.travaux_timeline.each do |step| %>
          <div class="rounded-xl bg-gray-50 p-3 sm:p-4">
            <p class="font-semibold text-gray-900 text-sm sm:text-base"><%= step["annee"] %></p>
            <ul class="mt-2 list-disc pl-4 sm:pl-5 text-sm text-gray-700 space-y-1">
              <% Array(step["actions"]).each do |action| %>
                <li><%= action %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-gray-500">Aucune timeline disponible.</p>
    <% end %>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-4 sm:p-6 shadow-sm">
    <h3 class="text-lg sm:text-xl font-bold text-gray-900">Valeur après travaux</h3>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div>
        <p class="text-xs sm:text-sm text-gray-500">Valeur actuelle</p>
        <p class="text-xl sm:text-2xl font-bold text-gray-900">
          <%= number_to_currency(property.valuation&.estimated_value || 0, unit: "€", precision: 0, delimiter: " ") %>
        </p>
      </div>

      <div>
        <p class="text-xs sm:text-sm text-gray-500">Valeur après travaux</p>
        <p class="text-xl sm:text-2xl font-bold text-emerald-600">
          <%= property.analysis.estimated_value_after_works.present? ? number_to_currency(property.analysis.estimated_value_after_works, unit: "€", precision: 0, delimiter: " ") : "—" %>
        </p>
      </div>

      <div>
        <p class="text-xs sm:text-sm text-gray-500">Gain estimé</p>
        <p class="text-xl sm:text-2xl font-bold text-gray-900">
          <%= property.analysis.estimated_gain_after_works.present? ? number_to_currency(property.analysis.estimated_gain_after_works, unit: "€", precision: 0, delimiter: " ") : "—" %>
        </p>
      </div>
    </div>
  </div>
</div>
