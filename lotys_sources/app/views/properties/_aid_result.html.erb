<%# app/views/properties/_aid_result.html.erb
    Partial rendu dans le turbo_frame "aid_result"
    Utilisé par : show.html.erb + update_income_bracket -%>

<%= turbo_frame_tag "aid_result", class: "block" do %>
<div class="bg-white rounded-2xl overflow-hidden mb-10" style="border:1px solid #bbf7d0; box-shadow:0 4px 20px rgba(5,150,105,0.1);">
  <div class="px-6 py-5 border-b border-emerald-700" style="background:#059669;">
    <div class="flex items-center gap-3">
      <span class="w-8 h-8 rounded-xl bg-white/20 text-white font-black text-base flex items-center justify-center shrink-0">3</span>
      <p class="text-base font-black text-white uppercase tracking-wide">Étape 3 — Les aides</p>
    </div>
  </div>

  <div class="p-5">

    <%# Sélecteur de profil revenus — un clic persiste income_bracket %>
    <p class="text-sm font-semibold text-gray-700 mb-3">Vos revenus annuels (foyer fiscal) :</p>
    <div class="grid grid-cols-2 gap-2 mb-4">
      <% [
        ["tres_modeste",  "Très modestes",   "< 21 000 €/an"],
        ["modeste",       "Modestes",        "21 000 – 30 000 €"],
        ["intermediaire", "Intermédiaires",  "30 000 – 45 000 €"],
        ["superieur",     "Supérieurs",      "> 45 000 €"]
      ].each do |val, label, sublabel| %>
        <% active = property.income_bracket == val %>
        <%= button_to update_income_bracket_property_path(property),
              method: :patch,
              params: { income_bracket: val },
              data: { turbo_frame: "aid_result" },
              class: "profil-btn px-4 py-3 rounded-xl text-sm font-bold border-2 text-left transition-all w-full
                #{active ? 'border-emerald-500 bg-emerald-50 text-emerald-800' : 'border-gray-200 text-gray-600 hover:border-emerald-400'}" do %>
          <%= label %><br><span class="font-normal text-xs opacity-70"><%= sublabel %></span>
        <% end %>
      <% end %>
    </div>

    <% if aid_result && aid_result[:subventions].any? %>

      <%# Subventions calculées côté serveur (taux 2026 réels) %>
      <div class="space-y-2 mb-4">
        <% aid_result[:subventions].each do |aid| %>
          <% bg = case aid[:type]
               when "mpr"   then "bg-emerald-50 border-emerald-200"
               when "local" then "bg-teal-50 border-teal-200"
               when "cee"   then "bg-amber-50 border-amber-200"
               else              "bg-gray-50 border-gray-200"
             end %>
          <div class="flex items-start justify-between rounded-xl px-4 py-3 border <%= bg %>">
            <div class="flex-1 mr-3">
              <p class="font-semibold text-gray-800 text-sm"><%= aid[:name].split("—").first.strip %></p>
              <% if aid[:basis].present? %>
                <p class="text-xs text-gray-400 mt-0.5"><%= aid[:basis] %></p>
              <% end %>
              <% if aid[:note].present? %>
                <p class="text-xs text-orange-600 mt-0.5">ℹ️ <%= aid[:note] %></p>
              <% end %>
            </div>
            <p class="font-black text-gray-900 text-base shrink-0"><%= number_to_currency(aid[:amount], unit: "€", format: "%n %u", precision: 0) %></p>
          </div>
        <% end %>
      </div>

      <% if aid_result[:errors].any? %>
        <div class="space-y-1 mb-4">
          <% aid_result[:errors].each do |err| %>
            <p class="text-xs text-amber-700 bg-amber-50 rounded-lg px-3 py-2">⚠️ <%= err %></p>
          <% end %>
        </div>
      <% end %>

    <% elsif property.income_bracket.blank? %>
      <p class="text-sm text-gray-400 italic mb-4">Sélectionnez votre profil de revenus pour calculer vos aides.</p>
    <% else %>
      <p class="text-sm text-gray-400 italic mb-4">Aucune aide calculable pour ce bien. Vérifiez que l'analyse IA a bien été lancée.</p>
    <% end %>

    <%# Aides locales Grand Nancy %>
    <%= render "local_aids", property: property %>

    <%# Reste à charge %>
    <% total_subventions = aid_result ? aid_result[:total_subventions].to_i : 0 %>
    <% cout_travaux = property.device_simulation ? (property.device_simulation.total_aid_estimate * 1.8).round(-2) : (property.surface.to_f * 600).round(-2) %>
    <% reste_a_charge = [cout_travaux - total_subventions, 0].max %>
    <div class="flex items-center justify-between rounded-xl px-5 py-4 mt-3 text-white" style="background:#f0fdf4; border:1px solid #bbf7d0;">
      <div>
        <p class="font-bold text-lg text-emerald-800">Reste à financer</p>
        <p class="text-emerald-600 text-sm">Coût travaux − subventions</p>
      </div>
      <p class="font-black text-2xl text-emerald-800">
        <%= total_subventions > 0 ? number_to_currency(reste_a_charge, unit: "€", format: "%n %u", precision: 0) : "—" %>
      </p>
    </div>

    <p class="text-xs text-gray-400 mt-3">⚠️ Estimations indicatives 2026 basées sur les règles ANAH en vigueur.</p>
  </div>
</div>
<% end %><%# /turbo_frame %>
