<%# app/views/documents/new.html.erb %>
<% content_for :title, "Ajouter des documents" %>

<div class="mx-auto w-full max-w-2xl px-4 py-6">

  <%# En-tête %>
  <div class="mb-6">
    <%= link_to "← Retour au dossier", @property, class: "text-sm text-gray-400 hover:text-emerald-600 transition" %>
    <h1 class="text-2xl font-black text-gray-900 mt-3">Ajouter des documents</h1>
    <p class="text-sm text-gray-400 mt-0.5">
      <%= @property.address %>, <%= @property.city %> —
      DPE, titre de propriété, devis, PV d'AG…
    </p>
  </div>

  <%# Flash %>
  <% if flash[:alert] || flash.now[:alert] %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-5">
      <p class="text-sm text-red-700">⚠️ <%= flash[:alert] || flash.now[:alert] %></p>
    </div>
  <% end %>

  <%# Formulaire %>
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">📎 Nouveau document</p>
    </div>
    <div class="p-5">
      <%= form_with model: [@property, @document], multipart: true, id: "doc-form" do |f| %>

        <%# Type de document %>
        <div class="mb-5">
          <%= f.label :document_type, "Type de document", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="type-selector">
            <% [
              ["dpe",             "📊 DPE"],
              ["titre_propriete", "📜 Titre de propriété"],
              ["pv_ag",           "🏢 PV d'assemblée"],
              ["devis",           "🔨 Devis artisan"],
              ["photo",           "📷 Photo"],
              ["autre",           "📄 Autre"]
            ].each do |val, label| %>
              <% active = @document.document_type == val || (val == "dpe" && @document.document_type.blank?) %>
              <label class="type-btn flex items-center gap-2 px-3 py-2.5 rounded-xl border-2 cursor-pointer text-sm font-semibold transition-all
                <%= active ? 'border-emerald-500 bg-emerald-50 text-emerald-800' : 'border-gray-200 text-gray-600 hover:border-emerald-300' %>">
                <%= f.radio_button :document_type, val, class: "hidden type-radio", checked: active %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </div>

        <%# Zone de dépôt %>
        <%= f.file_field :files, multiple: true, name: "document[files][]",
            accept: ".pdf,.jpg,.jpeg,.png",
            id: "file-input", class: "hidden" %>

        <div id="drop-zone"
             onclick="document.getElementById('file-input').click()"
             class="border-2 border-dashed border-emerald-300 rounded-2xl p-10 text-center cursor-pointer hover:border-emerald-500 hover:bg-emerald-50 transition-all">
          <div class="text-5xl mb-3">📄</div>
          <p class="font-bold text-gray-800 text-lg">Cliquez pour choisir vos fichiers</p>
          <p class="text-sm text-gray-400 mt-1">PDF, JPG, PNG · Plusieurs fichiers possibles</p>
          <p id="file-names" class="text-sm text-emerald-700 font-semibold mt-3 hidden"></p>
        </div>

        <%# Barre de progression %>
        <div id="upload-progress" class="hidden mt-4">
          <div class="flex items-center gap-3 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3">
            <div class="w-5 h-5 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin shrink-0"></div>
            <div>
              <p class="text-sm font-semibold text-emerald-800">Envoi en cours…</p>
              <p class="text-xs text-emerald-600 mt-0.5">L'analyse IA se relance automatiquement après l'upload.</p>
            </div>
          </div>
        </div>

      <% end %>
    </div>
  </div>

  <%# Documents déjà uploadés %>
  <% if @property.documents.any? %>
    <div class="mt-6">
      <p class="text-sm font-bold text-gray-600 mb-3">Documents déjà ajoutés</p>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm divide-y divide-gray-50 overflow-hidden">
        <% @property.documents.order(created_at: :desc).each do |doc| %>
          <div class="flex items-center gap-3 px-5 py-3 group">
            <% icon = case doc.document_type
               when "dpe" then "📊"
               when "titre_propriete" then "📜"
               when "pv_ag" then "🏢"
               when "devis" then "🔨"
               when "photo" then "📷"
               else "📄"
               end %>
            <span class="text-xl shrink-0"><%= icon %></span>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-gray-800 truncate"><%= doc.name.presence || doc.document_type.humanize %></p>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="text-xs text-gray-400"><%= doc.document_type.humanize %></span>
                <% if doc.processed? %>
                  <span class="text-xs text-emerald-600">✓ Analysé</span>
                <% end %>
                <span class="text-xs text-gray-300"><%= doc.created_at.strftime("%d/%m/%Y") %></span>
              </div>
            </div>
            <%= button_to "✕ Supprimer",
                property_document_path(@property, doc),
                method: :delete,
                class: "text-xs text-gray-300 hover:text-red-500 hover:bg-red-50 px-3 py-1.5 rounded-lg transition opacity-0 group-hover:opacity-100 shrink-0",
                data: { confirm: "Supprimer ce document ?", turbo: false } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>

<script>
// Sélection visuelle du type
document.querySelectorAll('.type-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.type-btn').forEach(function(b) {
      b.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-800');
      b.classList.add('border-gray-200', 'text-gray-600');
    });
    this.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-800');
    this.classList.remove('border-gray-200', 'text-gray-600');
    this.querySelector('.type-radio').checked = true;
  });
});

// Upload auto au choix de fichier
document.getElementById('file-input').addEventListener('change', function() {
  var files = this.files;
  if (files.length === 0) return;
  var names = Array.from(files).map(function(f) { return f.name; }).join(', ');
  var label = document.getElementById('file-names');
  label.textContent = files.length + ' fichier(s) : ' + names;
  label.classList.remove('hidden');
  document.getElementById('upload-progress').classList.remove('hidden');
  document.getElementById('drop-zone').style.pointerEvents = 'none';
  document.getElementById('doc-form').submit();
});
</script>
